---
/**
 * Naslovnica — 8 sekcija, manje buke (povratna informacija klijenta: "malo prenatrpano").
 * Hero · Usluge · Radovi · Kako radimo · Recenzije (+ brojke) · Za zgrade · Pitanja (5) · Procjena.
 * Brojke (bivša Kotna linija) žive u zaglavlju Recenzija; WhatsApp poruka u završnoj formi;
 * Detalj → /usluge/opsav-atike, Standard i jamstvo → /o-nama; karta područja je uklonjena.
 * Hero je samo crtež (bez fotografije) → nema preloada slike; LCP je naslov H1.
 */
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.astro';
import Services from '@/components/home/Services.astro';
import Projects from '@/components/home/Projects.astro';
import Process from '@/components/home/Process.astro';
import Reviews from '@/components/home/Reviews.astro';
import Managers from '@/components/home/Managers.astro';
import Faq from '@/components/home/Faq.astro';
import FinalCta from '@/components/home/FinalCta.astro';
import { faq } from '@/data/site';

/* Pet pitanja na naslovnici: cijena, besplatna procjena, trajanje, jamstvo, kiša i zima.
 * Biraju se po tekstu pitanja (ne po indeksu), da preslagivanje u site.ts ništa ne pomakne. */
const homeQuestions = [
  'Koliko košta limeni krov po m²?',
  'Je li procjena stvarno besplatna?',
  'Koliko traje izrada novog krova?',
  'Dajete li jamstvo?',
  'Radite li po kiši i zimi?',
];
const homeFaq = homeQuestions
  .map((q) => faq.find((f) => f.q === q))
  .filter((f): f is (typeof faq)[number] => !!f);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Limarija Karamatić — limeni krovovi, opšavi i oluci | Zagreb"
  description="Limeni i falcani krovovi, popravak krova, opšav atike, dimnjaci, oluci i snjegobrani. Sjedište u Zagrebu — radimo gdje god se posao isplati. Besplatna procjena: nazovite ili pošaljite slike na WhatsApp."
  schema={[faqSchema]}
>
  <Hero />
  <Services />
  <Projects />
  <Process />
  <Reviews />
  <Managers />
  <Faq items={homeFaq} />
  <FinalCta />
</Base>

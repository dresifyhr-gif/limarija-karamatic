---
/**
 * Naslovnica — 8 sekcija, manje buke (povratna informacija klijenta: "malo prenatrpano").
 * Hero · Usluge · Radovi · Kako radimo · Recenzije (+ brojke) · Za zgrade · Pitanja (5) · Procjena.
 * Brojke (bivša Kotna linija) žive u zaglavlju Recenzija; WhatsApp poruka u završnoj formi;
 * Detalj → /usluge/opsav-atike, Standard i jamstvo → /o-nama; karta područja je uklonjena.
 * Hero je samo crtež (bez fotografije) → nema preloada slike; LCP je naslov H1.
 */
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.astro';
import Services from '@/components/home/Services.astro';
import Projects from '@/components/home/Projects.astro';
import Process from '@/components/home/Process.astro';
import Reviews from '@/components/home/Reviews.astro';
import Managers from '@/components/home/Managers.astro';
import Faq from '@/components/home/Faq.astro';
import FinalCta from '@/components/home/FinalCta.astro';
import { getContent } from '@/lib/content';

/* Pitanja na naslovnici: u adminu označena "na naslovnici" (on_home), redom iz admina.
 * Početno stanje: cijena, besplatna procjena, trajanje, jamstvo, kiša i zima. */
const { homeFaq } = await getContent();

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Limarija Karamatić — limeni krovovi, opšavi i oluci | Zagreb"
  description="Limeni i falcani krovovi, popravak krova, opšav atike, dimnjaci, oluci i snjegobrani. Sjedište u Zagrebu — radimo gdje god se posao isplati. Besplatna procjena: nazovite ili pošaljite slike na WhatsApp."
  schema={homeFaq.length ? [faqSchema] : []}
>
  <Hero />
  <Services />
  <Projects />
  <Process />
  <Reviews />
  <Managers />
  {homeFaq.length > 0 && <Faq items={homeFaq} ask={false} />}
  <FinalCta />
</Base>

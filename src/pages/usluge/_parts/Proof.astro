---
/**
 * Kratki dokaz uz formu (papir), bez broja sekcije. Sve vrijednosti dolaze iz site.ts.
 *  - Bez recenzija (reviews = []): samo brojke iz `stats` (godine, krovovi, Google ocjena sa
 *    zvjezdicama, jamstvo) — bez citata, imena i izmišljenog teksta.
 *  - Čim se u site.ts doda stvarna recenzija: ocjena · recenzija (najbliža usluzi) · jamstvo.
 * Poveznica "Recenzije na Googleu" samo kad postoji site.googleReviewsUrl.
 *  slug?   usluga → bira recenziju koja joj najbolje odgovara
 *  class?  pozadina i razmaci sekcije (default "bg-white pt-20 sm:pt-24 lg:pt-28" — bez donjeg razmaka,
 *          teče u bijela Pitanja ispod; kao zasebna traka npr. "bg-papir py-20 sm:py-24")
 */
import Icon from '@/components/ui/Icon.astro';
import { site, stats, type Stat } from '@/data/site';
import { reviewFor } from './media';

interface Props {
  slug?: string;
  class?: string;
}
const { slug, class: className = 'bg-white pt-20 sm:pt-24 lg:pt-28' } = Astro.props;

/* hrvatski zapis broja: 4,9 · 1 200 */
const fmt = (v: number, d = 0) =>
  v.toLocaleString('hr-HR', { minimumFractionDigits: d, maximumFractionDigits: d }).replace(/\./g, ' ');
const isRating = (s: Stat) => /google/i.test(s.label);
const isWarranty = (s: Stat) => /jamstvo/i.test(s.label);

const g = stats.find(isRating);
const w = stats.find(isWarranty);
const review = reviewFor(slug);
const reviewsHref = site.googleReviewsUrl;
---

<section class:list={['pf-sec text-tinta', className]} aria-labelledby="dokaz-naslov">
  <div class="wrap">
    <h2 id="dokaz-naslov" class="sr-only">{review ? 'Ocjena, recenzija i jamstvo' : 'Brojke i ocjena'}</h2>
    {
      review ? (
        <div class="pf pf--review" data-reveal-group>
          {g && (
            <div class="pf-cell" data-reveal>
              <p class="pf-big type-display">
                <span class="sr-only">Prosječna ocjena </span>
                {fmt(g.value, g.decimals ?? 0)}
                <span class="pf-unit">/ 5</span>
              </p>
              <p class="pf-note">
                <span class="pf-stars" aria-hidden="true">
                  {Array.from({ length: 5 }, (_, i) => (
                    <Icon name="star" size={15} class={i < Math.round(g.value) ? '' : 'opacity-25'} />
                  ))}
                </span>
                <span>Google ocjena</span>
              </p>
            </div>
          )}

          <figure class="pf-cell pf-review" data-reveal>
            <blockquote class="pf-quote">„{review.text}“</blockquote>
            <figcaption class="pf-by">
              <span>
                {review.name}
                {review.place && <span class="pf-place"> · {review.place}</span>}
              </span>
              {reviewsHref && (
                <a href={reviewsHref} class="pf-more" target="_blank" rel="noopener">
                  Recenzije na Googleu
                  <Icon name="arrow-up-right" size={16} />
                </a>
              )}
            </figcaption>
          </figure>

          {w && (
            <div class="pf-cell" data-reveal>
              <p class="pf-big type-display">
                {fmt(w.value, w.decimals ?? 0)}
                <span class="pf-unit">{w.suffix?.trim()}</span>
              </p>
              <p class="pf-note">
                <Icon name="shield" size={16} class="flex-none" />
                <span>Pisano jamstvo, uz račun</span>
              </p>
            </div>
          )}
        </div>
      ) : (
        <div class="pf-wrap" data-reveal-group>
          <dl class="pf pf--stats">
            {stats.map((s) => (
              <div class="pf-cell" data-reveal>
                <dt class="pf-note">
                  {isRating(s) && (
                    <span class="pf-stars" aria-hidden="true">
                      {Array.from({ length: 5 }, (_, i) => (
                        <Icon name="star" size={14} class={i < Math.round(s.value) ? '' : 'opacity-25'} />
                      ))}
                    </span>
                  )}
                  <span>{s.label}</span>
                </dt>
                <dd class="pf-big type-display">
                  {s.prefix}
                  {fmt(s.value, s.decimals ?? 0)}
                  <span class="pf-unit">{s.suffix?.trim()}</span>
                </dd>
              </div>
            ))}
          </dl>
          {reviewsHref && (
            <p class="pf-foot" data-reveal>
              <a href={reviewsHref} class="pf-more" target="_blank" rel="noopener">
                Recenzije na Googleu
                <Icon name="arrow-up-right" size={16} />
              </a>
            </p>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .pf {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 2px solid var(--color-tinta);
  }
  .pf-cell {
    margin: 0;
    padding: 1.5rem 0;
    min-width: 0;
  }

  /* ── brojke (bez recenzija): 2 × 2 → 4 u redu ── */
  .pf--stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .pf--stats .pf-cell {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 1.5rem 1rem 0.25rem 0;
  }
  .pf--stats .pf-cell:nth-child(even) {
    padding-left: 1.25rem;
    border-left: 1px solid rgb(21 24 27 / 0.12);
  }
  @media (width >= 64rem) {
    .pf--stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .pf--stats .pf-cell {
      padding: 1.75rem 1.5rem 0.25rem;
    }
    .pf--stats .pf-cell:first-child {
      padding-left: 0;
    }
    .pf--stats .pf-cell + .pf-cell {
      border-left: 1px solid rgb(21 24 27 / 0.12);
    }
  }
  .pf-foot {
    display: flex;
    justify-content: flex-end;
    margin-top: 1rem;
  }

  /* ── s recenzijom: ocjena · citat · jamstvo ── */
  .pf--review .pf-cell + .pf-cell {
    border-top: 1px solid rgb(21 24 27 / 0.12);
  }
  @media (width >= 64rem) {
    .pf--review {
      grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr);
    }
    .pf--review .pf-cell + .pf-cell {
      border-top: 0;
      border-left: 1px solid rgb(21 24 27 / 0.12);
      padding-left: 2rem;
    }
    .pf--review .pf-review {
      padding-right: 2rem;
    }
  }

  .pf-big {
    font-size: 2.5rem;
    line-height: 0.9;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  @media (width >= 40rem) {
    .pf-big {
      font-size: 3rem;
    }
  }
  @media (width >= 64rem) {
    .pf-big {
      font-size: clamp(2.75rem, 3.6vw, 3.25rem);
    }
  }
  .pf-unit {
    margin-left: 0.15em;
    font-size: 0.42em;
    letter-spacing: 0;
    color: rgb(21 24 27 / 0.7);
  }
  .pf-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: rgb(21 24 27 / 0.75);
  }
  .pf--review .pf-note {
    margin-top: 1rem;
  }
  .pf-stars {
    display: flex;
    gap: 0.125rem;
    color: var(--color-tinta);
  }
  .pf-quote {
    font-size: 1.125rem;
    line-height: 1.55;
    font-weight: 500;
    text-wrap: pretty;
  }
  @media (width >= 64rem) {
    .pf-quote {
      font-size: 1.1875rem;
    }
  }
  .pf-by {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .pf-place {
    font-weight: 400;
    color: rgb(21 24 27 / 0.7);
  }
  .pf-more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    margin-left: auto;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-tinta);
    text-underline-offset: 4px;
  }
  .pf-more:hover {
    text-decoration: underline;
  }
</style>

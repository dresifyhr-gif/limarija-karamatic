---
/**
 * Kratki dokaz uz formu (papir): Google ocjena · jedna recenzija · pisano jamstvo.
 * Složeno kao zaglavlje tehničkog crteža (ćelije s tankim linijama). Bez broja sekcije.
 * Sve vrijednosti dolaze iz site.ts; nepotvrđeno nosi <ExampleTag />.
 *  slug?   usluga → bira recenziju koja joj najbolje odgovara
 *  class?  dodatne klase sekcije (razmaci)
 */
import Icon from '@/components/ui/Icon.astro';
import ExampleTag from '@/components/ui/ExampleTag.astro';
import { site, stats } from '@/data/site';
import { reviewFor } from './media';

interface Props {
  slug?: string;
  class?: string;
}
const { slug, class: className = 'pt-16 sm:pt-20 lg:pt-24' } = Astro.props;

const hr = (v: number, d = 0) => v.toFixed(d).replace('.', ',');
const g = stats.find((s) => /google/i.test(s.label));
const w = stats.find((s) => /jamstvo/i.test(s.label));
const review = reviewFor(slug);
const reviewsHref = site.googleReviewsUrl || '/#recenzije';
const external = reviewsHref.startsWith('http');
---

<section class:list={['pf-sec bg-papir text-tinta', className]} aria-labelledby="dokaz-naslov">
  <div class="wrap">
    <h2 id="dokaz-naslov" class="sr-only">Ocjena, recenzija i jamstvo</h2>
    <div class="pf" data-reveal-group>
      {
        g && (
          <div class="pf-cell pf-rate" data-reveal>
            <p class="pf-k">Google ocjena</p>
            <p class="pf-big type-display">
              <span class="sr-only">Prosječna ocjena </span>
              {hr(g.value, g.decimals ?? 0)}
              <span class="pf-unit">/ 5</span>
            </p>
            <p class="pf-note">
              <span class="flex gap-0.5" aria-hidden="true">
                {Array.from({ length: 5 }, (_, i) => (
                  <Icon name="star" size={15} class={i < Math.round(g.value) ? '' : 'opacity-25'} />
                ))}
              </span>
              {!g.confirmed && <ExampleTag />}
            </p>
          </div>
        )
      }

      <figure class="pf-cell pf-review" data-reveal>
        <p class="pf-k">Recenzija · {review.place}</p>
        <blockquote class="pf-quote">„{review.text}“</blockquote>
        <figcaption class="pf-by">
          <span>{review.name}</span>
          {review.example && <ExampleTag />}
          <a href={reviewsHref} class="pf-more" {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
            Sve recenzije
            <Icon name={external ? 'arrow-up-right' : 'arrow-right'} size={16} />
          </a>
        </figcaption>
      </figure>

      {
        w && (
          <div class="pf-cell pf-warr" data-reveal>
            <p class="pf-k">Jamstvo na izvedbu</p>
            <p class="pf-big type-display">
              {hr(w.value, w.decimals ?? 0)}
              <span class="pf-unit">{w.suffix?.trim()}</span>
            </p>
            <p class="pf-note">
              <Icon name="shield" size={16} class="flex-none" />
              <span>Pisano, uz račun</span>
              {!w.confirmed && <ExampleTag />}
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .pf {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 2px solid var(--color-tinta);
    border-bottom: 1px solid rgb(21 24 27 / 0.16);
  }
  .pf-cell {
    margin: 0;
    padding: 1.5rem 0;
    min-width: 0;
  }
  .pf-cell + .pf-cell {
    border-top: 1px solid rgb(21 24 27 / 0.16);
  }
  @media (width >= 40rem) {
    .pf {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pf-review {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .pf-cell {
      padding: 1.5rem 1.5rem 1.75rem 0;
    }
    .pf-warr {
      padding-left: 1.5rem;
      border-left: 1px solid rgb(21 24 27 / 0.16);
    }
    .pf-cell + .pf-warr {
      border-top: 0;
    }
  }
  @media (width >= 64rem) {
    .pf {
      grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr);
    }
    .pf-review {
      grid-column: auto;
      grid-row: auto;
      padding-inline: 2rem;
      border-left: 1px solid rgb(21 24 27 / 0.16);
    }
    .pf-cell + .pf-cell {
      border-top: 0;
    }
    .pf-warr {
      padding-left: 2rem;
      padding-right: 0;
    }
  }
  .pf-k {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(21 24 27 / 0.72);
  }
  .pf-big {
    margin-top: 1rem;
    font-size: 2.5rem;
    line-height: 0.85;
    letter-spacing: -0.03em;
  }
  @media (width >= 40rem) {
    .pf-big {
      font-size: 3rem;
    }
  }
  @media (width >= 64rem) {
    .pf-big {
      font-size: clamp(2.75rem, 3.6vw, 3.25rem);
    }
  }
  .pf-unit {
    margin-left: 0.2em;
    font-size: 0.4em;
    letter-spacing: 0;
    color: rgb(21 24 27 / 0.72);
  }
  .pf-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .pf-quote {
    margin-top: 1rem;
    font-size: 1.125rem;
    line-height: 1.55;
    font-weight: 500;
    text-wrap: pretty;
  }
  @media (width >= 64rem) {
    .pf-quote {
      font-size: 1.1875rem;
    }
  }
  .pf-by {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.625rem;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: rgb(21 24 27 / 0.72);
  }
  .pf-more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    margin-left: auto;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--color-tinta);
    text-underline-offset: 4px;
  }
  .pf-more:hover {
    text-decoration: underline;
  }
</style>

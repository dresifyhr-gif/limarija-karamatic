---
/**
 * Popis stavki (papir): stavka · kvačica — "Što je uključeno" na stranici usluge
 * i "Opis rada" na stranici rada. Redovi ulaze u nizu (data-reveal-group).
 * Namjerno bez zaglavlja stupaca i brojeva pozicija: jedna jaka linija gore, tanke između redova.
 *  items     stavke
 *  label     aria-label popisa
 *  slot foot redak ispod popisa (kratka napomena + poveznica)
 */
import Icon from '@/components/ui/Icon.astro';

interface Props {
  items: string[];
  label: string;
}
const { items, label } = Astro.props;
---

<div class="inc" data-reveal-group>
  <ul class="inc-list" aria-label={label}>
    {
      items.map((item) => (
        <li class="inc-row" data-reveal>
          <span class="inc-t">{item}</span>
          <span class="inc-check" aria-hidden="true">
            <Icon name="check" size={16} />
          </span>
        </li>
      ))
    }
  </ul>
  {
    Astro.slots.has('foot') && (
      <div class="inc-foot" data-reveal>
        <slot name="foot" />
      </div>
    )
  }
</div>

<style>
  .inc {
    border-top: 2px solid var(--color-tinta);
  }
  .inc-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2rem;
    gap: 0 1.5rem;
    align-items: start;
    padding: 1.25rem 0;
    border-bottom: 1px solid rgb(21 24 27 / 0.12);
  }
  @media (width >= 40rem) {
    .inc-row {
      grid-template-columns: minmax(0, 1fr) 2.25rem;
      padding: 1.5rem 0;
    }
  }
  .inc-t {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }
  @media (width >= 40rem) {
    .inc-t {
      font-size: 1.25rem;
      font-stretch: 106%;
    }
  }
  .inc-check {
    justify-self: end;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-tinta);
  }
  .inc-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: rgb(21 24 27 / 0.72);
  }
  .inc-foot :global(.inc-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-tinta);
    text-underline-offset: 4px;
  }
  .inc-foot :global(.inc-link:hover) {
    text-decoration: underline;
  }
</style>

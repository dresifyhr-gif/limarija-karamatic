---
/**
 * /usluge — SEO hub svih usluga (nav "Usluge"). Sve sekcije su SVIJETLE.
 * Ritam: hero (papir + mreža, kompaktan) →
 *        katalog 6 usluga (bijela) → procjena: FinalCta → footer.
 * Kartica (isti jezik kao naslovnica): fotografija 4:3 (data-scan), mala papirna pločica s presjekom
 * profila preko kuta fotografije (savije se pri ulasku / hoveru), naslov, jedan red opisa.
 * Cijela kartica je jedan link na uslugu — bez popisa stavki i bez drugog gumba po kartici.
 * Schema: BreadcrumbList + ItemList usluga.
 */
import Base from '@/layouts/Base.astro';
import PageHero, { breadcrumbSchema, homeCrumb } from '@/components/layout/PageHero.astro';
import Photo from '@/components/ui/Photo.astro';
import ProfileIcon from '@/components/ui/ProfileIcon.astro';
import Icon from '@/components/ui/Icon.astro';
import FinalCta from '@/components/home/FinalCta.astro';
import { services, site, waHref } from '@/data/site';

const crumbs = [homeCrumb, { href: '/usluge', label: 'Usluge' }];
/* fokus kadra kod rezanja portretnih fotografija */
const focus: Record<string, string> = { dimnjaci: 'object-[50%_30%]' };

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Usluge — Limarija Karamatić',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/usluge/${s.slug}`, Astro.site).toString(),
    name: s.title,
  })),
};
---

<Base
  title="Limarske usluge — Zagreb i šire | Limarija Karamatić"
  description="Limeni i falcani krovovi, popravak krova, opšav atike, dimnjaci, oluci i snjegobrani. Sjedište u Zagrebu, radimo i šire. Besplatna procjena, pisana ponuda."
  schema={[breadcrumbSchema(crumbs, Astro.site), listSchema]}
>
  <PageHero
    eyebrow={`Usluge · ${site.area}`}
    title="Limarske usluge."
    lead="Od cijelog novog krova do jednog opšava uz dimnjak. Lim krojimo i savijamo po mjeri vašeg krova, a ne po katalogu."
    crumbs={crumbs}
    compact
  />

  <section id="popis" class="bg-white py-24 text-tinta sm:py-28 lg:py-32" aria-labelledby="popis-naslov">
    <div class="wrap">
      <div class="hb-bar">
        <h2 id="popis-naslov" class="eyebrow text-tinta/70">Sve usluge</h2>
        <p class="hb-ask">
          <span>Ne znate što vam treba?</span>
          <a href={waHref('Pozdrav, šaljem slike krova. Lokacija: ')} class="hb-ask-a group/w" target="_blank" rel="noopener">
            Pošaljite slike na WhatsApp
            <Icon name="arrow-up-right" size={16} class="transition-transform duration-150 group-hover/w:-translate-y-0.5 group-hover/w:translate-x-0.5" />
          </a>
        </p>
      </div>

      <ol class="hb-grid" role="list">
        {
          services.map((s) => (
            <li id={s.slug} class="hb-li">
              <article class="hb-card group/c" data-profile-host aria-labelledby={`hb-${s.slug}`}>
                <div class="hb-media">
                  <div class="hb-photo" data-scan>
                    <Photo
                      src={s.image}
                      alt={s.imageAlt}
                      widths={[400, 640, 880]}
                      sizes="(min-width: 88rem) 26rem, (min-width: 64rem) 30vw, (min-width: 40rem) 46vw, 92vw"
                      class="block h-full w-full"
                      imgClass={`h-full w-full object-cover transition-transform duration-[400ms] ease-[var(--ease-draft)] group-hover/c:scale-[1.03] ${focus[s.slug] ?? ''}`}
                    />
                  </div>
                  <div class="hb-detail" aria-hidden="true">
                    <ProfileIcon profile={s.profile} size={40} animate class="hb-icon" />
                  </div>
                </div>

                <h3 id={`hb-${s.slug}`} class="hb-title text-balance">
                  <a href={`/usluge/${s.slug}`} class="hb-link">{s.title}</a>
                  <Icon name="arrow-right" size={18} class="hb-arrow" />
                </h3>
                <p class="hb-short text-pretty">{s.short}</p>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <FinalCta />
</Base>

<style>
  /* ── traka iznad kataloga ── */
  .hb-bar {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  @media (width >= 48rem) {
    .hb-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .hb-ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.75rem;
    font-size: 0.9375rem;
    color: rgb(21 24 27 / 0.75);
  }
  .hb-ask-a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-tinta);
    text-decoration: underline;
    text-decoration-color: rgb(21 24 27 / 0.3);
    text-underline-offset: 5px;
    transition: text-decoration-color 150ms var(--ease-press);
  }
  .hb-ask-a:hover {
    text-decoration-color: currentColor;
  }

  /* ── katalog: 1 → 2 (40rem) → 3 stupca (64rem) ── */
  .hb-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem 1.5rem;
    margin-top: 2rem;
  }
  @media (width >= 40rem) {
    .hb-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3.5rem 1.5rem;
      margin-top: 2.5rem;
    }
  }
  @media (width >= 64rem) {
    .hb-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 4.5rem 2rem;
    }
  }
  .hb-li {
    min-width: 0;
    scroll-margin-top: 6.5rem;
  }
  .hb-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .hb-media {
    position: relative;
  }
  .hb-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-antracit);
  }
  /* mala papirna pločica s presjekom profila preko donjeg lijevog kuta */
  .hb-detail {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    background: var(--color-papir);
    color: var(--color-tinta);
  }
  .hb-detail :global(.hb-icon) {
    width: 2.5rem;
    height: 2.5rem;
  }
  .hb-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
    font-size: 1.375rem;
    line-height: 1.15;
    font-weight: 750;
    font-stretch: 112%;
    letter-spacing: -0.005em;
  }
  .hb-title :global(.hb-arrow) {
    flex: none;
    color: rgb(21 24 27 / 0.5);
    transform: translateY(0.15em);
    transition:
      transform 150ms var(--ease-press),
      color 150ms var(--ease-press);
  }
  .hb-card:hover .hb-title :global(.hb-arrow) {
    color: var(--color-tinta);
    transform: translate(2px, 0.15em);
  }
  .hb-link {
    color: inherit;
  }
  /* cijela kartica je link na uslugu */
  .hb-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
  }
  .hb-link:focus-visible {
    outline: none;
  }
  .hb-link:focus-visible::after {
    outline: 2px solid var(--color-redline-dark);
    outline-offset: 6px;
  }
  .hb-short {
    margin-top: 0.625rem;
    font-size: 1rem;
    line-height: 1.55;
    color: rgb(21 24 27 / 0.75);
  }
</style>

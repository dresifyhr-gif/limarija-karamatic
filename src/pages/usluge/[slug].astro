---
/**
 * /usluge/[slug] — SEO stranica usluge (i landing za Google Ads). Sve sekcije su SVIJETLE.
 * Ritam (pozadine se izmjenjuju): hero (papir + mreža) → opseg radova (bijela) →
 *        galerija + radovi (papir) → dokaz: brojke i ocjena + pitanja (bijela) →
 *        procjena: FinalCta s predodabranom uslugom (papir + mreža) → ostale usluge (bijela) → footer.
 *        Opšav atike ima jednu sekciju više (Detalj je potpis, papir), pa se dalje pomakne:
 *        galerija + radovi (bijela) → dokaz (papir) → pitanja (bijela).
 * Fotografije: nijedna se ne ponavlja na stranici (vidi servicePhotos u _parts/media.ts).
 * Schema: Service (provider → '/#business' iz Base), BreadcrumbList, FAQPage.
 */
import Base from '@/layouts/Base.astro';
import PageHero, { breadcrumbSchema, homeCrumb } from '@/components/layout/PageHero.astro';
import ProfileIcon from '@/components/ui/ProfileIcon.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import Icon from '@/components/ui/Icon.astro';
import Photo from '@/components/ui/Photo.astro';
import Faq from '@/components/home/Faq.astro';
import FinalCta from '@/components/home/FinalCta.astro';
import DetailSignature from '@/components/home/DetailSignature.astro';
import HeroFacts from '@/components/pages/HeroFacts.astro';
import Gallery from './_parts/Gallery.astro';
import Scope from './_parts/Scope.astro';
import Proof from './_parts/Proof.astro';
import { faqFor, radova, servicePhotos } from './_parts/media';
import { services, projects, site, type Service } from '@/data/site';
import detailPhoto from '@/assets/projects/atika-opsav-kut-detalj.jpg';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;

/* Popravak je landing za Google Ads: telefon je glavni gumb (kreativni smjer §4). */
const urgent = service.slug === 'popravak-krova';
/* "Detalj je potpis" (kut atike na geru) živi samo na opšavu atike, odmah iza "Što je uključeno" */
const hasDetail = service.slug === 'opsav-atike';

const crumbs = [homeCrumb, { href: '/usluge', label: 'Usluge' }, { href: `/usluge/${service.slug}`, label: service.title }];

/* hero → kartice radova → galerija → sličice: svaka fotografija jednom
   (fotografija iz Detalja je rezervirana, da se ne ponovi u galeriji) */
const { heroProject, cards, gallery: allGallery, thumbs } = servicePhotos(service, hasDetail ? [detailPhoto] : []);
/* manje gužve: galerija + kartice radova zajedno najviše 3 fotografije (kartice imaju prednost) */
const gallery = allGallery.slice(0, Math.max(0, 3 - cards.length));
const others = services.filter((s) => s.slug !== service.slug);

/* "Svi radovi": s tri kartice samo tiha poveznica u zaglavlju; s jednom ili dvije pločica sa sličicama
   popunjava red; bez kartica pločica sa sličicama drugih radova stoji sama */
const showTile = cards.length < 3;
/* "Svi radovi" pločica popunjava ostatak zadnjeg reda (sm: 2 stupca, lg: 3) */
const lgSpan = cards.length % 3 === 0 ? 3 : 3 - (cards.length % 3);
const smSpan = cards.length % 2 === 0 ? 2 : 1;

const faqItems = faqFor(service);

/* hrvatski navodnici u tekstu iz site.ts */
const hr = (t: string) => t.replace(/"([^"]+)"/g, '„$1“');

/* svijetle pozadine se izmjenjuju (vidi ritam gore); pitanja su uvijek bijela, forma papir */
const midBg = hasDetail ? 'bg-white' : 'bg-papir';
const proofClass = hasDetail ? 'bg-papir py-20 sm:py-24' : 'bg-white pt-20 sm:pt-24 lg:pt-28';

/* završni naslov: hitni poslovi zadržavaju "Ne čekajte da počne kapati." (FinalCta default) */
const closeTitle = urgent || service.slug === 'dimnjaci' ? undefined : 'Izmjerimo i vaš krov.';

const pageUrl = new URL(`/usluge/${service.slug}`, Astro.site).toString();
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  serviceType: service.title,
  description: service.seoDescription,
  url: pageUrl,
  image: new URL(service.image.src, Astro.site).toString(),
  provider: { '@id': new URL('/#business', Astro.site).toString() },
  areaServed: { '@type': 'City', name: 'Zagreb' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${service.title} — što je uključeno`,
    itemListElement: service.includes.map((x) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: x },
    })),
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title={service.seoTitle}
  description={service.seoDescription}
  image={service.image}
  imageAlt={service.imageAlt}
  schema={[serviceSchema, breadcrumbSchema(crumbs, Astro.site), faqSchema]}
>
  <PageHero
    eyebrow={`${site.area} · besplatna procjena`}
    title={service.h1}
    lead={service.lead ?? service.short}
    crumbs={crumbs}
    image={service.image}
    imageAlt={service.imageAlt}
    imageHref={heroProject ? `/radovi/${heroProject.slug}` : undefined}
    profile={service.profile}
    phoneFirst={urgent}
  >
    <HeroFacts
      items={[
        { k: 'Mjerenje', v: 'Besplatno, na terenu' },
        { k: 'Ponuda', v: 'Pisana, stavku po stavku' },
        { k: 'Jamstvo', v: 'Pisano, na izvedbu' },
      ]}
    />
  </PageHero>

  <!-- Opseg radova -->
  <section id="opseg" class="bg-white py-24 text-tinta sm:py-28 lg:py-32" aria-labelledby="opseg-naslov">
    <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-8">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <p class="eyebrow mb-4 text-tinta/70" data-reveal>Opseg radova</p>
          <h2 id="opseg-naslov" class="type-display text-[2.125rem] text-balance sm:text-5xl lg:text-[clamp(2.625rem,4.1vw,3.75rem)]" data-reveal>
            {service.includesTitle ?? 'Što je uključeno.'}
          </h2>
          <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-pretty text-tinta/80" data-reveal>
            {hr(service.intro)}
          </p>
        </div>
      </div>

      <div class="lg:col-span-7 lg:pt-2">
        <Scope items={service.includes} label={`${service.title}: što je uključeno`}>
          <Fragment slot="foot">
            <p>Sve stavke navodimo u ponudi: materijal, boju, debljinu lima i rok.</p>
            <a href="/#kako-radimo" class="inc-link group/l">
              Kako radimo
              <Icon name="arrow-right" size={16} class="transition-transform duration-150 group-hover/l:translate-x-0.5" />
            </a>
          </Fragment>
        </Scope>
      </div>
    </div>
  </section>

  <!-- Detalj je potpis (samo opšav atike) -->
  {hasDetail && <DetailSignature class="bg-papir py-24 sm:py-28 lg:py-32" />}

  <!-- Galerija -->
  {
    gallery.length > 0 && (
      <Gallery
        images={gallery}
        bg={midBg}
        id="galerija"
        eyebrow="S gradilišta"
        title={service.galleryTitle ?? 'Ovako izgleda gotovo.'}
        lead={service.galleryLead ?? 'Fotografije s naših gradilišta. Antracit RAL 7016.'}
      />
    )
  }

  <!-- Radovi (kartice) + arhiva -->
  <section
    id="radovi"
    class:list={[midBg, 'pb-24 text-tinta sm:pb-28 lg:pb-32', gallery.length ? 'pt-0' : 'pt-24 sm:pt-28 lg:pt-32']}
    aria-labelledby="radovi-naslov"
  >
    <div class="wrap">
      <div class:list={[gallery.length > 0 && 'border-t border-tinta/10 pt-16 sm:pt-20']}>
        <header class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between sm:gap-10">
          <div class="max-w-3xl">
            <p class="eyebrow mb-4 text-tinta/70" data-reveal>Radovi</p>
            <h2 id="radovi-naslov" class="type-display text-[2.125rem] text-balance sm:text-5xl lg:text-[clamp(2.25rem,3.4vw,3rem)]" data-reveal>
              {cards.length ? (service.relatedTitle ?? 'Već izvedeno.') : 'Pogledajte i druge krovove.'}
            </h2>
          </div>
          {
            !showTile && (
              <a href="/radovi" class="xl-all group/a flex-none" data-reveal>
                Svi radovi
                <Icon name="arrow-right" size={16} class="transition-transform duration-150 group-hover/a:translate-x-0.5" />
              </a>
            )
          }
        </header>

        <ul class:list={['rad-grid mt-12 sm:mt-14', cards.length > 0 && 'rad-grid--rail']} role="list">
          {
            cards.map((p) => (
              <li>
                <ProjectCard project={p} sizes="(min-width: 88rem) 26rem, (min-width: 64rem) 30vw, (min-width: 30rem) 46vw, 78vw" />
              </li>
            ))
          }
          {showTile && (
          <li class:list={['rad-all', `rad-all--lg${lgSpan}`, `rad-all--sm${smSpan}`, cards.length === 0 && 'rad-all--solo']}>
            <div class="rad-all-in">
              <p class="eyebrow text-tinta/70">{radova(projects.length)}</p>
              {
                thumbs.length > 0 && (
                  <div class="rad-thumbs" aria-hidden="true">
                    {thumbs.map((p) => (
                      <div class="rad-thumb">
                        <Photo src={p.image} alt="" widths={[160, 320]} sizes="8rem" class="block h-full w-full" />
                      </div>
                    ))}
                  </div>
                )
              }
              <a href="/radovi" class="rad-all-a">
                <span class="type-display block text-[1.75rem] sm:text-[2rem]">Svi radovi</span>
              </a>
              <span class="rad-all-arrow" aria-hidden="true">
                <Icon name="arrow-right" size={18} />
              </span>
            </div>
          </li>
          )}
        </ul>
      </div>
    </div>
  </section>

  <!-- Dokaz uz formu: brojke i ocjena (recenzije kad postoje) -->
  <Proof slug={service.slug} class={proofClass} />

  <!-- Pitanja -->
  <Faq
    items={faqItems}
    tone="light"
    id="pitanja"
    title={service.faqTitle ?? 'Što nas najčešće pitaju.'}
    compact={faqItems.length <= 4}
    ask={false}
  />

  <!-- Procjena (zajednička završna forma, predodabrana usluga) -->
  <FinalCta preselect={service.slug} title={closeTitle} />

  <!-- Ostale usluge -->
  <section class="bg-white py-20 text-tinta sm:py-24" aria-labelledby="ostale-naslov">
    <div class="wrap">
      <div class="flex items-center justify-between gap-6">
        <h2 id="ostale-naslov" class="eyebrow text-tinta/70">Ostale usluge</h2>
        <a href="/usluge" class="xl-all group/a">
          Sve usluge
          <Icon name="arrow-right" size={16} class="transition-transform duration-150 group-hover/a:translate-x-0.5" />
        </a>
      </div>
      <ul class="xl-grid mt-6" role="list" data-reveal-group>
        {
          others.map((s) => (
            <li data-reveal>
              <a href={`/usluge/${s.slug}`} class="xl-card group/x" data-profile-host>
                <span class="xl-rule" aria-hidden="true" />
                <ProfileIcon profile={s.profile} size={56} animate class="xl-icon" />
                <span class="xl-title">{s.title}</span>
                <Icon
                  name="arrow-right"
                  size={18}
                  class="xl-arrow transition-transform duration-150 group-hover/x:translate-x-0.5"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ── radovi ── */
  .rad-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem 1.25rem;
  }
  @media (width >= 30rem) {
    .rad-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (width >= 64rem) {
    .rad-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3.5rem 1.5rem;
    }
  }
  /* "Svi radovi" — tiha pločica (sličice drugih radova kad je široka) */
  .rad-all {
    min-width: 0;
  }
  @media (width >= 30rem) and (width < 64rem) {
    .rad-all--sm2 {
      grid-column: span 2;
    }
  }
  @media (width >= 64rem) {
    .rad-all--lg2 {
      grid-column: span 2;
    }
    .rad-all--lg3 {
      grid-column: span 3;
    }
  }
  .rad-all-in {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 10rem;
    padding: 1.25rem 1.25rem 1.5rem;
    border: 1px solid rgb(21 24 27 / 0.14);
    transition: border-color 200ms var(--ease-draft);
  }
  @media (width >= 64rem) {
    .rad-all-in {
      padding: 1.5rem;
    }
  }
  .rad-all-in:has(.rad-all-a:hover) {
    border-color: rgb(21 24 27 / 0.4);
  }
  .rad-all-a {
    margin-top: auto;
    padding-top: 2rem;
    color: var(--color-tinta);
  }
  /* kontaktni arak drugih radova — samo u širokoj pločici */
  .rad-thumbs {
    display: none;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-content: start;
    gap: 0.5rem;
    margin-top: 1.25rem;
    max-width: 36rem;
  }
  .rad-thumb {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-antracit);
  }
  .rad-thumb :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
  @media (width >= 30rem) and (width < 64rem) {
    .rad-all--sm2 .rad-thumbs {
      display: grid;
    }
  }
  @media (width >= 64rem) {
    .rad-all--lg2 .rad-thumbs,
    .rad-all--lg3 .rad-thumbs {
      display: grid;
    }
    /* pločica preko dva stupca je visoka kao kartica do nje: sličice preko cijele širine */
    .rad-all--lg2 .rad-thumbs {
      max-width: none;
      margin-top: 1.5rem;
      gap: 0.75rem;
    }
  }
  .rad-all--solo .rad-thumbs {
    display: grid;
  }
  @media (width >= 30rem) {
    .rad-all--solo {
      grid-column: 1 / -1;
    }
  }
  .rad-all-a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .rad-all-a:focus-visible {
    outline: none;
  }
  .rad-all-a:focus-visible::after {
    outline: 2px solid var(--color-redline-dark);
    outline-offset: -2px;
  }
  .rad-all-arrow {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(21 24 27 / 0.25);
    color: var(--color-tinta);
    transition:
      background-color 150ms var(--ease-press),
      border-color 150ms var(--ease-press),
      color 150ms var(--ease-press);
  }
  .rad-all-a:hover ~ .rad-all-arrow {
    background: var(--color-tinta);
    border-color: var(--color-tinta);
    color: var(--color-papir);
  }

  /* mobitel: kartice radova kao vodoravni niz (native scroll-snap), "Svi radovi" je zadnja */
  @media (width < 30rem) {
    .rad-grid--rail {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 78%;
      gap: 1rem;
      margin-inline: -1.25rem;
      padding-inline: 1.25rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 1.25rem;
      scrollbar-width: none;
    }
    .rad-grid--rail::-webkit-scrollbar {
      display: none;
    }
    .rad-grid--rail > li {
      scroll-snap-align: start;
    }
  }

  /* ── ostale usluge ── */
  .xl-all {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-tinta);
    text-underline-offset: 4px;
  }
  .xl-all:hover {
    text-decoration: underline;
  }
  .xl-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid rgb(21 24 27 / 0.14);
  }
  @media (width >= 40rem) {
    .xl-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
  @media (width >= 64rem) {
    .xl-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      column-gap: 0;
      border-left: 1px solid rgb(21 24 27 / 0.1);
    }
  }
  .xl-grid > li {
    border-bottom: 1px solid rgb(21 24 27 / 0.1);
  }
  @media (width >= 64rem) {
    .xl-grid > li {
      border-right: 1px solid rgb(21 24 27 / 0.1);
    }
  }
  .xl-card {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    grid-template-areas: 'icon title arrow';
    align-items: center;
    column-gap: 1rem;
    padding: 1rem 0.25rem;
    min-height: 4.75rem;
    color: var(--color-tinta);
    transition: background-color 200ms var(--ease-draft);
  }
  .xl-card :global(.xl-icon) {
    grid-area: icon;
    width: 3rem;
    height: 3rem;
  }
  .xl-title {
    grid-area: title;
    font-size: 1.0625rem;
    font-weight: 650;
    line-height: 1.25;
    text-wrap: balance;
  }
  .xl-card :global(.xl-arrow) {
    grid-area: arrow;
    color: rgb(21 24 27 / 0.6);
  }
  .xl-rule {
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 2px;
    background: var(--color-redline-dark);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 380ms var(--ease-draft);
  }
  @media (width >= 64rem) {
    .xl-card {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: 1fr auto;
      grid-template-areas:
        'icon  icon'
        'title arrow';
      align-items: end;
      row-gap: 1.25rem;
      min-height: 13rem;
      padding: 1.5rem 1.25rem 1.375rem;
    }
    .xl-card :global(.xl-icon) {
      align-self: center;
      justify-self: start;
      width: 4rem;
      height: 4rem;
    }
  }
  @media (hover: hover) {
    .xl-card:hover {
      background: var(--color-papir);
    }
    .xl-card:hover .xl-rule {
      transform: scaleX(1);
    }
    .xl-card:hover :global(.xl-arrow) {
      color: var(--color-tinta);
    }
  }
  .xl-card:focus-visible {
    outline-offset: -2px;
  }
</style>

---
import '@/components/admin/content/content.css';
import Admin from '@/layouts/Admin.astro';
import PageHeader from '@/components/admin/PageHeader.astro';
import Card from '@/components/admin/Card.astro';
import Button from '@/components/admin/Button.astro';
import Badge from '@/components/admin/Badge.astro';
import EmptyState from '@/components/admin/EmptyState.astro';
import AdminIcon from '@/components/admin/AdminIcon.astro';
import { listFaq, FAQ_HOME_MAX } from '@/lib/server/repo/faq';

export const prerender = false;

const faq = await listFaq();
const onHome = faq.filter((f) => f.onHome).length;
---

<Admin title="Česta pitanja" active="pitanja">
  <PageHeader title="Česta pitanja" description={`Pitanja na stranici s pitanjima. Do ${FAQ_HOME_MAX} ih može biti i na naslovnici.`}>
    <Button slot="actions" href="/admin/pitanja/novo" icon="plus">Dodaj pitanje</Button>
  </PageHeader>

  {
    faq.length === 0 ? (
      <Card>
        <EmptyState icon="help" title="Još nema pitanja" text="Dodajte pitanja koja klijenti najčešće postavljaju na telefon.">
          <Button href="/admin/pitanja/novo" icon="plus">Dodaj pitanje</Button>
        </EmptyState>
      </Card>
    ) : (
      <>
        <div class="mb-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-0.5">
          <p class="flex items-center gap-2">
            <span class="cb-counter">Na naslovnici</span>
            <span class="home-meter" data-home-meter data-max={FAQ_HOME_MAX} aria-live="polite">
              <span class="a-mono text-[0.875rem] font-medium" data-home-count>
                {onHome} / {FAQ_HOME_MAX}
              </span>
              <span class="home-meter__bar" aria-hidden="true">
                {Array.from({ length: FAQ_HOME_MAX }, (_, i) => <span class:list={[i < onHome && 'is-on']} />)}
              </span>
            </span>
          </p>
          <p class="a-hint flex items-center gap-1.5">
            <AdminIcon name="grip" size={16} /> povucite za redoslijed
          </p>
        </div>
        <Card flush>
          <ol role="list" data-faq-list>
            {faq.map((f, i) => (
              <li class="cb-row items-start" data-sort-item data-id={f.id}>
                <button type="button" class="cb-handle mt-0.5" data-sort-handle aria-label={`Promijeni redoslijed: ${f.q}`}>
                  <AdminIcon name="grip" size={20} />
                </button>
                <div class="grid min-w-0 flex-1 gap-1">
                  <a href={`/admin/pitanja/${f.id}`} class="cb-row__main pt-2.5">
                    <span class="cb-row__title cb-clamp2">{f.q}</span>
                    <span class="a-muted cb-clamp2 text-[0.875rem]">{f.a}</span>
                  </a>
                  <div class="-mb-1 flex flex-wrap items-center gap-x-5">
                    <label class="a-toggle cb-mini">
                      <input
                        type="checkbox"
                        role="switch"
                        checked={f.onHome}
                        data-quick-toggle
                        data-home
                        data-url={`/api/admin/faq/${f.id}`}
                        data-field="onHome"
                        data-on="Pitanje je na naslovnici."
                        data-off="Pitanje je maknuto s naslovnice."
                      />
                      Naslovnica
                    </label>
                    <label class="a-toggle cb-mini">
                      <input
                        type="checkbox"
                        role="switch"
                        checked={f.published}
                        data-quick-toggle
                        data-url={`/api/admin/faq/${f.id}`}
                        data-field="published"
                        data-on="Pitanje je vidljivo na stranici."
                        data-off="Pitanje je skriveno."
                      />
                      Vidljivo
                    </label>
                  </div>
                </div>
                <span class="a-mono mt-3 hidden w-6 flex-none text-right text-[0.75rem] text-tinta/40 sm:block">{String(i + 1).padStart(2, '0')}</span>
              </li>
            ))}
          </ol>
        </Card>
      </>
    )
  }
</Admin>

<style>
  .home-meter {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .home-meter__bar {
    display: inline-flex;
    gap: 3px;
  }
  .home-meter__bar > span {
    width: 14px;
    height: 6px;
    border-radius: 1px;
    background: rgb(21 24 27 / 0.15);
    transition: background 150ms var(--ease-draft);
  }
  .home-meter__bar > span.is-on {
    background: var(--color-tinta);
  }
</style>

<script>
  import { makeSortable, saveOrder, initOptimisticToggles } from '@/components/admin/content/client';

  const list = document.querySelector<HTMLElement>('[data-faq-list]');
  const meter = document.querySelector<HTMLElement>('[data-home-meter]');
  if (list && meter) {
    const max = Number(meter.dataset.max || 5);
    const homeInputs = () => [...list.querySelectorAll<HTMLInputElement>('input[data-home]')];
    const render = () => {
      const n = homeInputs().filter((i) => i.checked).length;
      meter.querySelector('[data-home-count]')!.textContent = `${n} / ${max}`;
      meter.querySelectorAll('.home-meter__bar > span').forEach((s, i) => s.classList.toggle('is-on', i < n));
    };
    makeSortable(list, {
      onChange: (items) => {
        saveOrder('/api/admin/faq/reorder', { ids: items.map((i) => Number(i.dataset.id)) });
        items.forEach((li, i) => {
          const num = li.querySelector('.a-mono');
          if (num) num.textContent = String(i + 1).padStart(2, '0');
        });
      },
    });
    initOptimisticToggles(list, (input) => {
      if (input.dataset.home === undefined || !input.checked) return true;
      const n = homeInputs().filter((i) => i.checked).length;
      return n > max ? `Na naslovnici može biti najviše ${max} pitanja. Prvo maknite jedno.` : true;
    });
    list.addEventListener('kr:toggled', render);
  }
</script>

---
/**
 * Okvir admina (on-demand stranice; svaka stranica mora imati `export const prerender = false`).
 *
 *   <Admin title="Radovi" active="radovi">
 *     <PageHeader title="Radovi" />
 *     …
 *   </Admin>
 *
 * Gornja traka: logo, "Objavi na stranicu" (crveno kad postoje neobjavljene promjene), odjava.
 * Ispod: navigacija (na mobitelu vodoravno klizi). Toast i ConfirmDialog su uključeni.
 */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@/styles/global.css';
import '@/styles/admin.css';
import Logo from '@/components/ui/Logo.astro';
import PwaHead from '@/components/admin/PwaHead.astro';
import AdminIcon, { type AdminIconName } from '@/components/admin/AdminIcon.astro';
import Toast from '@/components/admin/Toast.astro';
import ConfirmDialog from '@/components/admin/ConfirmDialog.astro';
import { getPublishState, type PublishState } from '@/lib/server/meta';
import { db } from '@/lib/server/db';

export type AdminNavKey = 'pregled' | 'upiti' | 'ponude' | 'radovi' | 'usluge' | 'recenzije' | 'pitanja' | 'postavke';

interface Props {
  title: string;
  active?: AdminNavKey;
  /** šira radna površina (npr. uređivač ponude) */
  wide?: boolean;
}
const { title, active, wide = false } = Astro.props;

const nav: { key: AdminNavKey; href: string; label: string; icon: AdminIconName }[] = [
  { key: 'pregled', href: '/admin', label: 'Pregled', icon: 'home' },
  { key: 'upiti', href: '/admin/upiti', label: 'Upiti', icon: 'inbox' },
  { key: 'ponude', href: '/admin/ponude', label: 'Ponude', icon: 'file' },
  { key: 'radovi', href: '/admin/radovi', label: 'Radovi', icon: 'image' },
  { key: 'usluge', href: '/admin/usluge', label: 'Usluge', icon: 'layers' },
  { key: 'recenzije', href: '/admin/recenzije', label: 'Recenzije', icon: 'star' },
  { key: 'pitanja', href: '/admin/pitanja', label: 'Pitanja', icon: 'help' },
  { key: 'postavke', href: '/admin/postavke', label: 'Postavke', icon: 'settings' },
];

let publish: PublishState | null = null;
let newLeads = 0;
try {
  const [p, rows] = await Promise.all([getPublishState(), db()`SELECT count(*)::int AS n FROM leads WHERE status = 'novo'`]);
  publish = p;
  newLeads = Number(rows[0]?.n ?? 0);
} catch (e) {
  console.error('[admin] stanje objave nije dostupno:', (e as Error).message);
}
const dirty = !!publish?.dirty;
---

<!doctype html>
<html lang="hr" class="admin">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0e1013" />
    <meta name="referrer" content="same-origin" />
    <title>{`${title} · Admin · Karamatić`}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <PwaHead />
  </head>
  <body class="min-h-dvh">
    <a href="#sadrzaj" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-3 focus:py-2">Preskoči na sadržaj</a>

    <header class="a-dark sticky top-0 z-40 bg-grafit text-white">
      <div class="mx-auto flex h-14 max-w-[88rem] items-center gap-3 px-4 sm:h-16 sm:px-6">
        <a href="/admin" class="flex min-w-0 items-center gap-2.5 text-white no-underline" aria-label="Pregled — admin">
          <Logo variant="compact" tone="light" class="text-[15px] sm:text-[18px]" />
          <span class="type-mono hidden border-l border-white/20 pl-2.5 text-[11px] tracking-[0.14em] text-white/60 uppercase sm:inline">Admin</span>
        </a>
        <div class="ml-auto flex items-center gap-1.5 sm:gap-2">
          <button
            type="button"
            class:list={['pub', dirty ? 'is-dirty' : 'is-clean']}
            data-publish
            data-dirty={dirty ? '1' : '0'}
            aria-describedby="pub-state"
          >
            <AdminIcon name={dirty ? 'publish' : 'check'} size={18} />
            <span class="pub__long hidden sm:inline">{dirty ? 'Objavi na stranicu' : 'Sve je objavljeno'}</span>
            <span class="pub__short sm:hidden">{dirty ? 'Objavi' : 'Objavljeno'}</span>
          </button>
          <span id="pub-state" class="sr-only">{dirty ? 'Ima promjena koje još nisu na javnoj stranici.' : 'Javna stranica prikazuje zadnje promjene.'}</span>
          <a href="/" target="_blank" rel="noopener" class="topicon hidden sm:grid" title="Otvori javnu stranicu" aria-label="Otvori javnu stranicu">
            <AdminIcon name="external" size={19} />
          </a>
          <form method="post" action="/api/admin/logout" class="contents">
            <button type="submit" class="topicon grid" title="Odjava" aria-label="Odjava"><AdminIcon name="logout" size={19} /></button>
          </form>
        </div>
      </div>
      <nav class="border-t border-white/10 bg-grafit-2" aria-label="Admin izbornik">
        <ul class="navstrip mx-auto flex max-w-[88rem] gap-0.5 overflow-x-auto px-2 sm:px-4" role="list">
          {
            nav.map((n) => (
              <li class="flex-none">
                <a href={n.href} class:list={['navlink', active === n.key && 'is-active']} aria-current={active === n.key ? 'page' : undefined}>
                  <AdminIcon name={n.icon} size={17} class="opacity-70" />
                  {n.label}
                  {n.key === 'upiti' && newLeads > 0 && <span class="navcount" aria-label={`${newLeads} novih`}>{newLeads}</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="sadrzaj" class:list={['mx-auto w-full px-4 pt-5 pb-24 sm:px-6 sm:pt-8', wide ? 'max-w-[88rem]' : 'max-w-5xl']}>
      <slot />
    </main>

    <Toast />
    <ConfirmDialog />
  </body>
</html>

<style>
  .topicon {
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 3px;
    color: rgb(255 255 255 / 0.75);
    background: transparent;
    border: 0;
    transition:
      color 150ms var(--ease-draft),
      background 150ms var(--ease-draft);
  }
  .topicon:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.08);
  }
  .pub {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 40px;
    padding: 0 0.85rem;
    border-radius: 3px;
    font-size: 0.875rem;
    font-weight: 650;
    font-stretch: 105%;
    white-space: nowrap;
    border: 1px solid transparent;
    transition:
      background-color 150ms var(--ease-draft),
      border-color 150ms var(--ease-draft);
  }
  .pub.is-dirty {
    background: var(--color-crvena);
    color: #fff;
  }
  .pub.is-dirty:hover {
    background: var(--color-crvena-hover);
  }
  .pub.is-clean {
    background: transparent;
    color: rgb(255 255 255 / 0.72);
    border-color: rgb(255 255 255 / 0.18);
  }
  .pub.is-clean:hover {
    color: #fff;
    border-color: rgb(255 255 255 / 0.4);
  }
  .pub[aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }
  .navstrip {
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
  }
  .navstrip::-webkit-scrollbar {
    display: none;
  }
  .navlink {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 46px;
    padding: 0 0.8rem;
    color: rgb(255 255 255 / 0.68);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    scroll-snap-align: start;
    transition: color 150ms var(--ease-draft);
  }
  .navlink:hover {
    color: #fff;
  }
  .navlink.is-active {
    color: #fff;
  }
  .navlink.is-active::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0;
    height: 2px;
    background: #fff;
  }
  .navcount {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--color-crvena);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
  }
</style>

<script>
  import { api, confirmDialog, toast, errorMessage } from '@/lib/admin/ui';

  // aktivna stavka izbornika vidljiva na uskom ekranu
  document.querySelector('.navlink.is-active')?.scrollIntoView({ block: 'nearest', inline: 'center' });

  const btn = document.querySelector<HTMLButtonElement>('[data-publish]');
  btn?.addEventListener('click', async () => {
    const dirty = btn.dataset.dirty === '1';
    const ok = await confirmDialog(
      dirty
        ? {
            title: 'Objaviti promjene na stranicu?',
            message: 'Stranica se ponovno izrađuje s novim sadržajem. Promjene su vidljive za 1–3 minute.',
            confirmLabel: 'Objavi',
          }
        : {
            title: 'Sve je već objavljeno',
            message: 'Javna stranica već prikazuje zadnje promjene. Svejedno pokrenuti objavu?',
            confirmLabel: 'Objavi svejedno',
          },
    );
    if (!ok) return;
    btn.setAttribute('aria-busy', 'true');
    try {
      const res = await api<{ mode: 'deploy' | 'noop'; message: string; state: { dirty: boolean } }>('/api/admin/publish', { method: 'POST', body: {} });
      toast(res.message, res.mode === 'deploy' ? 'success' : 'info', 6000);
      if (res.mode === 'deploy') {
        btn.dataset.dirty = '0';
        btn.classList.replace('is-dirty', 'is-clean');
        btn.querySelector('.pub__long')!.textContent = 'Sve je objavljeno';
        btn.querySelector('.pub__short')!.textContent = 'Objavljeno';
      }
    } catch (e) {
      toast(errorMessage(e), 'error');
    } finally {
      btn.removeAttribute('aria-busy');
    }
  });

  // nakon spremanja javnog sadržaja stranice mogu javiti: document.dispatchEvent(new CustomEvent('kr:content-changed'))
  document.addEventListener('kr:content-changed', () => {
    if (!btn) return;
    btn.dataset.dirty = '1';
    btn.classList.replace('is-clean', 'is-dirty');
    btn.querySelector('.pub__long')!.textContent = 'Objavi na stranicu';
    btn.querySelector('.pub__short')!.textContent = 'Objavi';
  });
</script>

---
/**
 * Prazno stanje.
 *   <EmptyState icon="inbox" title="Još nema upita" text="Upiti s web stranice pojavit će se ovdje.">
 *     <Button href="…">…</Button>
 *   </EmptyState>
 */
import AdminIcon, { type AdminIconName } from './AdminIcon.astro';

interface Props {
  title: string;
  text?: string;
  icon?: AdminIconName;
  class?: string;
}
const { title, text, icon = 'info', class: className = '' } = Astro.props;
---

<div class:list={['grid justify-items-center gap-3 px-6 py-12 text-center', className]}>
  <span class="grid size-12 place-items-center rounded-full border border-[var(--a-line-strong)] text-tinta/70">
    <AdminIcon name={icon} size={22} />
  </span>
  <p class="a-h2">{title}</p>
  {text && <p class="a-muted max-w-sm text-[0.9375rem]">{text}</p>}
  {Astro.slots.has('default') && <div class="mt-2 flex flex-wrap justify-center gap-2"><slot /></div>}
</div>

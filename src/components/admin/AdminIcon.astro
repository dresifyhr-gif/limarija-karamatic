---
/**
 * Ikone admina (linijske 24×24, stroke 1.75, currentColor). Javni Icon.astro se ne dira.
 *   <AdminIcon name="upload" size={18} />
 */
import { siWhatsapp } from 'simple-icons';

const paths = {

---
/**
 * Fotografije: povuci-i-ispusti, odabir s uređaja, "Uslikaj" (kamera na mobitelu), redoslijed, brisanje, opis (alt).
 * Vrijednost je u skrivenom polju `name` kao JSON (formData() ga parsira zbog data-json):
 *   - zadano: ImageRef[]  (prva = naslovna)
 *   - single: ImageRef | null
 *
 *   ---
 *   const images = await Promise.all(p.images.map(async (i) => ({ ...i, thumb: await thumbUrl(i, 360) })));
 *   ---
 *   <ImageUploader name="images" label="Fotografije" value={images} withAlt max={20} />
 *
 * Fotografija se šalje odmah po odabiru (POST /api/admin/upload); zapis u bazi nastaje tek kad se forma spremi.
 * Uklonjena NOVA fotografija odmah se briše s Bloba; uklonjenu POSTOJEĆU briše server pri spremanju (deleteBlobsIfUnused).
 * Dok traje slanje, korijen ima data-busy="true" (submitForm() tada ne šalje formu).
 * Događaj `images-change` (bubbles) na korijenu [data-iu] nakon svake promjene; detail = trenutna vrijednost.
 *
 * Dodano (content agent):
 *  - `maxEdge` (zadano 2560): najdulja stranica nakon smanjivanja u pregledniku (radovi/usluge koriste 2400).
 *  - gumb "Postavi kao naslovnu" (zvjezdica) na svakoj fotografiji osim prve (kad nije `single`).
 *  - događaj `iu:set-ids` (detail: (number|undefined)[]) na [data-iu] upisuje id-jeve redom nakon spremanja
 *    (npr. odgovor PUT /api/admin/projects/:id/images), da sljedeće spremanje zadrži postojeće retke.
 *  - kad se stranica napusti bez spremanja forme, tek učitane fotografije brišu se s Bloba (discardUploads).
 */
import AdminIcon from './AdminIcon.astro';
import type { ImageRef } from '@/lib/types';

type Item = ImageRef & { thumb?: string | null; id?: number };
interface Props {
  name: string;
  label?: string;
  hint?: string;
  value?: Item[] | Item | null;
  single?: boolean;
  max?: number;
  folder?: 'media' | 'leads' | 'quotes';
  withAlt?: boolean;
  /** najdulja stranica u px nakon smanjivanja u pregledniku (zadano 2560) */
  maxEdge?: number;
  class?: string;
}
const { name, label, hint, value, single = false, max = single ? 1 : 24, folder = 'media', withAlt = false, maxEdge, class: className = '' } = Astro.props;
const items: Item[] = (Array.isArray(value) ? value : value ? [value] : []).filter(Boolean);
const strip = ({ thumb: _t, ...ref }: Item) => ref;
const hidden = JSON.stringify(single ? (items[0] ? strip(items[0]) : null) : items.map(strip));
const uid = `iu-${name.replace(/[^\w-]/g, '-')}`;
---

<div
  class:list={['iu grid gap-2', className]}
  data-iu
  data-max={max}
  data-single={single ? '1' : undefined}
  data-folder={folder}
  data-with-alt={withAlt ? '1' : undefined}
  data-max-edge={maxEdge}
>
  <input type="hidden" name={name} value={hidden} data-json data-iu-value />
  {label && <p class="a-label" id={`${uid}-label`}>{label}</p>}

  <ul class="iu-grid" data-iu-list role="list" aria-labelledby={label ? `${uid}-label` : undefined}>
    {
      items.map((it) => (
        <li class="iu-item" data-ref={JSON.stringify(strip(it))}>
          <div class="iu-thumb">
            {(it.thumb || ('url' in it && it.url)) && <img src={it.thumb || ('url' in it ? it.url : '')} alt="" loading="lazy" decoding="async" />}
            <span class="iu-cover">Naslovna</span>
          </div>
          <div class="iu-tools">
            <button type="button" class="iu-btn" data-iu-left aria-label="Pomakni lijevo"><AdminIcon name="chevron-left" size={18} /></button>
            <button type="button" class="iu-btn" data-iu-right aria-label="Pomakni desno"><AdminIcon name="chevron-right" size={18} /></button>
            <button type="button" class="iu-btn iu-btn--cover" data-iu-cover aria-label="Postavi kao naslovnu" title="Postavi kao naslovnu"><AdminIcon name="star" size={18} /></button>
            <button type="button" class="iu-btn iu-btn--del" data-iu-remove aria-label="Ukloni fotografiju"><AdminIcon name="trash" size={18} /></button>
          </div>
          {withAlt && <input class="a-input iu-alt" type="text" value={it.alt ?? ''} placeholder="Opis (što se vidi)" aria-label="Opis fotografije" maxlength="300" data-iu-alt />}
        </li>
      ))
    }
  </ul>

  <div class="iu-drop" data-iu-drop>
    <AdminIcon name="image" size={24} class="text-tinta/50" />
    <p class="iu-drop__text hidden sm:block">Povucite fotografije ovamo ili</p>
    <div class="flex flex-wrap justify-center gap-2">
      <label class="a-btn a-btn--secondary a-btn--sm sm:hidden">
        <AdminIcon name="camera" size={18} /> Uslikaj
        <input type="file" accept="image/*" capture="environment" class="sr-only" data-iu-input />
      </label>
      <label class="a-btn a-btn--secondary a-btn--sm">
        <AdminIcon name="upload" size={18} />
        {single ? 'Odaberi fotografiju' : 'Odaberi fotografije'}
        <input type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" multiple={!single} class="sr-only" data-iu-input />
      </label>
    </div>
    <p class="a-hint text-center">{hint ?? 'JPEG, PNG, WebP ili HEIC · smanjuju se automatski'}</p>
  </div>
  <p class="a-error" data-field-error={name} hidden role="alert"></p>
</div>

<template id="iu-item-tpl">
  <li class="iu-item is-uploading">
    <div class="iu-thumb">
      <img alt="" />
      <span class="iu-cover">Naslovna</span>
      <span class="iu-progress"><span></span></span>
    </div>
    <div class="iu-tools">
      <button type="button" class="iu-btn" data-iu-left aria-label="Pomakni lijevo"
        ><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"
          ><path d="m14.5 6-6 6 6 6"></path></svg
        ></button
      >
      <button type="button" class="iu-btn" data-iu-right aria-label="Pomakni desno"
        ><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"
          ><path d="m9.5 6 6 6-6 6"></path></svg
        ></button
      >
      <button type="button" class="iu-btn iu-btn--cover" data-iu-cover aria-label="Postavi kao naslovnu" title="Postavi kao naslovnu"
        ><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          ><path d="m12 3.5 2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.8Z"></path></svg
        ></button
      >
      <button type="button" class="iu-btn iu-btn--del" data-iu-remove aria-label="Ukloni fotografiju"
        ><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          ><path d="M4 6.5h16M9.5 6.5V4h5v2.5M6.5 6.5 7.5 20h9l1-13.5"></path><path d="M10 10.5v6M14 10.5v6"></path></svg
        ></button
      >
    </div>
    <input class="a-input iu-alt" type="text" placeholder="Opis (što se vidi)" aria-label="Opis fotografije" maxlength="300" data-iu-alt />
  </li>
</template>

<style>
  .iu-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  @media (width >= 40rem) {
    .iu-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (width >= 64rem) {
    .iu-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* jedna fotografija (single) zauzima cijelu širinu svog stupca */
  [data-single] .iu-grid {
    grid-template-columns: minmax(0, 1fr);
  }
  .iu-grid:empty {
    display: none;
  }
  .iu-item {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }
  .iu-thumb {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-papir-2);
    border: 1px solid var(--a-line);
  }
  .iu-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .iu-cover {
    position: absolute;
    left: 0.4rem;
    top: 0.4rem;
    padding: 0.2rem 0.4rem;
    border-radius: 2px;
    background: var(--color-grafit);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: none;
  }
  [data-single] .iu-cover {
    display: none !important;
  }
  .iu-item:first-child .iu-cover {
    display: block;
  }
  .iu-progress {
    position: absolute;
    inset: auto 0 0 0;
    height: 4px;
    background: rgb(255 255 255 / 0.6);
  }
  .iu-progress > span {
    display: block;
    height: 100%;
    width: calc(var(--p, 0) * 100%);
    background: var(--color-tinta);
    transition: width 150ms linear;
  }
  .iu-item:not(.is-uploading) .iu-progress {
    display: none;
  }
  .iu-item.is-uploading .iu-thumb img {
    opacity: 0.6;
  }
  .iu-tools {
    display: flex;
    gap: 0.25rem;
  }
  .iu-btn {
    display: grid;
    place-items: center;
    flex: 1;
    height: 40px;
    border: 1px solid var(--a-line-strong);
    border-radius: 2px;
    background: #fff;
    color: var(--color-tinta);
  }
  .iu-btn:hover {
    border-color: var(--color-tinta);
  }
  .iu-btn--del {
    color: var(--color-redline-dark);
  }
  .iu-item:first-child [data-iu-cover],
  [data-single] [data-iu-cover] {
    display: none;
  }
  .iu-item:first-child [data-iu-left],
  .iu-item:last-child [data-iu-right],
  [data-single] [data-iu-left],
  [data-single] [data-iu-right] {
    visibility: hidden;
  }
  .iu-alt {
    min-height: 40px;
    padding: 0.45rem 0.6rem;
    font-size: 0.875rem;
  }
  :not([data-with-alt]) > .iu-grid .iu-alt {
    display: none;
  }
  .iu-drop {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    padding: 1.25rem 1rem;
    border: 1.5px dashed var(--a-line-strong);
    border-radius: 3px;
    background: rgb(255 255 255 / 0.6);
    transition:
      border-color 150ms var(--ease-draft),
      background 150ms var(--ease-draft);
  }
  .iu-drop.is-over {
    border-color: var(--color-tinta);
    background: #fff;
  }
  .iu-drop__text {
    font-size: 0.9375rem;
    font-weight: 600;
  }
  [data-iu][data-full] .iu-drop {
    display: none;
  }
</style>

<script>
  import { uploadImage, discardUploads } from '@/lib/admin/upload';
  import { toast } from '@/lib/admin/ui';

  function init(root: HTMLElement) {
    if (root.dataset.iuReady) return;
    root.dataset.iuReady = '1';
    const list = root.querySelector<HTMLUListElement>('[data-iu-list]')!;
    const hidden = root.querySelector<HTMLInputElement>('[data-iu-value]')!;
    const drop = root.querySelector<HTMLElement>('[data-iu-drop]')!;
    const tpl = document.getElementById('iu-item-tpl') as HTMLTemplateElement;
    const max = Number(root.dataset.max || 24);
    const single = !!root.dataset.single;
    const folder = (root.dataset.folder || 'media') as 'media' | 'leads' | 'quotes';
    const maxEdge = root.dataset.maxEdge ? Number(root.dataset.maxEdge) : undefined;
    const fresh = new Set<string>();
    let pending = 0;

    const value = () => {
      const refs = [...list.querySelectorAll<HTMLLIElement>('.iu-item:not(.is-uploading)')].map((li) => {
        const ref = JSON.parse(li.dataset.ref || 'null');
        const alt = li.querySelector<HTMLInputElement>('[data-iu-alt]');
        if (ref && alt) ref.alt = alt.value.trim();
        return ref;
      }).filter(Boolean);
      return single ? (refs[0] ?? null) : refs;
    };
    const sync = () => {
      const v = value();
      hidden.value = JSON.stringify(v);
      root.toggleAttribute('data-full', list.children.length >= max);
      root.dataset.busy = pending > 0 ? 'true' : 'false';
      root.dispatchEvent(new CustomEvent('images-change', { bubbles: true, detail: v }));
      hidden.dispatchEvent(new Event('change', { bubbles: true }));
    };

    async function addFiles(files: File[]) {
      const room = max - list.children.length;
      if (room <= 0) return toast(single ? 'Prvo uklonite postojeću fotografiju.' : `Najviše ${max} fotografija.`, 'error');
      if (files.length > room) toast(`Dodano je samo ${room} (najviše ${max}).`, 'info');
      for (const file of files.slice(0, room)) {
        const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
        const img = li.querySelector('img')!;
        const preview = URL.createObjectURL(file);
        img.src = preview;
        list.appendChild(li);
        pending++;
        sync();
        try {
          const res = await uploadImage(file, {
            folder,
            maxEdge,
            onProgress: (p) => li.querySelector<HTMLElement>('.iu-progress > span')!.style.setProperty('--p', String(p)),
          });
          fresh.add(res.url);
          const { size: _s, contentType: _c, ...ref } = res;
          li.dataset.ref = JSON.stringify(ref);
          li.classList.remove('is-uploading');
          img.onload = () => URL.revokeObjectURL(preview);
          img.src = res.url;
        } catch (e) {
          li.remove();
          URL.revokeObjectURL(preview);
          toast((e as Error).message || 'Slanje nije uspjelo.', 'error');
        } finally {
          pending--;
          sync();
        }
      }
    }

    root.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.matches('[data-iu-input]') && t.files?.length) {
        addFiles([...t.files]);
        t.value = '';
      }
    });
    root.addEventListener('input', (e) => {
      if ((e.target as HTMLElement).matches('[data-iu-alt]')) sync();
    });
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      const li = btn?.closest<HTMLLIElement>('.iu-item');
      if (!btn || !li) return;
      if (btn.matches('[data-iu-remove]')) {
        const ref = JSON.parse(li.dataset.ref || 'null');
        if (ref?.url && fresh.has(ref.url)) {
          fresh.delete(ref.url);
          discardUploads([ref.url]);
        }
        li.remove();
      } else if (btn.matches('[data-iu-left]') && li.previousElementSibling) {
        list.insertBefore(li, li.previousElementSibling);
      } else if (btn.matches('[data-iu-right]') && li.nextElementSibling) {
        list.insertBefore(li.nextElementSibling, li);
      } else if (btn.matches('[data-iu-cover]') && li.previousElementSibling) {
        list.insertBefore(li, list.firstElementChild);
        toast('Postavljeno kao naslovna. Spremite promjene.', 'info', 2600);
      } else return;
      sync();
    });

    ['dragenter', 'dragover'].forEach((t) =>
      drop.addEventListener(t, (e) => {
        e.preventDefault();
        drop.classList.add('is-over');
      }),
    );
    ['dragleave', 'drop'].forEach((t) => drop.addEventListener(t, () => drop.classList.remove('is-over')));
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      const files = [...(e.dataTransfer?.files ?? [])].filter((f) => f.type.startsWith('image/') || /\.(heic|heif)$/i.test(f.name));
      if (files.length) addFiles(files);
    });

    // forma spremljena → nove fotografije više nisu "nespremljene"
    root.closest('form')?.addEventListener('kr:saved', () => fresh.clear());

    // id-jevi postojećih fotografija nakon spremanja (redom, samo već učitane stavke)
    root.addEventListener('iu:set-ids', (e) => {
      const ids = (e as CustomEvent<(number | undefined)[]>).detail ?? [];
      [...list.querySelectorAll<HTMLLIElement>('.iu-item:not(.is-uploading)')].forEach((li, i) => {
        const ref = JSON.parse(li.dataset.ref || 'null');
        if (!ref) return;
        if (ids[i]) ref.id = ids[i];
        else delete ref.id;
        li.dataset.ref = JSON.stringify(ref);
      });
      sync();
    });

    // izlazak bez spremanja → tek učitane fotografije nisu nigdje upisane; makni ih s Bloba
    let discarded = false;
    window.addEventListener('pagehide', () => {
      if (!fresh.size) return;
      discardUploads([...fresh]);
      fresh.clear();
      discarded = true;
    });
    window.addEventListener('pageshow', (e) => {
      if (e.persisted && discarded) location.reload();
    });
    root.toggleAttribute('data-full', list.children.length >= max);
  }

  document.querySelectorAll<HTMLElement>('[data-iu]').forEach(init);
</script>

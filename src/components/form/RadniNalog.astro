---
/**
 * Forma "Upit za procjenu" — 3 koraka, složena kao tehnički list (radni nalog).
 *
 * Props:
 *  preselect?     id iz `jobTypes` ili slug usluge (npr. "dimnjaci") → unaprijed odabran korak 1
 *  id?            id korijena (default "radni-nalog"); svi interni id-jevi su izvedeni iz njega
 *  variant?       'standard' (default) | 'zgrada' — za upravitelje: uži izbor poslova (+ "Ravni krov"),
 *                 u koraku 2 adresa zgrade (obavezno), upravitelj / tvrtka i broj ulaza
 *  headingLevel?  2 | 3 (default 3) — razina naslova koraka (2 kad iznad forme nema h2, npr. /procjena)
 *
 * Bez JS-a: sva tri koraka jedan ispod drugog, POST multipart na /api/upit (fotografije idu s formom) → 303 na /hvala.
 * S JS-om (src/lib/form.ts): koraci, validacija, crtež sloj po korak, mirna potvrda "Upit je poslan",
 * pa preusmjeravanje na /hvala?upit=XXXX&posao=<id>&slike=<broj>.
 * Na stranici ?usluga=<slug> (ili ?vrsta=<id>) također odabire vrstu posla.
 */
import Icon from '@/components/ui/Icon.astro';
import NalogDrawing from './NalogDrawing.astro';
import { jobTypes, roofSizes, areas } from '@/data/site';
import { getContent } from '@/lib/content';

interface Props {
  preselect?: string;
  id?: string;
  variant?: 'standard' | 'zgrada';
  headingLevel?: 2 | 3;
}
const { preselect, id = 'radni-nalog', variant = 'standard', headingLevel = 3 } = Astro.props;
const zgrada = variant === 'zgrada';
const H = (headingLevel === 2 ? 'h2' : 'h3') as 'h2' | 'h3';

type Job = { id: string; label: string; service: string };
const byId = (jid: string) => jobTypes.find((j) => j.id === jid) as Job;
/* Zgrade: samo poslovi koji se rade na zgradama + "Ravni krov" (nije usluga u site.ts, samo vrsta upita). */
const jobs: Job[] = zgrada
  ? [byId('atika'), { id: 'ravni-krov', label: 'Ravni krov', service: '' }, byId('popravak'), byId('dimnjak'), byId('oluci'), byId('hitno')]
  : (jobTypes as Job[]);
const regularCount = jobs.filter((j) => j.id !== 'hitno').length;

const preJob = jobs.find((j) => j.id === preselect)?.id ?? jobs.find((j) => j.service && j.service === preselect && j.id !== 'hitno')?.id ?? null;

const stepNames = zgrada ? ['Što treba', 'Zgrada', 'Kontakt'] : ['Što treba', 'Gdje i koliko', 'Kontakt'];
const callTimes = ['Ujutro', 'Popodne', 'Svejedno'];
const pad = (n: number) => String(n).padStart(2, '0');
const f = (name: string) => `${id}-${name}`;
// kontakt iz admina (Postavke → Kontakt)
const { contact, telHref } = await getContent();
---

<div class="rn @container/rn relative" id={id} data-variant={variant}>
  <div class="rn-sheet relative bg-white text-tinta">
    {/* kotni lanac koraka (jedini pokazatelj napretka; samo s JS-om) */}
    <ol class="rn-dims grid grid-cols-3" aria-label="Koraci" data-rn-js hidden>
      {
        stepNames.map((t, i) => (
          <li class="rn-dim" data-rn-dim={i + 1}>
            <span class="rn-dim-label">
              <span class="rn-dim-n">{pad(i + 1)}</span>
              <span class="rn-dim-t sr-only">{t}</span>
            </span>
            <span class="rn-dim-line" aria-hidden="true" />
          </li>
        ))
      }
    </ol>

    <p class="sr-only" role="status" aria-live="polite" data-rn-status></p>

    {/*
      POST /api/upit (src/pages/api/upit.ts): upit se sprema u bazu (admin → Upiti), fotografije na Vercel Blob.
      Bez JS-a: multipart → 303 na /hvala?upit=XXXX&posao=<id>&slike=<broj> (nikad osobni podaci u URL-u).
      S JS-om (src/lib/form.ts): fotografije preko /api/upit/foto, zatim JSON.
    */}
    <form
      class="rn-form"
      action="/api/upit"
      method="post"
      enctype="multipart/form-data"
      data-rn
      aria-label={zgrada ? 'Upit za zgradu — besplatna procjena' : 'Upit za besplatnu procjenu'}
    >
      {/* zamka za botove: ljudi je ne vide; server tada ništa ne sprema (uz to i ograničenje učestalosti po IP-u) */}
      <div class="hidden" aria-hidden="true">
        <label>Ne ispunjavati <input type="text" name="web" tabindex="-1" autocomplete="off" /></label>
      </div>
      <input type="hidden" name="varijanta" value={variant} />

      <div class="rn-steps relative min-w-0">
        {/* KORAK 1 */}
        <fieldset class="rn-step" data-step="1" aria-labelledby={f('h1')}>
          <div class="rn-step-head">
            <H id={f('h1')} class="rn-h" tabindex="-1" data-rn-heading>Što treba?</H>
            <p class="rn-lead">Odaberite jedno. Detalje dogovaramo na krovu.</p>
          </div>
          <div class="rn-chips grid gap-2 @[17rem]/rn:grid-cols-2" data-rn-group="vrsta">
            {
              jobs.map((j) => (
                <label
                  class:list={[
                    'rn-chip',
                    j.id === 'hitno' && 'rn-chip-urgent',
                    j.id === 'hitno' && regularCount % 2 === 0 && '@[17rem]/rn:col-span-2',
                  ]}
                >
                  <input
                    type="radio"
                    name="vrsta"
                    value={j.id}
                    data-service={j.service || undefined}
                    data-label={j.label}
                    checked={j.id === preJob}
                    required
                    aria-describedby={f('vrsta-err')}
                    class="sr-only"
                  />
                  <span class="rn-chip-box" aria-hidden="true">
                    <svg class="rn-chip-tick" viewBox="0 0 24 24" width="14" height="14">
                      <path d="m4.5 12.5 4.5 4.5L19.5 6.5" />
                    </svg>
                  </span>
                  <span class="rn-chip-t">{j.label}</span>
                  {j.id === 'hitno' && <span class="rn-dot ml-auto" aria-hidden="true" />}
                </label>
              ))
            }
          </div>
          <p class="rn-err" id={f('vrsta-err')} data-rn-err="vrsta" hidden></p>
          <div class="rn-urgent">
            <p class="rn-urgent-t">
              <span class="rn-dot" aria-hidden="true"></span>
              Curi sada? Najbrže je nazvati.
            </p>
            <a href={telHref} class="rn-btn rn-btn-call">
              <span class="inline-flex items-center gap-2.5 whitespace-nowrap"><Icon name="phone" size={18} />Nazovite odmah</span>{' '}
              <span class="font-mono font-medium whitespace-nowrap">{contact.phoneDisplay}</span>
            </a>
            <p class="rn-urgent-s">Ako ipak pošaljete upit, stavljamo ga na vrh. Veličinu krova tada ne trebate upisivati.</p>
          </div>
        </fieldset>

        {/* KORAK 2 */}
        <fieldset class="rn-step" data-step="2" aria-labelledby={f('h2')}>
          <div class="rn-step-head">
            <H id={f('h2')} class="rn-h" tabindex="-1" data-rn-heading>{zgrada ? 'Koja zgrada?' : 'Gdje i koliko?'}</H>
            <p class="rn-lead">
              {zgrada ? 'Adresa je dovoljna — krov izmjerimo i fotografiramo na terenu.' : 'Otprilike je dovoljno — sve izmjerimo na terenu.'}
            </p>
          </div>

          <div class="grid gap-6">
            {
              zgrada ? (
                <>
                  <div>
                    <label for={f('adresa')} class="rn-label">Adresa zgrade</label>
                    <input
                      id={f('adresa')}
                      name="adresa"
                      type="text"
                      class="rn-input"
                      autocomplete="street-address"
                      placeholder="npr. Ilica 120, Zagreb"
                      required
                      minlength="4"
                      aria-describedby={f('adresa-err')}
                    />
                    <p class="rn-err" id={f('adresa-err')} data-rn-err="adresa" hidden></p>
                  </div>
                  <div class="grid gap-6">
                    <div>
                      <label for={f('upravitelj')} class="rn-label">
                        Upravitelj / tvrtka <span class="rn-opt">· nije obavezno</span>
                      </label>
                      <input id={f('upravitelj')} name="upravitelj" type="text" class="rn-input" autocomplete="organization" />
                    </div>
                    <div>
                      <label for={f('ulazi')} class="rn-label">
                        Broj ulaza <span class="rn-opt">· ako znate</span>
                      </label>
                      <input id={f('ulazi')} name="ulazi" type="text" inputmode="numeric" class="rn-input max-w-[10rem] font-mono" autocomplete="off" placeholder="npr. 2" />
                    </div>
                  </div>
                </>
              ) : (
                <div>
                  <label for={f('mjesto')} class="rn-label">Mjesto ili kvart</label>
                  <input
                    id={f('mjesto')}
                    name="mjesto"
                    type="text"
                    class="rn-input"
                    list={f('areas')}
                    autocomplete="address-level2"
                    placeholder="npr. Sesvete"
                    required
                    minlength="2"
                    aria-describedby={f('mjesto-err')}
                  />
                  <datalist id={f('areas')}>{areas.map((a) => <option value={a} />)}</datalist>
                  <p class="rn-err" id={f('mjesto-err')} data-rn-err="mjesto" hidden></p>
                </div>
              )
            }

            <fieldset data-rn-group="velicina">
              <legend class="rn-label">
                {zgrada ? 'Površina krova' : 'Veličina krova'} <span class="rn-opt">· {zgrada ? 'otprilike, nije obavezno' : 'otprilike'}</span>
              </legend>
              <div class="flex flex-wrap gap-2">
                {
                  roofSizes.map((s) => (
                    <label class="rn-pill">
                      <input
                        type="radio"
                        name="velicina"
                        value={s}
                        required={!zgrada}
                        aria-describedby={f('velicina-err')}
                        class="sr-only"
                      />
                      <span>{s}</span>
                    </label>
                  ))
                }
              </div>
              <p class="rn-err" id={f('velicina-err')} data-rn-err="velicina" hidden></p>
            </fieldset>

            <div>
              <p class="rn-label" id={f('foto-l')}>
                Fotografije <span class="rn-opt">· do 6, nije obavezno</span>
              </p>
              <label class="rn-drop">
                <input
                  type="file"
                  name="fotografije"
                  accept="image/*"
                  multiple
                  class="rn-file"
                  aria-labelledby={f('foto-l')}
                  aria-describedby={f('foto-hint')}
                />
                <span class="rn-drop-ic" aria-hidden="true"><Icon name="camera" size={22} /></span>
                <span class="min-w-0 flex-1">
                  <span class="rn-drop-t block font-semibold">Dodajte slike krova</span>
                  <span id={f('foto-hint')} class="mt-0.5 block text-[0.875rem] leading-snug text-tinta/70">
                    {zgrada ? 'Krov, atika, mjesto gdje curi u stubište. S mobitela je sasvim dovoljno.' : 'Krov izvana, mjesto gdje curi, dimnjak. S mobitela je sasvim dovoljno.'}
                  </span>
                </span>
                <span class="rn-drop-c font-mono text-[0.75rem] text-tinta/70 tabular-nums" data-rn-photocount hidden>0 / 6</span>
              </label>
              <p class="mt-2 font-mono text-[0.75rem] text-tinta/70 empty:hidden" data-rn-photonote aria-live="polite"></p>
              <ul class="rn-thumbs" data-rn-thumbs hidden aria-label="Dodane fotografije"></ul>
            </div>

            <div>
              <label for={f('napomena')} class="rn-label">Napomena <span class="rn-opt">· nije obavezno</span></label>
              <textarea
                id={f('napomena')}
                name="napomena"
                rows="3"
                class="rn-input rn-textarea"
                placeholder={zgrada ? 'npr. curi uz atiku iznad zadnjeg kata' : 'npr. curi uz dimnjak kad pada jača kiša'}></textarea>
            </div>
          </div>
        </fieldset>

        {/* KORAK 3 */}
        <fieldset class="rn-step" data-step="3" aria-labelledby={f('h3')}>
          <div class="rn-step-head">
            <H id={f('h3')} class="rn-h" tabindex="-1" data-rn-heading>Kontakt</H>
            <p class="rn-lead">Nazovemo vas da dogovorimo dolazak.</p>
          </div>

          <div class="grid gap-6">
            <div class="grid gap-6 @[30rem]/rn:grid-cols-2 @[30rem]/rn:gap-4">
              <div>
                <label for={f('ime')} class="rn-label">Ime</label>
                <input
                  id={f('ime')}
                  name="ime"
                  type="text"
                  class="rn-input"
                  autocomplete="name"
                  placeholder="Ime i prezime"
                  required
                  minlength="2"
                  aria-describedby={f('ime-err')}
                />
                <p class="rn-err" id={f('ime-err')} data-rn-err="ime" hidden></p>
              </div>
              <div>
                <label for={f('mobitel')} class="rn-label">Mobitel</label>
                <input
                  id={f('mobitel')}
                  name="mobitel"
                  type="tel"
                  class="rn-input font-mono"
                  autocomplete="tel"
                  inputmode="tel"
                  placeholder="091 234 5678"
                  required
                  pattern="[0-9+ ()/.\-]{8,}"
                  aria-describedby={f('mobitel-err')}
                />
                <p class="rn-err" id={f('mobitel-err')} data-rn-err="mobitel" hidden></p>
              </div>
            </div>

            {
              zgrada && (
                <div>
                  <label for={f('email')} class="rn-label">
                    E-pošta <span class="rn-opt">· za ponudu, nije obavezno</span>
                  </label>
                  <input
                    id={f('email')}
                    name="email"
                    type="email"
                    class="rn-input"
                    autocomplete="email"
                    inputmode="email"
                    placeholder="ime@upravitelj.hr"
                    aria-describedby={f('email-err')}
                  />
                  <p class="rn-err" id={f('email-err')} data-rn-err="email" hidden></p>
                </div>
              )
            }

            <fieldset>
              <legend class="rn-label">Kad vas nazvati?</legend>
              <div class="grid grid-cols-3 gap-2">
                {
                  callTimes.map((t) => (
                    <label class="rn-pill justify-center">
                      <input type="radio" name="termin" value={t} checked={t === 'Svejedno'} class="sr-only" />
                      <span>{t}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
          </div>
        </fieldset>

        {/* nakon slanja: mirna potvrda (bez pečata) */}
        <div class="rn-stamp" aria-hidden="true">
          <div class="rn-stamp-in">
            <span class="rn-stamp-big">Upit je poslan</span>
            <span class="rn-stamp-no">Upit #U-<span data-rn-no>····</span></span>
          </div>
        </div>
      </div>

      {/* navigacija + napomena o podacima */}
      <div class="rn-nav">
        <p class="rn-err rn-err-submit" data-rn-err="submit" role="alert" hidden></p>
        <div class="rn-nav-row">
          <button type="button" class="rn-btn rn-btn-back" data-rn-back hidden>
            <Icon name="arrow-right" size={18} class="rotate-180" />
            <span>Natrag</span>
          </button>
          <button type="button" class="rn-btn rn-btn-next" data-rn-next hidden>
            <span>Dalje</span>
            <Icon name="arrow-right" size={18} class="rn-btn-arrow" />
          </button>
          <button type="submit" class="rn-btn rn-btn-submit" data-rn-submit>
            <span>Pošaljite upit</span>
            <Icon name="arrow-right" size={18} class="rn-btn-arrow" />
          </button>
        </div>
        <p class="rn-legal">
          Slanjem upita pristajete da vas kontaktiramo u vezi procjene.{' '}
          <a href="/privatnost">Zaštita podataka</a>
        </p>
      </div>

      {/* crtež kuće: dobiva sloj sa svakim korakom (gore desno, uz naslov koraka) */}
      <div class="rn-aside" aria-hidden="true">
        <NalogDrawing class="w-full" />
      </div>
    </form>
  </div>
</div>

<script>
  import { initRadniNalog } from '@/lib/form';
  initRadniNalog();
</script>

<style is:global>
  /* ── Radni nalog (sve klase s prefiksom rn-) ────────────────── */
  .rn {
    --rn-line: rgb(21 24 27 / 0.1);
    --rn-pad: 1.25rem;
    --rn-field: #f6f5f1;
  }
  /* bijela kartica na papiru: tanki rub + mekana sjena (bez "plutanja") */
  .rn-sheet {
    outline: 1px solid rgb(21 24 27 / 0.08);
    outline-offset: -1px;
    box-shadow:
      0 1px 2px rgb(21 24 27 / 0.04),
      0 18px 40px -22px rgb(21 24 27 / 0.22);
  }
  @container rn (width >= 36rem) {
    .rn-sheet {
      --rn-pad: 1.75rem;
    }
  }

  /* kotni lanac */
  .rn-dims {
    padding: 1.25rem var(--rn-pad) 0.25rem;
    transition: grid-template-columns 0.2s var(--ease-press);
  }
  @container rn (width >= 36rem) {
    .rn-dims {
      padding-top: 1.5rem;
    }
  }
  .rn-dim {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    color: rgb(21 24 27 / 0.6);
    transition: color 0.2s var(--ease-press);
  }
  .rn-dim-label {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    padding-inline: 0.5rem 0.25rem;
  }
  .rn-dim-n {
    font-weight: 500;
  }
  .rn-dim-line {
    position: relative;
    display: block;
    height: 9px;
  }
  .rn-dim-line::before {
    /* linija */
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 4px;
    height: 1px;
    background: currentColor;
    transition: height 0.2s var(--ease-press), top 0.2s var(--ease-press);
  }
  .rn-dim-line::after {
    /* kosa kotna oznaka na početku segmenta */
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 9px;
    background: currentColor;
    transform: rotate(45deg);
  }
  .rn-dim:last-child::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    width: 1px;
    height: 9px;
    background: currentColor;
    transform: rotate(45deg);
  }
  .rn-dim.is-done {
    color: var(--color-tinta);
  }
  .rn-dim.is-active {
    color: var(--color-redline-dark);
  }
  .rn-dim.is-active .rn-dim-line::before {
    height: 2px;
    top: 3.5px;
  }


  /* tijelo: koraci → navigacija. Crtež kuće stoji gore desno, uz naslov koraka
     (i na mobitelu, da se slojevi vide dok se forma ispunjava). */
  .rn-form {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    --rn-fig: 5.5rem;
  }
  @container rn (width >= 30rem) {
    .rn-form {
      --rn-fig: 8rem;
    }
  }
  @container rn (width >= 40rem) {
    .rn-form {
      --rn-fig: 10.5rem;
    }
  }
  .rn-steps {
    padding: 1.5rem var(--rn-pad) 1.75rem;
  }
  @container rn (width >= 40rem) {
    .rn-steps {
      padding-top: 1.75rem;
      padding-bottom: 2rem;
      min-height: 27rem;
    }
  }
  .rn-aside {
    position: absolute;
    top: 1.25rem;
    right: var(--rn-pad);
    width: var(--rn-fig);
    pointer-events: none;
  }
  @container rn (width >= 40rem) {
    .rn-aside {
      top: 1.5rem;
    }
  }
  /* bez JS-a: sva tri koraka redom */
  .rn:not(.is-stepped) .rn-step + .rn-step {
    margin-top: 2.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rn-line);
  }

  /* crtež */
  .rn-drawing {
    overflow: visible;
  }
  .rn-ln {
    stroke: var(--color-tinta);
    stroke-width: 1.25;
    stroke-linejoin: miter;
    stroke-linecap: butt;
    vector-effect: non-scaling-stroke;
  }
  .rn-ln-faint {
    stroke: rgb(21 24 27 / 0.35);
  }
  .rn-strip {
    fill: var(--color-antracit);
    stroke: #6b7379;
    stroke-width: 0.9;
    stroke-linejoin: round;
  }
  .rn-barge,
  .rn-cap {
    fill: var(--color-tinta);
  }
  .rn-gutter {
    fill: none;
    stroke: var(--color-tinta);
    stroke-width: 5;
    stroke-linecap: round;
  }
  .rn-pipe {
    fill: none;
    stroke: var(--color-tinta);
    stroke-width: 3.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .rn-eave {
    fill: none;
    stroke: var(--color-crvena);
    stroke-width: 3;
    stroke-linejoin: miter;
  }
  .rn.is-live .rn-layer,
  .rn.is-live .rn-eave {
    transition: opacity 0.2s var(--ease-press);
  }
  .rn.is-stepped[data-stage='1'] [data-layer='2'],
  .rn.is-stepped[data-stage='1'] [data-layer='3'],
  .rn.is-stepped[data-stage='2'] [data-layer='3'],
  .rn.is-stepped:not(.is-sent) .rn-eave {
    opacity: 0;
  }

  /* zaglavlja koraka */
  .rn-step {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .rn-step-head {
    margin-bottom: 1.5rem;
    padding-right: calc(var(--rn-fig) + 1rem);
    min-height: calc(var(--rn-fig) * 0.7);
  }
  .rn:not(.is-stepped) .rn-step + .rn-step .rn-step-head {
    padding-right: 0;
    min-height: 0;
  }
  .rn-h {
    font-stretch: 125%;
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1;
    padding-top: 0.08em;
    font-size: 1.75rem;
    outline: none;
  }
  .rn-h:focus-visible {
    outline: 2px solid var(--color-redline-dark);
    outline-offset: 4px;
  }
  @container rn (width >= 36rem) {
    .rn-h {
      font-size: 2rem;
    }
  }
  .rn-lead {

---
/**
 * Ikone (inline SVG, currentColor). Linijske ikone 24×24, stroke 1.75.
 * Brend ikone (whatsapp, viber, google) dolaze iz simple-icons.
 */
import { siWhatsapp, siViber, siGoogle } from 'simple-icons';

export type IconName =
  | 'phone'
  | 'whatsapp'
  | 'viber'
  | 'google'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'check'
  | 'menu'
  | 'close'
  | 'star'
  | 'map-pin'
  | 'camera'
  | 'clock'
  | 'shield'
  | 'plus'
  | 'minus'
  | 'mail'
  | 'ruler'
  | 'file'
  | 'building';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
  label?: string;
}
const { name, class: className = '', size = 20, label } = Astro.props;

const brand: Record<string, string> = {
  whatsapp: siWhatsapp.path,
  viber: siViber.path,
  google: siGoogle.path,
};

const line: Record<string, string> = {
  phone:
    '<path d="M5 4h3.5l1.5 4-2.2 1.4a11 11 0 0 0 6.8 6.8L16 14l4 1.5V19a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4Z"/>',
  'arrow-right': '<path d="M4 12h15M13 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
  check: '<path d="m4.5 12.5 4.5 4.5L19.5 6.5"/>',
  menu: '<path d="M3 7h18M3 12h18M3 17h18"/>',
  close: '<path d="M5 5l14 14M19 5 5 19"/>',
  star: '<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9Z" fill="currentColor" stroke="none"/>',
  'map-pin': '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>',
  camera: '<path d="M4 8h3l1.5-2h7L17 8h3v11H4Z"/><circle cx="12" cy="13" r="3.5"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  shield: '<path d="M12 3 5 6v5.5c0 4.4 3 8 7 9.5 4-1.5 7-5.1 7-9.5V6Z"/><path d="m9 12 2 2 4-4"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  minus: '<path d="M5 12h14"/>',
  mail: '<path d="M3.5 6h17v12h-17Z"/><path d="m4 7 8 6 8-6"/>',
  ruler: '<path d="M3 16 16 3l5 5L8 21Z"/><path d="m7 12 2 2M10 9l2 2M13 6l2 2"/>',
  file: '<path d="M6 3h8l4 4v14H6Z"/><path d="M14 3v4h4M9 12h6M9 16h6"/>',
  building: '<path d="M5 21V4h10v17M15 9h4v12M3 21h18"/><path d="M8 8h1M11 8h1M8 12h1M11 12h1M8 16h1M11 16h1"/>',
};

const isBrand = name in brand;
---

{
  isBrand ? (
    <svg
      viewBox="0 0 24 24"
      width={size}
      height={size}
      class={className}
      fill="currentColor"
      role={label ? 'img' : undefined}
      aria-label={label}
      aria-hidden={label ? undefined : 'true'}
    >
      <path d={brand[name]} />
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      width={size}
      height={size}
      class={className}
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="square"
      stroke-linejoin="miter"
      role={label ? 'img' : undefined}
      aria-label={label}
      aria-hidden={label ? undefined : 'true'}
      set:html={line[name]}
    />
  )
}

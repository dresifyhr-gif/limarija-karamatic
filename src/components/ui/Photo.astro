---
/**
 * Fotografija projekta: AVIF/WebP, responzivne širine, lazy po defaultu.
 * Za LCP/hero proslijediti loading="eager" i fetchpriority="high".
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  imgClass?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}
const {
  src,
  alt,
  widths = [480, 640, 800, 960, 1200],
  sizes = '(min-width: 1024px) 33vw, 90vw',
  class: className,
  imgClass = 'h-full w-full object-cover',
  loading = 'lazy',
  fetchpriority,
} = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  widths={widths.filter((w) => w <= src.width)}
  sizes={sizes}
  formats={['avif', 'webp']}
  quality={55}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  pictureAttributes={{ class: className }}
  class={imgClass}
/>

---
/**
 * Fotografija projekta: AVIF/WebP, responzivne širine, lazy po defaultu.
 * Za LCP/hero proslijediti loading="eager" i fetchpriority="high".
 * `src` je SiteImage: lokalni ImageMetadata (src/assets) ILI udaljena fotografija s Vercel Bloba
 * ({ src, width, height, remote: true } iz getContent()). Obje Astro optimizira u buildu (sharp);
 * udaljena dobiva JPEG kao zamjenski format (inače bi zamjenski <img> bio PNG od ~1,8 MB).
 */
import { Picture } from 'astro:assets';
import { isRemoteImage, type SiteImage } from '@/lib/content';

interface Props {
  src: SiteImage;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  imgClass?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}
const {
  src,
  alt,
  widths = [480, 640, 800, 960, 1200],
  sizes = '(min-width: 1024px) 33vw, 90vw',
  class: className,
  imgClass = 'h-full w-full object-cover',
  loading = 'lazy',
  fetchpriority,
} = Astro.props;

/* samo širine koje fotografija stvarno ima (bez povećavanja); premala fotografija → njezina širina */
const fit = widths.filter((w) => w <= src.width);
const srcWidths = fit.length ? fit : [src.width];
/* udaljena fotografija (do 2560 px s mobitela): zamjenski <img> najviše do najveće tražene širine */
const maxW = Math.max(...srcWidths);
const remoteH = Math.round((src.height * maxW) / src.width);
---

{
  isRemoteImage(src) ? (
    <Picture
      src={src.src}
      width={maxW}
      height={remoteH}
      alt={alt}
      widths={srcWidths}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={55}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
      pictureAttributes={{ class: className }}
      class={imgClass}
    />
  ) : (
    <Picture
      src={src}
      alt={alt}
      widths={srcWidths}
      sizes={sizes}
      formats={['avif', 'webp']}
      quality={55}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
      pictureAttributes={{ class: className }}
      class={imgClass}
    />
  )
}

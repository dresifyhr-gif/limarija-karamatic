---
/**
 * Završna sekcija s formom — JEDINA višekratna "forma + izravni kontakt" sekcija na stranici
 * (naslovnica, usluge, radovi, kontakt, procjena, upravitelji). Uvijek id="procjena"
 * (mobilni dock se tu skriva, a linkovi s data-quote-link vode ovamo).
 *
 * Props (sve opcionalno, zadano = naslovnica):
 *  title?         naslov h2 (default "Ne čekajte da počne kapati."); '' = bez zaglavlja (npr. /procjena, gdje je h1 iznad)
 *  lead?          uvodni red ispod naslova
 *  preselect?     id iz jobTypes ili slug usluge → odabran korak 1 forme
 *  variant?       'standard' | 'zgrada' (forma za upravitelje, prilagođen kontakt i koraci)
 *  index?         zadržano radi kompatibilnosti; brojevi sekcija se više ne prikazuju
 *  headingLevel?  2 | 3 — razina naslova koraka u formi; default 3 kad sekcija ima naslov, inače 2
 *  contact?       false = bez stupca telefon/WhatsApp (npr. /kontakt, gdje je kontakt već u heru)
 * Slot "note": dodatni blok ispod kontakta (npr. "Za ponudu trebamo" na /upravitelji-zgrada).
 *
 * Desktop: lijevo naslov + izravni kontakt (5/12), desno forma (7/12). Mobitel: naslov → forma → kontakt.
 * Izravni kontakt je samo telefon i WhatsApp (poruke idu isključivo preko WhatsAppa).
 *
 * Svijetli list (X12): papir + milimetarski papir koji se mekano pojavi i nestane, forma je bijela kartica.
 * Slot "note" dolazi sa stranice; ako još nosi stare tamne klase (text-linija, text-celik, text-redline),
 * ovdje se lokalno prevode u tamni tekst na svijetlom, da kontrast ostane AA.
 */
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import RadniNalog from '@/components/form/RadniNalog.astro';
import { getContent } from '@/lib/content';

const { contact: site, services, telHref, waHref } = await getContent();

interface Props {
  title?: string;
  lead?: string;
  preselect?: string;
  variant?: 'standard' | 'zgrada';
  index?: string;
  headingLevel?: 2 | 3;
  /** stupac izravnog kontakta (telefon + WhatsApp); false na /kontakt, gdje ga hero već nudi */
  contact?: boolean;
}
const {
  title = 'Ne čekajte da počne kapati.',
  lead = 'Besplatna procjena na terenu. Pisana ponuda stavku po stavku.',
  preselect,
  variant = 'standard',
  contact = true,
} = Astro.props;
const zgrada = variant === 'zgrada';
const hasHead = !!title;
const headingLevel = Astro.props.headingLevel ?? (hasHead ? 3 : 2);

const eyebrow = zgrada ? 'Upit za zgradu' : 'Besplatna procjena';
// usluga odabrana unaprijed (servisne stranice, radovi) → WhatsApp poruka već kaže o čemu se radi
const preService = preselect ? services.find((sv) => sv.slug === preselect) : undefined;
const waText = zgrada
  ? 'Pozdrav, upravitelj sam zgrade. Adresa: '
  : preService
    ? `Pozdrav, trebam procjenu: ${preService.title.toLowerCase()}. Lokacija: `
    : undefined;
const waLine = zgrada ? 'Ili pošaljite adresu i 3 slike krova na WhatsApp.' : 'Ili pošaljite 3 slike krova na WhatsApp.';
---

<section
  id="procjena"
  class="fc relative isolate overflow-hidden bg-papir py-24 text-tinta sm:py-28 lg:py-32"
  aria-labelledby={hasHead ? 'procjena-naslov' : undefined}
  aria-label={hasHead ? undefined : zgrada ? 'Upit za zgradu' : 'Upit za besplatnu procjenu'}
  data-variant={variant}
>
  <div
    class="grid-paper-light pointer-events-none absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,transparent,#000_22%,#000_78%,transparent)]"
    aria-hidden="true"
  >
  </div>

  <div class="wrap">
    <div class="grid gap-y-12 lg:grid-cols-12 lg:grid-rows-[auto_1fr] lg:gap-x-12 lg:gap-y-12 xl:gap-x-16">
      <!-- naslov -->
      {
        hasHead && (
          <header class="lg:col-span-5 lg:row-start-1">
            <p class="eyebrow mb-4 text-tinta/70" data-reveal>
              {eyebrow}
            </p>
            <h2
              id="procjena-naslov"
              class="type-display text-[2.125rem] text-balance sm:text-5xl lg:text-[clamp(2.625rem,4.1vw,3.75rem)]"
              data-reveal
            >
              {title}
            </h2>
            {lead && (
              <p class="mt-5 max-w-md text-lg leading-relaxed text-pretty text-tinta/70" data-reveal>
                {lead}
              </p>
            )}
          </header>
        )
      }

      <!-- forma -->
      <div class="min-w-0 lg:col-span-7 lg:col-start-6 lg:row-span-2 lg:row-start-1">
        <RadniNalog preselect={preselect} variant={variant} headingLevel={headingLevel} />
      </div>

      <!-- izravni kontakt: telefon + WhatsApp -->
      {(contact || Astro.slots.has('note')) && (
      <div
        class:list={['fc-contact lg:col-span-5 lg:col-start-1', hasHead ? 'lg:row-start-2' : 'lg:row-span-2 lg:row-start-1']}
        data-reveal-group
      >
        {contact && (<>
        <div data-reveal>
          {!hasHead && <p class="mb-3 text-[1.0625rem] font-semibold">Radije razgovarate?</p>}
          <a
            href={telHref}
            class="fc-tel group inline-flex min-h-11 items-center gap-3.5 font-mono text-[1.5rem] leading-none font-medium tracking-[-0.01em] [word-spacing:-0.25em] text-tinta tabular-nums sm:text-[1.75rem]"
            aria-label={`Nazovite ${site.phoneDisplay}`}
          >
            <Icon name="phone" size={20} class="flex-none text-tinta/55 transition-colors duration-150 group-hover:text-tinta" />
            <span class="fc-tel-u">{site.phoneDisplay}</span>
          </a>
          <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-tinta/70">
            {site.responseTime}. <span class="whitespace-nowrap">{site.hours}</span>
          </p>
        </div>

        <div class="mt-10" data-reveal>
          <p class="text-[1.0625rem] leading-snug">{waLine}</p>
          <Button href={waHref(waText)} variant="whatsapp" size="lg" icon="whatsapp" class="mt-4 w-full sm:w-auto">
            Pošaljite slike
          </Button>
        </div>
        </>)}

        {
          Astro.slots.has('note') && (
            <div class:list={['fc-note', contact && 'mt-12 border-t border-tinta/12 pt-8']} data-reveal>
              <slot name="note" />
            </div>
          )
        }
      </div>
      )}
    </div>
  </div>
</section>

<style>
  .fc-tel-u {
    padding-bottom: 0.25rem;
    background: linear-gradient(var(--color-redline-dark), var(--color-redline-dark)) left bottom / 0% 2px no-repeat;
    transition: background-size 200ms var(--ease-press);
  }
  .fc-tel:hover .fc-tel-u,
  .fc-tel:focus-visible .fc-tel-u {
    background-size: 100% 2px;
  }

  /* napomena sa stranice: stare tamne klase → tamni tekst na svijetlom listu */
  .fc-note :global(.text-linija),
  .fc-note :global(.text-white) {
    color: var(--color-tinta);
  }
  .fc-note :global(.text-celik) {
    color: rgb(21 24 27 / 0.7);
  }
  .fc-note :global(.text-redline) {
    color: var(--color-redline-dark);
  }
</style>

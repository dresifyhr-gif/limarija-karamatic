---
/**
 * Standard izvedbe i jamstvo — "sastavnica" (zaglavlje tehničkog crteža).
 * Koristi se na /o-nama (iza "Tri pravila"); s naslovnice je maknuta. Svijetla sekcija, bez broja.
 *  id?     id sekcije (default "jamstvo")
 *  class?  pozadina i razmaci sekcije (default "bg-papir py-24 sm:py-28 lg:py-32")
 *  cta?    gumb "Besplatna procjena" ispod tablice (default true; /procjena + data-quote-link)
 * Tablica iz site.ts → standard[] (podaci su potvrđeni, bez oznaka nepotvrđenosti).
 * Red s highlight (jamstvo): crvena "rukom" povučena elipsa (DrawSVG, draft) + mali Λ pečat (press).
 * Bez zaglavlja crteža i bez broja pozicije (manje sitnih oznaka): stavka (sans, prigušeno) · izvedba.
 * Mobitel: oznaka iznad vrijednosti; ARIA uloge čuvaju semantiku tablice.
 * Raspored: do xl naslov iznad tablice (tablica treba punu širinu), od xl naslov lijevo 4/12.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import Button from '@/components/ui/Button.astro';
import { standard } from '@/data/site';

type Row = { k: string; v: string; highlight?: boolean };
const rows = standard as Row[];

interface Props {
  id?: string;
  class?: string;
  cta?: boolean;
}
const { id = 'jamstvo', class: sectionClass = 'bg-papir py-24 sm:py-28 lg:py-32', cta = true } = Astro.props;
---

<section id={id} class:list={['tb-sec text-tinta', sectionClass]} data-sastavnica>
  <div class="wrap grid gap-12 sm:gap-14 xl:grid-cols-12 xl:gap-x-12">
    <div class="xl:col-span-4">
      <SectionHead
        eyebrow="Jamstvo"
        title="Standard izvedbe i jamstvo."
        lead="Što ugrađujemo, koliko je lim debeo i što vam jamčimo. Prije početka radova, na papiru."
        tone="light"
      />
    </div>

    <div class="min-w-0 xl:col-span-8">
      <div class="tb border border-tinta" data-reveal>
        <table class="tb-table" role="table">
          <caption class="sr-only">Standard izvedbe i jamstvo</caption>
          <thead class="tb-thead" role="rowgroup">
            <tr role="row" class="tb-row">
              <th scope="col" role="columnheader" class="tb-k">Stavka</th>
              <th scope="col" role="columnheader" class="tb-v">Izvedba</th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {
              rows.map((r) => (
                <tr role="row" class:list={['tb-row', r.highlight && 'tb-row--hl']}>
                  <th scope="row" role="rowheader" class="tb-k">
                    <span>{r.k}</span>
                  </th>
                  <td role="cell" class="tb-v">
                    {r.highlight ? (
                      <span class="tb-hl">
                        <span class="tb-ring-wrap">
                          <span class="relative z-[1]">{r.v}</span>
                          <svg class="tb-ring" viewBox="0 0 200 48" preserveAspectRatio="none" fill="none" aria-hidden="true">
                            <path
                              d="M30 6C80 0 150 0 184 8C204 13 203 36 178 42C140 50 60 50 20 42C-2 37-3 14 24 8C48 3 80 2 104 3"
                              stroke="currentColor"
                              stroke-width="1.75"
                              stroke-linecap="round"
                              data-ring
                            />
                          </svg>
                        </span>
                        <span class="tb-stamp" aria-hidden="true" data-stamp>
                          <svg viewBox="0 0 40 32" width="19" height="15">
                            <path d="M2 30 20 2l18 28h-8L20 14 10 30Z" fill="currentColor" />
                          </svg>
                        </span>
                      </span>
                    ) : (
                      <span class="tb-val">{r.v}</span>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="mt-8 flex flex-col gap-6 sm:mt-10 sm:flex-row sm:items-center sm:justify-between" data-reveal>
        <p class="max-w-[34rem] text-base leading-relaxed text-tinta/75">
          Na materijal vrijedi jamstvo proizvođača. Sve piše u ponudi i na računu.
        </p>
        {
          cta && (
            <Button href="/procjena" variant="primary" iconRight="arrow-right" class="w-full shrink-0 sm:w-auto" data-quote-link>
              Besplatna procjena
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* sigurnosna mreža: ništa iz sekcije ne smije proširiti stranicu */
  .tb-sec {
    overflow-x: clip;
  }

  .tb {
    position: relative;
    --line: 1px solid var(--color-tinta);
    --cols: minmax(0, 1fr);
    background: rgb(255 255 255 / 0.32);
  }
  @media (width >= 40rem) {
    .tb {
      --cols: minmax(10rem, 15rem) minmax(0, 1fr);
    }
  }

  /* ── tablica ── */
  .tb-table,
  .tb-table tbody {
    display: block;
    width: 100%;
  }
  .tb-row {
    display: grid;
    grid-template-columns: var(--cols);
  }
  .tb-row + .tb-row {
    border-top: 1px solid rgb(21 24 27 / 0.14);
  }
  .tb-row > * {
    text-align: left;
    font-weight: inherit;
  }
  /* zaglavlje stupaca: samo za čitače ekrana (manje sitnih oznaka).
     Specifičnost 0,2,0 — mora pobijediti blok pravila iznad, inače je thead širok 100 %
     viewporta i proširi stranicu (horizontalni scroll, mobilna traka ispadne s ekrana). */
  .tb-table .tb-thead {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .tb-k {
    padding: 0.9375rem 1rem 0;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: rgb(21 24 27 / 0.7);
  }
  .tb-v {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: 1.25rem;
    row-gap: 0.5rem;
    padding: 0.375rem 1rem 1rem;
    font-size: 1rem;
    line-height: 1.4;
    font-weight: 500;
    color: rgb(21 24 27 / 0.94);
  }
  .tb-k {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (width >= 40rem) {
    .tb-k {
      display: flex;
      align-items: center;
      padding: 1rem 1.25rem;
      border-right: 1px solid rgb(21 24 27 / 0.14);
    }
    .tb-v {
      padding: 1rem 1.25rem;
      min-height: 3.5rem;
    }
  }

  /* ── red s jamstvom ── */
  .tb-row--hl > .tb-k {
    color: var(--color-tinta);
    font-weight: 500;
  }
  .tb-row--hl > .tb-v {
    padding-top: 1.125rem;
    padding-bottom: 1.375rem;
    padding-left: 1.75rem;
    font-size: 1.125rem;
    font-weight: 650;
    color: var(--color-tinta);
  }
  @media (width >= 40rem) {
    .tb-row--hl > .tb-v {
      padding-block: 1.5rem;
    }
  }
  .tb-hl {
    display: inline-flex;
    align-items: center;
    gap: 1.75rem;
  }
  /* "rukom" povučena elipsa oko vrijednosti jamstva */
  .tb-ring-wrap {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }
  .tb-ring {
    position: absolute;
    left: -1rem;
    top: -0.7rem;
    width: calc(100% + 2rem);
    height: calc(100% + 1.4rem);
    max-width: none;
    overflow: visible;
    color: var(--color-redline-dark);
    pointer-events: none;
    rotate: -1.5deg;
  }
  /* mali Λ pečat */
  .tb-stamp {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid var(--color-crvena);
    outline: 1px solid var(--color-crvena);
    outline-offset: -5px;
    color: var(--color-crvena);
    rotate: -7deg;
    flex-shrink: 0;
  }
  .tb-stamp svg {
    margin-top: -1px;
  }

  /* Pokret */
  :global(.motion) .tb-ring path {
    visibility: hidden;
  }
  :global(.motion) .tb-stamp {
    opacity: 0;
  }
</style>

<script>
  import { gsap, motionOn } from '@/lib/motion';

  function init() {
    if (!motionOn()) return;
    document.querySelectorAll<HTMLElement>('[data-sastavnica]').forEach((root) => {
      const ring = root.querySelector<SVGPathElement>('[data-ring]');
      const stamp = root.querySelector<HTMLElement>('[data-stamp]');
      if (!ring) return;
      gsap.set(ring, { drawSVG: '0%', visibility: 'visible' });
      const tl = gsap.timeline({
        scrollTrigger: { trigger: ring.closest('tr') ?? ring, start: 'top 72%', once: true },
      });
      tl.to(ring, { drawSVG: '100%', duration: 0.9, ease: 'draft' }, 0.15);
      if (stamp) {
        tl.fromTo(
          stamp,
          { opacity: 0, scale: 1.35 },
          { opacity: 1, scale: 1, duration: 0.24, ease: 'press' },
          '>+0.05',
        );
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>

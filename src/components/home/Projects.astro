---
/**
 * Radovi (id="radovi", bijelo) — vodoravni rail izdvojenih projekata.
 * Native CSS scroll-snap (bez biblioteke), bez autoplaya.
 * Kontrole (tek s JS-om, atribut hidden): tanka linija napretka (1 px, bijela/80 — ne crvena)
 *   i strelice ‹ › 44 px od md naviše. Bez brojača; jedan mono red po kartici.
 * Na kraju/početku raila gumb dobiva aria-disabled="true" (ne `disabled`) da fokus ne padne na <body>.
 * Sve kartice su lazy; reveal.ts prije scana čeka da se slika učita.
 *
 * Fotografije se na naslovnici ne ponavljaju: kartica uzima prvu fotografiju projekta koja još
 * nije prikazana (Usluge, Kako radimo). Projekt bez nove fotografije se preskače;
 * prvo izdvojeni radovi, pa ostali; najviše dva iste vrste.
 */
import type { ImageMetadata } from 'astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import Icon from '@/components/ui/Icon.astro';
import { projects, services, type Project } from '@/data/site';
import processPoster from '@/assets/projects/krov-crijep-lim-spoj-radnik.jpg';

const MAX = 6;
const shown = new Set<string>(
  [
    ...services.map((s) => s.image), // Usluge
    processPoster, // Kako radimo
  ]
    .filter((i): i is ImageMetadata => !!i)
    .map((i) => i.src),
);
const perKind = new Map<string, number>();
const cards: { project: Project; image: ImageMetadata }[] = [];
for (const p of [...projects.filter((p) => p.featured), ...projects.filter((p) => !p.featured)]) {
  if (cards.length >= MAX) break;
  if ((perKind.get(p.kind) ?? 0) >= 2) continue;
  const image = [p.image, ...p.gallery].find((i) => !shown.has(i.src));
  if (!image) continue;
  shown.add(image.src);
  perKind.set(p.kind, (perKind.get(p.kind) ?? 0) + 1);
  cards.push({ project: p, image });
}

const btn =
  'grid h-11 w-11 place-items-center border border-tinta/20 text-tinta transition-[border-color,background-color,color,opacity] duration-150 ease-[var(--ease-press)] hover:border-tinta hover:bg-tinta hover:text-white aria-disabled:cursor-default aria-disabled:opacity-30 aria-disabled:hover:border-tinta/20 aria-disabled:hover:bg-transparent aria-disabled:hover:text-tinta';
const allLink =
  'group/all min-h-11 items-center gap-2 text-[0.9375rem] font-semibold text-tinta underline-offset-4 hover:underline';
---

<section id="radovi" class="bg-white py-24 text-tinta sm:py-28 lg:py-32" data-rail>
  <div class="wrap">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
      <SectionHead
        eyebrow="Radovi"
        title="Ovo nije render."
        lead="Pravi krovovi s naših gradilišta."
        tone="light"
      />
      <a href="/radovi" class:list={[allLink, 'hidden shrink-0 lg:mb-1.5 lg:inline-flex']} data-reveal>
        Svi radovi
        <Icon name="arrow-right" size={18} class="transition-transform duration-150 group-hover/all:translate-x-0.5" />
      </a>
    </div>
  </div>

  <div class="relative mt-12 sm:mt-14 lg:mt-16">
    <div
      id="radovi-niz"
      class="rail-track overflow-x-auto overscroll-x-contain"
      role="region"
      tabindex="0"
      aria-label={`Izdvojeni radovi, ${cards.length} projekata. Za pomicanje koristite strelice lijevo i desno.`}
      data-rail-track
    >
      <ul class="rail-list flex w-max list-none gap-4 sm:gap-5 lg:gap-6" role="list" data-rail-list>
        {
          cards.map(({ project, image }) => (
            <li class="rail-item w-[78vw] max-w-[22rem] shrink-0 text-tinta sm:w-[22rem] lg:w-[26rem] lg:max-w-none">
              <ProjectCard project={project} image={image} meta={false} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="wrap mt-8 flex items-center gap-6">
    <!-- tanka linija napretka · strelice (md+); tek s JS-om -->
    <div class="flex flex-1 items-center gap-6 md:min-h-11" data-rail-controls hidden>
      <div class="relative h-px flex-1 bg-tinta/12" aria-hidden="true">
        <span class="rail-thumb absolute inset-y-0 left-0 bg-tinta/70" data-rail-thumb></span>
      </div>
      <div class="hidden items-center gap-2 md:flex">
        <button
          type="button"
          class={btn}
          aria-label="Prethodni radovi"
          aria-controls="radovi-niz"
          aria-disabled="true"
          data-rail-prev
        >
          <Icon name="arrow-right" size={18} class="rotate-180" />
        </button>
        <button type="button" class={btn} aria-label="Sljedeći radovi" aria-controls="radovi-niz" data-rail-next>
          <Icon name="arrow-right" size={18} />
        </button>
      </div>
    </div>
    <a href="/radovi" class:list={[allLink, 'ml-auto inline-flex shrink-0 lg:hidden']}>
      Svi radovi
      <Icon name="arrow-right" size={18} class="transition-transform duration-150 group-hover/all:translate-x-0.5" />
    </a>
  </div>
</section>

<style>
  /* Rail počinje poravnat s .wrap sadržajem, a desno izlazi do ruba ekrana */
  .rail-track {
    --rail-pad: calc(max(0px, (100% - 88rem) / 2) + 1.25rem);
    scroll-padding-inline: var(--rail-pad);
    /* mjesto za fokus okvir kartica (overflow bi ga inače odrezao) */
    padding-block: 0.5rem;
    margin-block: -0.5rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .rail-track::-webkit-scrollbar {
    display: none;
  }
  @media (width >= 48rem) {
    .rail-track {
      --rail-pad: calc(max(0px, (100% - 88rem) / 2) + 2rem);
    }
  }
  @media (width >= 80rem) {
    .rail-track {
      --rail-pad: calc(max(0px, (100% - 88rem) / 2) + 3rem);
    }
  }
  .rail-track:focus-visible {
    outline-offset: -2px;
  }
  /* rubni razmak je unutar liste (pouzdano ulazi u širinu skrolanja i na kraju raila) */
  .rail-list {
    padding-inline: var(--rail-pad);
  }
  .rail-item {
    scroll-snap-align: start;
  }
  /* klizač: širina = udio vidljivog, položaj = napredak (skripta) */
  .rail-thumb {
    width: 33%;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-rail]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-rail-track]');
    if (!track) return;
    const list = root.querySelector<HTMLElement>('[data-rail-list]') ?? track;
    const items = Array.from(list.children) as HTMLElement[];
    const thumb = root.querySelector<HTMLElement>('[data-rail-thumb]');
    const controls = root.querySelector<HTMLElement>('[data-rail-controls]');
    const prev = root.querySelector<HTMLButtonElement>('[data-rail-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-rail-next]');
    const reduce = () =>
      !document.documentElement.classList.contains('motion') ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const stepSize = () => {
      const a = items[0];
      const b = items[1];
      return a && b ? b.offsetLeft - a.offsetLeft : track.clientWidth;
    };
    // aria-disabled umjesto disabled: gumb ostaje fokusabilan, klik se ignorira
    const setOff = (b: HTMLButtonElement | null, off: boolean) => b?.setAttribute('aria-disabled', String(off));
    const isOff = (b: HTMLButtonElement | null) => b?.getAttribute('aria-disabled') === 'true';

    let raf = 0;
    const update = () => {
      raf = 0;
      const max = track.scrollWidth - track.clientWidth;
      // sve stane u ekran → kontrole ne trebaju
      if (controls) controls.hidden = max <= 2;
      const x = Math.max(0, track.scrollLeft);
      if (thumb) {
        const visible = Math.min(1, track.clientWidth / track.scrollWidth);
        const progress = max > 0 ? Math.min(1, x / max) : 0;
        thumb.style.width = `${visible * 100}%`;
        thumb.style.left = `${progress * (1 - visible) * 100}%`;
      }
      setOff(prev, x <= 2);
      setOff(next, x >= max - 2);
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    track.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });

    const go = (btn: HTMLButtonElement | null, dir: 1 | -1) =>
      btn?.addEventListener('click', () => {
        if (isOff(btn)) return;
        track.scrollBy({ left: dir * stepSize(), behavior: reduce() ? 'auto' : 'smooth' });
      });
    go(prev, -1);
    go(next, 1);

    update();
  });
</script>

---
/**
 * Usluge (id="usluge", papir) — šest kartica s fotografijom.
 * Kartica: fotografija 4:3 (data-scan), u donjem lijevom kutu mala papirnata pločica s presjekom
 * profila (ProfileIcon se savije kad uđe u ekran i na hover), naslov i JEDAN red opisa.
 * Cijela kartica je jedan link na /usluge/{slug}. Bez popisa stavki i bez drugog linka po kartici.
 * Raspored: ≥ lg 3 × 2 · md 2 stupca · mobitel 1 stupac kao vodoravni red (fotografija lijevo),
 *   da cijela sekcija na 390 px stane u ~1,5 ekrana.
 */
import { services } from '@/data/site';
import SectionHead from '@/components/ui/SectionHead.astro';
import Photo from '@/components/ui/Photo.astro';
import ProfileIcon from '@/components/ui/ProfileIcon.astro';
import Icon from '@/components/ui/Icon.astro';

/* jedan kratki red po usluzi — sažetak `service.short` iz site.ts (bez novih tvrdnji) */
const line: Record<string, string> = {
  'limeni-krovovi': 'Crijep-lim i trapez. Novi krov ili zamjena starog crijepa.',
  'falcani-krovovi': 'Dvostruki stojeći falc bez vidljivih vijaka.',
  'popravak-krova': 'Krov pušta? Nađemo uzrok, a ne samo mrlju.',
  'opsav-atike': 'Kape atika s pravim kutovima i preklopima.',
  dimnjaci: 'Opšav uz krov, oblaganje limom i kape.',
  'oluci-snjegobrani': 'Oluci, vertikale i snjegobrani.',
};
// fokus kadra kod rezanja portretnih fotki na 4:3
const focus: Record<string, string> = { dimnjaci: 'object-[50%_30%]' };
---

<section id="usluge" class="bg-papir py-24 text-tinta sm:py-28 lg:py-32">
  <div class="wrap">
    <div class="grid gap-5 lg:grid-cols-12 lg:items-end lg:gap-8">
      <SectionHead class="lg:col-span-7" tone="light" eyebrow="Usluge" title="Sve što se na krovu radi limom." />
      <p
        class="max-w-[34rem] text-lg leading-relaxed text-pretty text-tinta/70 lg:col-span-5 lg:mb-1.5 lg:justify-self-end"
        data-reveal
      >
        Od cijelog novog krova do jednog opšava uz dimnjak. Lim krojimo i savijamo po mjeri vašeg krova.
      </p>
    </div>

    <ul class="svc-grid mt-12 sm:mt-14 lg:mt-16" role="list" data-reveal-group>
      {
        services.map((s) => (
          <li data-reveal>
            <a href={`/usluge/${s.slug}`} class="svc group/s" data-profile-host>
              <div class="svc-fig">
                <div class="svc-photo" data-scan>
                  <Photo
                    src={s.image}
                    alt={s.imageAlt}
                    widths={[320, 480, 640, 800, 960]}
                    sizes="(min-width: 1440px) 420px, (min-width: 1024px) 30vw, (min-width: 768px) 46vw, 9.5rem"
                    class="block h-full w-full"
                    imgClass={`svc-img h-full w-full object-cover ${focus[s.slug] ?? ''}`}
                  />
                </div>
                <span class="svc-tile" aria-hidden="true">
                  <ProfileIcon profile={s.profile} size={64} animate class="svc-icon" />
                </span>
              </div>
              <div class="svc-body">
                <h3 class="svc-title">
                  {s.title}
                  <Icon name="arrow-right" size={18} class="svc-arrow" />
                </h3>
                <p class="svc-line">{line[s.slug] ?? s.short}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .svc-grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (width >= 48rem) {
    .svc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
      row-gap: 3rem;
    }
  }
  @media (width >= 64rem) {
    .svc-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2rem;
      row-gap: 3.5rem;
    }
  }

  /* ── kartica: mobitel = vodoravni red ─────────────────────── */
  .svc {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    align-items: center;
    column-gap: 1.125rem;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }
  .svc:focus-visible {
    outline-offset: 4px;
  }
  .svc-fig {
    position: relative;
  }
  .svc-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-papir-2);
  }
  .svc-photo :global(.svc-img) {
    transition: transform 400ms var(--ease-draft);
  }
  /* papirnata pločica s presjekom u donjem lijevom kutu fotografije */
  .svc-tile {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--color-papir);
    color: var(--color-tinta);
    pointer-events: none;
  }
  .svc-tile :global(.svc-icon) {
    width: 2rem;
    height: 2rem;
  }
  .svc-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.1875rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.005em;
    font-variation-settings: 'wdth' 112;
    text-wrap: balance;
  }
  .svc-title :global(.svc-arrow) {
    flex-shrink: 0;
    opacity: 0.55;
    transition:
      transform 180ms var(--ease-press),
      opacity 180ms var(--ease-press);
  }
  .svc-line {
    margin-top: 0.3rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: rgb(21 24 27 / 0.7);
    text-wrap: pretty;
  }

  /* ── md+: okomita kartica (fotografija gore) ───────────────── */
  @media (width >= 48rem) {
    .svc {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
    .svc-body {
      padding-top: 1.25rem;
    }
    .svc-tile {
      width: 4rem;
      height: 4rem;
    }
    .svc-tile :global(.svc-icon) {
      width: 2.875rem;
      height: 2.875rem;
    }
    .svc-title {
      font-size: 1.5rem;
      justify-content: space-between;
    }
    .svc-line {
      margin-top: 0.5rem;
      font-size: 1rem;
    }
  }

  /* hover (miš): fotografija se lagano približi, strelica se pomakne; profil se savije (ProfileIcon) */
  @media (hover: hover) {
    .svc:hover :global(.svc-img) {
      transform: scale(1.03);
    }
    .svc:hover .svc-title :global(.svc-arrow) {
      opacity: 1;
      transform: translateX(3px);
    }
  }
  .svc:focus-visible .svc-title :global(.svc-arrow) {
    opacity: 1;
    transform: translateX(3px);
  }
</style>

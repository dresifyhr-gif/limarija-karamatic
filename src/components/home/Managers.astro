---
/**
 * Za zgrade (id="zgrade", papir-2) — kompaktna svijetla traka između Recenzija i Pitanja (≤ 0,45 ekrana).
 * Jedan naslov, tri kratke točke u nizu i jedan gumb na /upravitelji-zgrada. Bez fotografije:
 * cijela priča (ponuda za suvlasnike, R1, fotodokumentacija) je na stranici za upravitelje.
 * Statična sekcija: samo data-reveal.
 */
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';

interface Props {
  /** zadržano radi kompatibilnosti; brojevi sekcija se više ne prikazuju */
  index?: string;
}

const points: { icon: IconName; text: string }[] = [
  { icon: 'building', text: 'Ponuda za odluku suvlasnika' },
  { icon: 'file', text: 'Račun na zgradu, plaćanje iz pričuve' },
  { icon: 'camera', text: 'Fotografije prije i poslije radova' },
];
---

<section id="zgrade" class="bg-papir-2 py-14 text-tinta sm:py-16 lg:py-20" aria-labelledby="zgrade-naslov">
  <div class="wrap flex flex-col gap-y-8 lg:flex-row lg:items-center lg:justify-between lg:gap-x-16">
    <div class="min-w-0">
      <p class="eyebrow text-tinta/70" data-reveal>Stambene zgrade</p>
      <h2
        id="zgrade-naslov"
        class="type-display mt-4 max-w-[24ch] text-[1.75rem] text-balance sm:text-[2.125rem] lg:text-[2.375rem]"
        data-reveal
      >
        Krov zgrade bez natezanja sa suvlasnicima.
      </h2>
      <ul class="mt-6 flex flex-col gap-y-2.5 sm:mt-7 sm:flex-row sm:flex-wrap sm:gap-x-9" data-reveal-group>
        {
          points.map((p) => (
            <li class="flex items-center gap-2.5 text-[1rem] leading-snug text-tinta/80" data-reveal>
              <Icon name={p.icon} size={18} class="flex-none text-tinta/55" />
              <span>{p.text}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex-none" data-reveal>
      <Button href="/upravitelji-zgrada" variant="outline-dark" size="lg" iconRight="arrow-right" class="w-full sm:w-auto">
        Sve za upravitelje zgrada
      </Button>
    </div>
  </div>
</section>

---
/**
 * Za zgrade (id="zgrade", papir-2) — kompaktna svijetla traka između Recenzija i Pitanja (≤ 0,45 ekrana).
 * Jedan naslov, tri kratke točke u nizu i jedan gumb na /upravitelji-zgrada. Bez fotografije:
 * cijela priča (ponuda za suvlasnike, R1, fotodokumentacija) je na stranici za upravitelje.
 * Statična sekcija: samo data-reveal.
 */
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import { getContent } from '@/lib/content';

interface Props {
  /** zadržano radi kompatibilnosti; brojevi sekcija se više ne prikazuju */
  index?: string;
}

/* Tekstovi iz admina (Naslovnica → Za zgrade); ikone točaka ostaju u kodu. */
const { homepage } = await getContent();
const m = homepage.managers;
const icons: IconName[] = ['building', 'file', 'camera'];
const points = m.points.map((text, i) => ({ icon: icons[i] ?? 'check', text }));
---

<section id="zgrade" class="bg-papir-2 py-10 text-tinta sm:py-16 lg:py-20" aria-labelledby="zgrade-naslov">
  <div class="wrap flex flex-col gap-y-7 lg:flex-row lg:items-center lg:justify-between lg:gap-x-16">
    <div class="min-w-0 [overflow-wrap:anywhere]">
      <p class="eyebrow text-tinta/70" data-reveal>{m.eyebrow}</p>
      <h2
        id="zgrade-naslov"
        class="type-display type-grow mt-4 max-w-[24ch] text-[1.75rem] text-balance sm:text-[2.125rem] lg:text-[2.375rem]"
        data-reveal
      >
        {m.title}
      </h2>
      {m.lead && <p class="mt-4 max-w-[40rem] text-[1.0625rem] leading-relaxed text-pretty text-tinta/70" data-reveal>{m.lead}</p>}
      <ul class="mt-5 flex flex-col gap-y-2 sm:mt-7 sm:flex-row sm:flex-wrap sm:gap-x-9" data-reveal-group>
        {
          points.map((p) => (
            <li class="flex items-center gap-2.5 text-[1rem] leading-snug text-tinta/80" data-reveal>
              <Icon name={p.icon} size={18} class="flex-none text-tinta/55" />
              <span class="min-w-0">{p.text}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex-none" data-reveal>
      <Button href="/upravitelji-zgrada" variant="outline-dark" size="lg" iconRight="arrow-right" class="w-full sm:w-auto">
        {m.cta}
      </Button>
    </div>
  </div>
</section>

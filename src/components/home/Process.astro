---
/**
 * Kako radimo (id="kako-radimo", papir + milimetarski papir) — 5 koraka na "kotnoj liniji".
 * Tanka okomita linija lijevo puni se crveno dok skrolate (ScrollTrigger scrub na scaleY, bez pinanja).
 * Desno (samo desktop, sticky): fotografija s gradilišta. Na mobitelu je nema — manje skrolanja.
 * Fotografija je izrezana odozdo tako da limar bez vidljivog osiguranja ostane izvan kadra.
 * HTML je u završnom stanju (linija puna, svi koraci "dosegnuti"); .motion to resetira.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import Photo from '@/components/ui/Photo.astro';
import { steps } from '@/data/site';
import poster from '@/assets/projects/krov-crijep-lim-spoj-radnik.jpg';

---

<section id="kako-radimo" class="bg-papir grid-paper-light py-24 text-tinta sm:py-28 lg:py-32" data-process>
  <div class="wrap">
    <SectionHead
      eyebrow="Kako radimo"
      title="Od poziva do pisanog jamstva."
      lead="Pet koraka, uvijek istim redom."
      tone="light"
    />

    <div class="mt-12 grid sm:mt-14 lg:mt-16 lg:grid-cols-12 lg:gap-x-12">
      <div class="proc-list relative lg:col-span-7" data-process-list>
        <span class="proc-track" aria-hidden="true"></span>
        <span class="proc-fill" aria-hidden="true" data-process-fill></span>
        <ol class="list-none">
        {
          steps.map((s) => (
            <li class="proc-step" data-process-step>
              <span class="proc-tick" aria-hidden="true" />
              <p class="proc-n type-mono">
                <span class="sr-only">Korak </span>
                {s.n}
              </p>
              <div class="proc-body">
                <h3 class="type-wide text-[1.375rem] leading-tight font-bold tracking-[-0.01em] text-tinta sm:text-[1.625rem]">
                  {s.title}
                </h3>
                <p class="mt-2 max-w-[34rem] text-base leading-relaxed text-tinta/70 sm:text-[1.0625rem]">{s.text}</p>
              </div>
            </li>
          ))
        }
        </ol>
      </div>

      <div class="hidden lg:col-span-5 lg:block">
        <figure class="proc-media lg:sticky lg:top-28">
          <div class="proc-photo relative aspect-[4/5] overflow-hidden bg-papir-2" data-scan>
            <Photo
              src={poster}
              alt="Spoj dva limena krova od crijep-lima u antracitu"
              sizes="(min-width: 1440px) 34rem, 38vw"
              imgClass="proc-img h-full w-full object-cover object-bottom"
            />
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  /* kadar: donjih ~82 % fotografije (limar na rubu krova ostaje izvan kadra) */
  .proc-photo :global(.proc-img) {
    transform: scale(1.14);
    transform-origin: 50% 100%;
  }

  /* Kotna linija: x položaj linije i uvlaka sadržaja */
  .proc-list {
    --rail-x: 0.4375rem;
    --pad: 3rem;
  }
  @media (width >= 40rem) {
    .proc-list {
      --pad: 4.5rem;
    }
  }
  .proc-track,
  .proc-fill {
    position: absolute;
    left: var(--rail-x);
    top: 0.75rem;
    bottom: 0.75rem;
    width: 1px;
  }
  .proc-track {
    background: rgb(21 24 27 / 0.16);
  }
  .proc-fill {
    background: var(--color-redline-dark);
    transform-origin: 50% 0;
    width: 2px;
    margin-left: -0.5px;
  }
  .proc-step {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    padding-left: var(--pad);
    padding-bottom: 2rem;
  }
  .proc-step:last-child {
    padding-bottom: 0;
  }
  @media (width >= 40rem) {
    .proc-step {
      grid-template-columns: 4rem 1fr;
      padding-left: calc(var(--rail-x) + 2.25rem);
      padding-bottom: 2.75rem;
    }
  }
  /* kosi zarez na kotnoj liniji (kao granica kote na nacrtu) + kratka pomoćna linija do broja */
  .proc-tick {
    position: absolute;
    left: calc(var(--rail-x) - 0.5rem);
    top: 0.25rem;
    width: 1rem;
    height: 1rem;
    color: var(--color-redline-dark);
    transition: color 200ms var(--ease-draft);
  }
  @media (width >= 40rem) {
    .proc-tick {
      top: 0.5rem;
    }
  }
  .proc-tick::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1.5px;
    margin-left: -0.75px;
    background: currentColor;
    transform: rotate(45deg);
  }
  .proc-tick::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.25rem;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }
  .proc-n {
    font-size: 0.8125rem;
    line-height: 1.5rem;
    letter-spacing: 0.06em;
    color: var(--color-redline-dark);
    transition: color 200ms var(--ease-draft);
    margin-bottom: 0.5rem;
  }
  @media (width >= 40rem) {
    .proc-n {
      margin-bottom: 0;
      padding-top: 0.25rem;
    }
  }


  /* Pokret: linija prazna, koraci "nedosegnuti" dok ih linija ne prođe */
  :global(.motion) .proc-fill {
    transform: scaleY(0);
  }
  :global(.motion) .proc-step:not(.is-on) .proc-tick {
    color: rgb(21 24 27 / 0.35);
  }
  :global(.motion) .proc-step:not(.is-on) .proc-n {
    color: rgb(21 24 27 / 0.6);
  }
</style>

<script>
  import { gsap, ScrollTrigger, motionOn } from '@/lib/motion';

  function init() {
    if (!motionOn()) return;

    document.querySelectorAll<HTMLElement>('[data-process]').forEach((root) => {
      const list = root.querySelector<HTMLElement>('[data-process-list]');
      const fill = root.querySelector<HTMLElement>('[data-process-fill]');
      if (!list || !fill) return;

      // vrh crvene linije uvijek je na 62 % visine ekrana; korak "upali" kad ga dosegne
      gsap.fromTo(
        fill,
        { scaleY: 0 },
        {
          scaleY: 1,
          ease: 'none',
          scrollTrigger: { trigger: list, start: 'top 62%', end: 'bottom 62%', scrub: 0.35 },
        },
      );

      list.querySelectorAll<HTMLElement>('[data-process-step]').forEach((step) => {
        ScrollTrigger.create({
          trigger: step,
          start: 'top 62%',
          onEnter: () => step.classList.add('is-on'),
          onLeaveBack: () => step.classList.remove('is-on'),
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>

---
/**
 * Hero (#vrh) — tamni, preko cijele širine.
 * Tekst (H1 = LCP, nikad skriven ni animiran; podnaslov, CTA blok, jamstva) lijevo / dolje,
 * iza njega 3D modeli krovova (./hero3d/RoofModels.astro: desno na desktopu, gore na mobitelu)
 * i scrim koji drži tekst čitljivim.
 *
 * Redoslijed u DOM-u: tekst (z-index 1) → RoofModels → scrim. Tabulator najprije dolazi do CTA,
 * H1 je prije statične slike modela, scrim leži preko modela i ispod teksta, a kontrole
 * modela (.rm-ctrl, z-index 3) ostaju iznad teksta i klikabilne.
 */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import RoofModels from './hero3d/RoofModels.astro';
import { site, telHref, waHref } from '@/data/site';
---

<section id="vrh" class="hx relative overflow-hidden bg-grafit grid-paper" aria-labelledby="vrh-naslov">
  <div class="wrap hx-in">
    <!-- tekst (data-hero-copy: RoofModels ga mjeri — model nikad ne ide preko njega) -->
    <div class="hx-copy flex flex-col" data-hero-copy>
      <h1 id="vrh-naslov" class="order-1">
        <span class="hx-kw eyebrow block text-celik">
          <span class="sr-only">Limarija Karamatić · </span><span class="hx-kw-seg">limeni krovovi, opšavi i oluci</span
          ><span class="hx-sep">&nbsp;· </span><span class="hx-kw-seg">{site.area}</span>
        </span>
        <span class="hx-display type-display mt-3 block text-white sm:mt-5 lg:mt-6">
          Sedam puta mjerimo.<br /> Jednom savijemo.
        </span>
      </h1>

      <p class="hx-sub order-5 mt-5 max-w-[34rem] text-[1.0625rem] leading-relaxed text-pretty text-celik sm:text-lg md:mt-6 lg:order-2">
        Limeni i falcani krovovi, popravci, opšavi atika i dimnjaka, oluci i snjegobrani&nbsp;— sve krojeno i
        savijeno po mjeri vašeg krova.
      </p>

      <!-- CTA blok: na mobitelu (contents) primarni ide odmah ispod naslova; od md jedan redak
           (na tabletu ispred podnaslova). Dva gumba: Besplatna procjena + WhatsApp;
           telefon je tihi tekstualni link ispod (poziv ostaje na jedan dodir, ali se ne gura).
           data-dock-anchor: mobilni dock se pojavi tek kad ovaj gumb izađe iz ekrana. -->
      <div class="hx-ctas contents md:order-2 md:mt-8 md:flex md:gap-3 lg:order-3">
        <Button
          href="#procjena"
          variant="primary"
          size="lg"
          iconRight="arrow-right"
          class="hx-cta-main order-2 mt-6 w-full md:order-none md:mt-0 md:w-auto"
          data-dock-anchor
        >
          Besplatna procjena
        </Button>
        <Button
          href={waHref()}
          variant="whatsapp"
          size="lg"
          icon="whatsapp"
          class="hx-cta-wa order-3 mt-3 w-full md:order-none md:mt-0 md:w-auto"
        >
          Pošaljite slike
        </Button>
        <a href={telHref} class="hx-tel order-4 md:order-none">
          <Icon name="phone" size={16} />
          <span>Ili nazovite <span class="type-mono text-white">{site.phoneDisplay}</span></span>
        </a>
      </div>

      <ul class="hx-trust order-6 mt-9 md:mt-10" aria-label="Što dobivate">
        <li>
          <span class="hx-trust-i" aria-hidden="true"><Icon name="ruler" size={18} /></span>
          <span class="hx-trust-l">Besplatna procjena na terenu</span>
        </li>
        <li>
          <span class="hx-trust-i" aria-hidden="true"><Icon name="file" size={18} /></span>
          <span class="hx-trust-l">Pisana ponuda stavku po stavku</span>
        </li>
        <li>
          <span class="hx-trust-i" aria-hidden="true"><Icon name="clock" size={18} /></span>
          <span class="hx-trust-l">{site.responseTime}</span>
        </li>
      </ul>
    </div>
  </div>
  <RoofModels align="right" />
  <div class="hx-scrim" aria-hidden="true"></div>
</section>

<style is:global>
  /* ── raspored ─────────────────────────────────────────────── */
  .hx {
    display: flex;
    min-height: calc(100svh - 56px);
  }
  @media (width >= 64rem) {
    .hx {
      min-height: max(36rem, calc(100svh - 101px));
    }
  }
  /* mobitel/tablet: tekst dolje, model iznad njega; od lg tekst lijevo, okomito centriran */
  .hx-in {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: max(14rem, 38svh);
    padding-bottom: 3rem;
  }
  /* niski mobiteli (npr. 360×640): glavni CTA (odmah ispod H1) ostaje iznad pregiba, a model ipak dobije mjesta */
  @media (width < 64rem) and (height < 720px) {
    .hx-in {
      padding-top: max(13rem, 34svh);
      padding-bottom: 2rem;
    }
  }
  @media (width >= 64rem) {
    .hx-in {
      justify-content: center;
      padding-top: 3rem;
      padding-bottom: 4.5rem;
    }
  }
  /* niski desktop (1280×720, 1366×768, 1024×768…): sve do jamstava stane u prvi ekran */
  @media (width >= 64rem) and (height < 57rem) {
    .hx-in {
      padding-top: 1.5rem;
      padding-bottom: 2.25rem;
    }
    .hx .hx-display {
      font-size: min(clamp(2.9rem, 4.95vw, 4.4rem), 7.4svh);
      margin-top: 1rem;
    }
    .hx .hx-sub {
      margin-top: 1rem;
    }
    .hx .hx-ctas {
      margin-top: 1.5rem;
    }
    .hx .hx-trust {
      margin-top: 1.5rem;
    }
  }
  .hx-copy {
    max-width: 40rem;
  }
  @media (width >= 64rem) {
    .hx-copy {
      max-width: min(38rem, 42vw);
    }
  }
  /* scrim: tekst uvijek čitljiv preko modela (mobitel: odozdo; desktop: slijeva) */
  .hx-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgb(14 16 19 / 0.94) 0%, rgb(14 16 19 / 0.86) 50%, rgb(14 16 19 / 0) 70%);
  }
  @media (width >= 64rem) {
    .hx-scrim {
      background: linear-gradient(to right, rgb(14 16 19 / 0.92) 0%, rgb(14 16 19 / 0.8) 30%, rgb(14 16 19 / 0) 54%);
    }
  }

  /* ── tipografija ───────────────────────────────────────────── */
  .hx-display {
    font-size: clamp(2.6rem, 10.6vw, 3.6rem);
    line-height: 0.94;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  @media (width >= 48rem) {
    .hx-display {
      font-size: clamp(3.6rem, 8.4vw, 5rem);
    }
  }
  /* lg+: stupac teksta je najviše min(38rem, 42vw), pa veličina staje na 4,4rem */
  @media (width >= 64rem) {
    .hx-display {
      font-size: clamp(2.9rem, 4.95vw, 4.4rem);
    }
  }
  .hx-kw {
    line-height: 1.55;
    text-wrap: balance;
  }
  .hx-kw-seg {
    white-space: nowrap;
  }
  /* mobitel i uski lg stupac: dva čista retka, bez točke koja visi na kraju retka */
  @media (width < 48rem), (width >= 64rem) and (width < 80rem) {
    .hx-kw-seg {
      display: block;
    }
    .hx-kw .hx-sep {
      display: none;
    }
  }
  @media (width < 24rem) {
    .hx-kw {
      letter-spacing: 0.05em;
    }
  }
  /* crvena samo za CTA, Λ, strehu i kote — separatori su neutralni */
  .hx-sep {
    color: var(--color-linija);
  }

  /* ── CTA blok ─────────────────────────────────────────────── */
  /* od md: dva gumba u retku (prelome se ako ne stanu), telefon ispod njih */
  @media (width >= 48rem) {
    .hx-ctas {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
    }
    .hx-ctas .hx-tel {
      flex-basis: 100%;
    }
  }
  /* telefon: tihi link (≥ 44 px za dodir), ne treći gumb */
  .hx-tel {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    margin-top: 0.25rem;
    font-size: 0.9375rem;
    color: var(--color-celik);
    text-underline-offset: 4px;
    transition: color 0.15s var(--ease-press);
  }
  .hx-tel:hover {
    color: #fff;
    text-decoration: underline;
  }
  @media (width >= 48rem) {
    .hx-tel {
      margin-top: 0;
      justify-self: start;
    }
  }

  /* ── jamstva: tri ćelije kao zaglavlje nacrta ──────────────── */
  .hx-trust {
    display: none;
  }
  /* jamstva tek od md — na mobitelu ih ponavljaju Kako radimo i završna forma */
  @media (width >= 48rem) {
    .hx-trust {
      display: grid;
    }
  }
  .hx-trust {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgb(213 219 223 / 0.14);
  }
  .hx-trust li {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 0.9rem 0.9rem 0 0;
  }
  .hx-trust li + li {
    border-left: 1px solid rgb(213 219 223 / 0.14);
    padding-left: 0.9rem;
  }
  .hx-trust-i {
    display: flex;
    align-items: center;
    height: 1.25rem;
    color: #fff;
  }
  .hx-trust-l {
    color: var(--color-linija);
    font-size: 0.8125rem;
    line-height: 1.4;
    text-wrap: pretty;
  }
  @media (width >= 40rem) {
    .hx-trust-l {
      font-size: 0.875rem;
    }
  }
</style>

---
/**
 * LIST 01 — tehnički crtež kuće iz loga. U HTML-u je u ZAVRŠNOM stanju
 * (gotov crtež: lim, opšavi, oluk, dimnjak, snjegobrani, kote, pečat); ./intro.ts ga
 * vrati na prazan list i odvrti nacrt → savijanje → polaganje → opšav → izvedeno.
 *
 * Skupine (hooks za JS):
 *  .hx-ink   linije crteža (DrawSVG), .hx-guide crtkane konstrukcijske linije
 *  .hx-dim   crvene kote (.hx-dl linije, .hx-num brojevi koji se odbrojavaju)
 *  .hx-fill  lim, opšavi, oluk, dimnjak, snjegobrani
 *  .hx-beam  greda abkanta s crvenim Λ
 *  .hx-fx    bljeskovi i odsjaj
 *  .hx-stamp pečat "IZVEDENO"
 */
import { drawing as d } from './geometry';
---

<svg
  class="hx-svg"
  viewBox={d.vb}
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
  focusable="false"
  data-hx-svg
>
  <defs>
    <linearGradient id="hx-metal" gradientUnits="userSpaceOnUse" x1={d.metal.x1} y1={d.metal.y1} x2={d.metal.x2} y2={d.metal.y2}>
      <stop offset="0" stop-color="#555d63" />
      <stop offset=".42" stop-color="#3b4246" />
      <stop offset="1" stop-color="#2a2f33" />
    </linearGradient>
    <linearGradient id="hx-shine" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0" />
      <stop offset=".5" stop-color="#fff" stop-opacity=".34" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <pattern id="hx-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <path d="M0 0V7" stroke="#d5dbdf" stroke-opacity=".22" stroke-width="1.2" />
    </pattern>
    <clipPath id="hx-roofclip"><path d={d.roofClip} /></clipPath>
  </defs>

  <!-- ravnalo uz rub lista -->
  <g class="hx-ruler">
    <path class="hx-guide" d={d.ruler} />
    {d.rulerLabels.map((l) => <text x={l.x} y={l.y} class="hx-tiny">{l.t}</text>)}
  </g>

  <!-- konstrukcijske linije -->
  <path class="hx-guide hx-dash" d={d.guides} />

  <!-- lim i dijelovi -->
  <g class="hx-fill">
    <path class="hx-chimfill" d={d.chimneyFill} />
    <path class="hx-wingroof" d={d.wingRoof} />
    <path class="hx-wingband" d={d.wingBand} />
    <path class="hx-wingseams" d={d.wingSeams} />
    <g class="hx-strips">
      {d.strips.map((s) => <path class="hx-strip" d={s} />)}
    </g>
    <g class="hx-seams">
      {d.seams.map((s) => <path class="hx-seam" d={s} />)}
    </g>
    <path class="hx-bar" d={d.band} data-flat={d.flat} data-band={d.band} data-gap={d.flatGap} />
    <path class="hx-eave" d={d.eaveRed} />
    <path class="hx-red2" d={d.wingRed} />
    <g class="hx-gutter">
      <path class="hx-gbody" d={d.gutterBody} />
      <path class="hx-gline" d={d.gutterLip + d.gutterEnd} />
    </g>
    <g class="hx-pipe">
      <path class="hx-gbody" d={d.pipe} />
      <path class="hx-gline" d={d.pipeClamps} />
    </g>
    <path class="hx-cap" d={d.cap} />
    <g class="hx-guards">
      {d.guards.map((g) => <path class="hx-guard" d={g} />)}
    </g>
  </g>

  <!-- crtež -->
  <g class="hx-ink">
    <path class="hx-l" d={d.roofOutline} />
    <path class="hx-l" d={d.wingOutline} />
    <path class="hx-l" d={d.walls} />
    <path class="hx-l hx-thin" d={d.wingWall} />
    <path class="hx-l" d={d.chimney} />
    <path class="hx-l hx-thin" d={d.chimneyCourses} />
    <path class="hx-l" d={d.window} />
    <path class="hx-l" d={d.ground} />
    <rect
      class="hx-hatch"
      x={d.groundHatch.x}
      y={d.groundHatch.y}
      width={d.groundHatch.w}
      height={d.groundHatch.h}
      fill="url(#hx-hatch)"
    />
  </g>

  <!-- kote -->
  <g class="hx-dim">
    <path class="hx-dl" d={d.dims.width} />
    <path class="hx-dl" d={d.dims.height} />
    <path class="hx-dl" d={d.dims.pitch} />
    <path class="hx-dl" d={d.dims.ral.d} />
    <circle class="hx-dot" cx={d.dims.ral.dot[0].toFixed(1)} cy={d.dims.ral.dot[1].toFixed(1)} r="3" />
    <text class="hx-dt" x={d.dims.widthLabel.x} y={d.dims.widthLabel.y} text-anchor="middle"
      ><tspan class="hx-num" data-to="12450">12 450</tspan></text
    >
    <text
      class="hx-dt"
      x={d.dims.heightLabel.x}
      y={d.dims.heightLabel.y}
      text-anchor="middle"
      transform={`rotate(-90 ${d.dims.heightLabel.x} ${d.dims.heightLabel.y})`}
      ><tspan class="hx-num" data-to="6080">6 080</tspan></text
    >
    <text class="hx-dt" x={d.dims.pitchLabel.x} y={d.dims.pitchLabel.y}
      ><tspan class="hx-num" data-to="35" data-suffix="°">35°</tspan></text
    >
    <text class="hx-dt" x={d.dims.ral.label.x} y={d.dims.ral.label.y}>RAL 7016</text>
  </g>

  <!-- efekti -->
  <g class="hx-fx">
    <path class="hx-flash" d={`M50 300L250 ${d.A[1]}L450 300`} />
    <g class="hx-seamflash">
      {d.seams.map((s) => <path class="hx-sf" d={s} />)}
    </g>
    <g clip-path="url(#hx-roofclip)">
      <path class="hx-glint" d="M-40 90H60L0 420H-100Z" fill="url(#hx-shine)" />
    </g>
  </g>

  <!-- greda abkanta -->
  <g class="hx-beam">
    <path class="hx-beam-ram" d={d.beam.ram} />
    <path class="hx-beam-body" d={d.beam.body} />
    <path class="hx-beam-hatch" d={d.beam.body} fill="url(#hx-hatch)" />
    <path class="hx-beam-lines" d={d.beam.lines} />
    <path class="hx-beam-lambda" d={d.beam.lambda} />
  </g>

  <!-- pečat -->
  <g class="hx-stamp" transform={`translate(${d.stamp.x} ${d.stamp.y}) rotate(${d.stamp.r})`}>
    <g class="hx-stamp-in">
      <rect x="-80" y="-23" width="160" height="46" />
      <rect x="-75" y="-18" width="150" height="36" class="hx-stamp-inner" />
      <text x="3" y="7.5" text-anchor="middle">IZVEDENO</text>
    </g>
  </g>
</svg>

---
/**
 * Crtaći list u heru: okvir, traka s fazom i "Ponovi", pozornica s crtežom i zaglavlje lista.
 * Samo crtež (bez fotografije). U HTML-u je ZAVRŠNO stanje: GOTOV CRTEŽ — položen lim,
 * crvena linija strehe, oluk, kapa dimnjaka, snjegobrani, kote i zaglavlje.
 * To je i stanje bez JS-a, s reduced-motion i pri ponovnom posjetu.
 */
import HeroDrawing from './HeroDrawing.astro';

const FINAL_PHASE = '05 · Gotov krov';
---

<figure class="hx-sheet" data-hx-sheet>
  <div class="hx-top">
    <p class="hx-readout hx-art" aria-hidden="true">
      <span class="hx-readout-k">Faza</span>
      <span data-hx-phase data-final={FINAL_PHASE}>{FINAL_PHASE}</span>
    </p>
    <button type="button" class="hx-replay" data-hx-replay hidden aria-label="Ponovi animaciju crteža">
      <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"
        ><path d="M13 8a5 5 0 1 1-1.6-3.7M13 2.5v3h-3" fill="none" stroke="currentColor" stroke-width="1.5"
        ></path></svg
      >
      <span>Ponovi</span>
    </button>
    <span class="hx-progress" aria-hidden="true"><span data-hx-progress></span></span>
  </div>

  <div class="hx-stage" data-hx-stage>
    <div class="hx-art hx-drawing">
      <HeroDrawing />
    </div>

    <div class="hx-tb hx-art" aria-hidden="true">
      <span class="hx-tb-name">Limarija Karamatić</span>
      <span>Krov · stojeći falc</span><span>Antracit</span>
      <span>List 01</span><span>M 1:50</span>
    </div>
  </div>
  <figcaption class="sr-only">
    Tehnički crtež kuće s limenim krovom u antracitu: opšav zabata, oluk, kapa dimnjaka i snjegobrani.
  </figcaption>
</figure>

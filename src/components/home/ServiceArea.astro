---
/**
 * Područje rada (id="podrucje", grafit).
 * "Pokrivamo Zagreb. Krov po krov." — shematska karta u stilu tehničkog crteža
 * (NIJE kartografska podloga): crveni Λ = centar Zagreba, Sava kao jedna linija,
 * isprekidani krugovi 10/20/30 km i mjesta iz site.ts `areas` na približnim položajima.
 * Provjera "Dolazimo li do vas?" radi s JS-om; bez JS-a ostaje popis "Sva mjesta".
 *
 * Koordinate crteža: viewBox 720 × 600, centar (340, 300), 8,5 jedinica = 1 km.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import Photo from '@/components/ui/Photo.astro';
import ExampleTag from '@/components/ui/ExampleTag.astro';
import { site, areas, telHref, projects } from '@/data/site';
import fallbackImg from '@/assets/projects/ravni-krov-trapez-medvednica.jpg';

interface Props {
  index?: string;
}
const { index = '08' } = Astro.props;

const W = 720;
const H = 600;
const CX = 340;
const CY = 300;
const KM = 8.5;

type Anchor = 'l' | 'r' | 't' | 'b';
/* a = položaj natpisa uz točku; am = drugačiji položaj na mobitelu; mHide = na mobitelu bez točke;
   short = kartografska kratica na uskim ekranima (< 400 px) */
/** Približni položaji (km od centra: x prema istoku, y prema sjeveru) — samo za crtež. */
const geo: Record<string, { km: [number, number]; a: Anchor; am?: Anchor; minor?: boolean; mHide?: boolean; short?: string }> = {
  'Novi Zagreb': { km: [0.3, -5], a: 'r', minor: true },
  Dubrava: { km: [6.4, 1.9], a: 'b', minor: true },
  Sesvete: { km: [10.7, 1.9], a: 't', am: 'b' },
  'Dugo Selo': { km: [20.4, -0.3], a: 'r' },
  'Velika Gorica': { km: [7.6, -11.1], a: 'r', short: 'V. Gorica' },
  Samobor: { km: [-20.7, -1.4], a: 'l' },
  'Sveta Nedelja': { km: [-15.4, -1.4], a: 'b', minor: true },
  Zaprešić: { km: [-13.2, 4.9], a: 'b', am: 'l' },
  Brdovec: { km: [-16.5, 5.9], a: 't', minor: true, mHide: true },
  Stupnik: { km: [-7.5, -7], a: 'l', minor: true },
  Jastrebarsko: { km: [-25.4, -15.9], a: 'r' },
  'Ivanić-Grad': { km: [32.6, -11.4], a: 'b' },
  Vrbovec: { km: [34.6, 7.4], a: 't' },
  'Sveti Ivan Zelina': { km: [20.4, 16.4], a: 't' },
};

const pct = (x: number, y: number) => `left:${((x / W) * 100).toFixed(2)}%;top:${((y / H) * 100).toFixed(2)}%`;
const towns = areas
  .filter((name) => name !== 'Zagreb' && geo[name])
  .map((name) => {
    const g = geo[name];
    const x = CX + g.km[0] * KM;
    const y = CY - g.km[1] * KM;
    return {
      name,
      a: g.a,
      am: g.am ?? g.a,
      short: g.short,
      minor: !!g.minor,
      mHide: !!g.mHide,
      style: pct(x, y),
      d: Math.hypot(g.km[0], g.km[1]).toFixed(1),
    };
  });
const rings = [10, 20, 30].map((km) => ({ km, r: km * KM }));

/** Sava: jedna tanka linija, približan tok od Brdovca prema jugoistoku. */
const sava =
  'M76.5 218.4C87.8 223.5 124.7 239.9 144.5 249C164.3 258.1 177.1 265.2 195.5 272.8C213.9 280.5 236.6 288.1 255 294.9C273.4 301.7 291.8 309.4 306 313.6C320.2 317.9 325.8 317 340 320.4C354.2 323.8 374 328.6 391 334C408 339.4 425 345.3 442 352.7C459 360.1 476 367.2 493 378.2C510 389.3 528.4 405.1 544 419C559.6 432.9 572.3 446.6 586.5 461.5C600.7 476.4 616.3 493.4 629 508.3C641.8 523.1 657.3 543.7 663 550.8';

const project = projects.find((p) => p.slug === 'ravni-krov-trapez-medvednica');
const photo = project?.image ?? fallbackImg;
const photoAlt = project?.alt ?? 'Ravni krov s trapeznim limom, u pozadini Medvednica i Sljeme';
const waBase = `https://wa.me/${site.whatsapp}?text=`;

/* Zagrebački kvartovi → odgovor "Da" (Zagreb je u popisu područja). */
const zagrebKvartovi = [
  'Centar', 'Donji grad', 'Gornji grad', 'Trnje', 'Maksimir', 'Peščenica', 'Žitnjak', 'Trešnjevka',
  'Črnomerec', 'Stenjevec', 'Podsused', 'Vrapče', 'Podsljeme', 'Brezovica', 'Špansko', 'Jarun',
  'Knežija', 'Rudeš', 'Ljubljanica', 'Remetinec', 'Siget', 'Travno', 'Utrina', 'Zapruđe', 'Sopot',
  'Dugave', 'Sloboština', 'Savski gaj', 'Trnsko', 'Lanište', 'Jakuševec', 'Botinec', 'Blato', 'Hrelić',
  'Gajnice', 'Kustošija', 'Malešnica', 'Prečko', 'Voltino', 'Ksaver', 'Šestine', 'Gračani',
  'Markuševec', 'Remete', 'Kozari bok', 'Borongaj', 'Volovčica', 'Retkovec', 'Ravnice', 'Kvatrić',
  'Svetice', 'Lučko', 'Jankomir', 'Gornja Dubrava', 'Donja Dubrava', 'Novi Zagreb – istok',
  'Novi Zagreb – zapad', 'Trešnjevka – sjever', 'Trešnjevka – jug', 'Podsused – Vrapče',
];
---

<section
  id="podrucje"
  class="bg-grafit py-20 text-linija sm:py-28 lg:py-32"
  data-service-area
  data-kvartovi={JSON.stringify(zagrebKvartovi)}
>
  <div class="wrap grid gap-y-12 lg:grid-cols-12 lg:gap-x-8 lg:gap-y-14">
    <!-- Zaglavlje -->
    <div class="lg:col-span-7 lg:row-start-1">
      <SectionHead index={index} eyebrow="Područje rada" title="Pokrivamo Zagreb.">
        <p class="type-display text-[2.125rem] text-celik sm:text-5xl lg:text-[clamp(2.625rem,4.1vw,3.75rem)]" data-reveal>Krov po krov.</p>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty text-celik" data-reveal>
          Od Samobora do Vrbovca, od Zaprešića do Velike Gorice. Na procjenu dolazimo besplatno — izmjerimo,
          fotografiramo i kažemo vam što krovu stvarno treba.
        </p>
      </SectionHead>
    </div>

    <!-- Karta -->
    <div class="lg:col-span-7 lg:row-start-2" data-reveal>
      <div class="sa-sheet relative border border-linija/12 bg-grafit-2">
        <div
          class="sa-map relative aspect-[6/5] w-full overflow-hidden"
          role="img"
          aria-label="Shematska karta područja rada: centar Zagreba, rijeka Sava, krugovi od 10, 20 i 30 km te okolna mjesta od Samobora i Jastrebarskog na zapadu do Vrbovca i Ivanić-Grada na istoku."
          data-sa-map
        >
          <svg viewBox={`0 0 ${W} ${H}`} class="absolute inset-0 h-full w-full" fill="none" aria-hidden="true">
            <defs>
              {
                rings.map((ring) => (
                  <mask id={`sa-mask-${ring.km}`} maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
                    <circle
                      cx={CX}
                      cy={CY}
                      r={ring.r}
                      stroke="#fff"
                      stroke-width="14"
                      transform={`rotate(-90 ${CX} ${CY})`}
                      data-anim
                      data-ring
                    />
                  </mask>
                ))
              }
            </defs>

            <!-- konstrukcijske osi -->
            <path class="sa-axis" d={`M${CX} 22V578M44 ${CY}H676`} />
            {
              rings.map((ring) => (
                <path
                  class="sa-axis"
                  d={`M${CX - 5} ${CY + ring.r}h10M${CX - 5} ${CY - ring.r}h10M${CX - ring.r} ${CY - 5}v10M${CX + ring.r} ${CY - 5}v10`}
                />
              ))
            }

            <!-- krugovi dosega -->
            {rings.map((ring) => <circle class="sa-ring" cx={CX} cy={CY} r={ring.r} mask={`url(#sa-mask-${ring.km})`} />)}

            <!-- Sava -->
            <path class="sa-river" d={sava} data-anim data-river />

            <!-- Sljeme -->
            <path class="sa-peak" d="M335.8 209.5l6 10.5h-12z" data-anim data-misc />

            <!-- sjever -->
            <g class="sa-north" data-anim data-misc>
              <path d="M684 96V44" />
              <path d="M678 58l6-14 6 14" />
            </g>
          </svg>

          <!-- Oznake (HTML, da ostanu čitljive na svakoj širini) -->
          <div class="absolute inset-0" aria-hidden="true">
            {
              rings.map((ring) => (
                <span class="sa-ringlabel" style={pct(CX, CY + ring.r)} data-anim data-misc>
                  {ring.km} km
                </span>
              ))
            }

            <div class="sa-legend" data-anim data-misc>
              <p class="sa-legend-title">Legenda</p>
              <ul>
                <li>
                  <svg viewBox="0 0 24 20" width="11" height="9" aria-hidden="true">
                    <path d="M0 20 12 0l12 20h-6.4L12 10.4 6.4 20Z" fill="#D7141A" />
                  </svg>
                  Centar Zagreba
                </li>
                <li><span class="sa-legend-dot"></span> Mjesto u području</li>
                <li><span class="sa-legend-dash"></span> 10 · 20 · 30 km od centra</li>
              </ul>
            </div>

            <span class="sa-tag sa-tag--river" style={pct(101, 207)} data-anim data-misc>Sava</span>
            <span class="sa-tag sa-tag--peak" style={pct(335.8, 207)} data-anim data-misc>Sljeme</span>
            <span class="sa-tag sa-tag--north" style={pct(684, 30)} data-anim data-misc>S</span>

            {
              towns.map((t) => (
                <span
                  class:list={['sa-town', t.minor && 'is-minor', t.mHide && 'is-mhide']}
                  style={t.style}
                  data-a={t.a}
                  data-am={t.am}
                  data-town={t.name}
                  data-d={t.d}
                  data-anim
                >
                  <span class="sa-dot" />
                  <span class="sa-label">
                    {t.short ? (
                      <>
                        <span class="sa-full">{t.name}</span>
                        <span class="sa-short">{t.short}</span>
                      </>
                    ) : (
                      t.name
                    )}
                  </span>
                </span>
              ))
            }

            <span class="sa-centre" style={pct(CX, CY)} data-town="Zagreb" data-anim data-centre>
              <svg viewBox="0 0 24 20" class="sa-lambda" aria-hidden="true">
                <path d="M0 20 12 0l12 20h-6.4L12 10.4 6.4 20Z" fill="#D7141A" />
              </svg>
              <span class="sa-centre-label">Zagreb</span>
            </span>
          </div>
        </div>

        <!-- Sastavnica crteža -->
        <div class="sa-block grid grid-cols-2 border-t border-linija/12 font-mono text-[0.625rem] tracking-[0.06em] text-celik uppercase sm:grid-cols-[1fr_auto_auto] sm:tracking-[0.12em]">
          <span class="col-span-2 px-3 py-3 sm:col-span-1 sm:px-4">Shema područja · položaji približni</span>
          <span class="border-t border-linija/12 px-3 py-3 whitespace-nowrap sm:border-t-0 sm:border-l sm:px-4">45°49′ N · 15°59′ E</span>
          <span class="border-t border-l border-linija/12 px-3 py-3 whitespace-nowrap sm:border-t-0 sm:px-4">R 10 · 20 · 30 km</span>
        </div>
      </div>
    </div>

    <!-- Provjera: dolazimo li do vas? -->
    <div class="lg:col-span-5 lg:col-start-8 lg:row-start-1 lg:self-start" data-reveal>
      <div class="border border-linija/12 bg-grafit-2 p-6 sm:p-8" data-sa-check>
        <div class="flex items-start justify-between gap-4">
          <h3 class="text-[1.375rem] leading-tight font-bold text-white [font-stretch:112%]">Dolazimo li do vas?</h3>
          <Icon name="map-pin" size={22} class="mt-0.5 shrink-0 text-celik" />
        </div>

        <div data-sa-tool hidden>
          <p class="mt-2 text-[0.9375rem] text-celik">Upišite mjesto ili kvart.</p>
          <form class="mt-5 flex gap-2" novalidate data-sa-form>
            <label for="sa-mjesto" class="sr-only">Mjesto ili kvart</label>
            <input
              id="sa-mjesto"
              name="mjesto"
              type="text"
              list="sa-mjesta"
              autocomplete="off"
              autocapitalize="words"
              spellcheck="false"
              enterkeyhint="go"
              placeholder="npr. Samobor"
              class="sa-input h-11 w-0 min-w-0 flex-1 border border-linija/25 bg-grafit px-4 text-base text-white placeholder:text-celik"
            />
            <Button type="submit" variant="outline" size="md">Provjerite</Button>
          </form>
          <datalist id="sa-mjesta">
            {areas.map((a) => <option value={a} />)}
          </datalist>

          <div class="sa-result" aria-live="polite" data-sa-result></div>

          <template data-sa-yes>
            <div class="flex items-start gap-3">
              <span class="mt-0.5 grid size-6 shrink-0 place-items-center bg-white text-tinta">
                <Icon name="check" size={16} />
              </span>
              <div class="min-w-0">
                <p class="font-semibold text-white">Da — <span data-place></span> je u našem području.</p>
                <div class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-1">
                  <a href="#procjena" class="sa-link group text-white">
                    Besplatna procjena
                    <Icon name="arrow-right" size={16} class="transition-transform duration-150 group-hover:translate-x-0.5" />
                  </a>
                  <a href={`${waBase}`} class="sa-link text-celik" target="_blank" rel="noopener" data-wa>
                    <Icon name="whatsapp" size={15} /> Pošaljite slike
                  </a>
                </div>
              </div>
            </div>
          </template>
          <template data-sa-no>
            <div class="flex items-start gap-3">
              <span class="mt-0.5 grid size-6 shrink-0 place-items-center border border-linija/40 text-linija">
                <Icon name="phone" size={14} />
              </span>
              <div class="min-w-0">
                <p class="font-semibold text-white">Javite se — dogovorit ćemo izlazak.</p>
                <a href={telHref} class="sa-link mt-2 font-mono text-white">{site.phoneDisplay}</a>
              </div>
            </div>
          </template>
        </div>

        <details class="sa-all mt-6 border-t border-linija/12">
          <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 pt-4 text-[0.9375rem] font-semibold text-white">
            <span>Sva mjesta <span class="font-mono text-xs font-normal tracking-[0.08em] text-celik">({areas.length})</span></span>
            <span class="sa-pm" aria-hidden="true"><span></span><span></span></span>
          </summary>
          <ul class="grid grid-cols-2 gap-x-6 pt-2 pb-1">
            {
              areas.map((a) => (
                <li class="flex items-center gap-2.5 border-b border-linija/8 py-2.5 text-[0.9375rem] text-linija">
                  <span class="size-1 shrink-0 bg-celik" aria-hidden="true" />
                  {a}
                </li>
              ))
            }
          </ul>
          <p class="mt-3 flex items-center gap-2 text-xs text-celik">
            <ExampleTag text="popis za potvrdu" class="shrink-0 whitespace-nowrap" /> I dalje od popisa — nazovite pa dogovorimo.
          </p>
        </details>
      </div>
    </div>

    <!-- Fotografija: pogled na Sljeme -->
    <figure class="relative aspect-[4/5] sm:aspect-[4/3] lg:col-span-5 lg:col-start-8 lg:row-start-2 lg:aspect-auto">
      <span class="sa-ticks" aria-hidden="true"></span>
      <div class="absolute inset-0">
        <div class="h-full overflow-hidden bg-grafit-3" data-scan>
          <Photo
            src={photo}
            alt={photoAlt}
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 88rem) 34rem, (min-width: 64rem) 38vw, calc(100vw - 2.5rem)"
            class="block h-full"
            imgClass="h-full w-full object-cover object-[60%_70%]"
          />
        </div>
      </div>
      <figcaption class="absolute bottom-0 left-0 max-w-[88%] border-t border-r border-linija/15 bg-grafit px-4 py-3.5 sm:px-5 sm:py-4">
        <span class="block text-[0.9375rem] leading-snug text-linija">Pogled na Sljeme s jednog od naših ravnih krovova</span>
        <span class="mt-1.5 block font-mono text-[0.625rem] tracking-[0.12em] text-celik uppercase">
          {project?.material ?? 'Trapez + opšav atike · RAL 7016'}
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  /* ── Karta ─────────────────────────────────────────── */
  /* Natpisi ne skaliraju s crtežom, pa se raspored prilagođava širini karte (container query) */
  .sa-map {
    container: sa-map / inline-size;
  }
  .sa-axis {
    stroke: rgb(213 219 223 / 0.1);
    stroke-width: 1;
  }
  .sa-ring {
    stroke: rgb(213 219 223 / 0.42);
    stroke-width: 1;
    stroke-dasharray: 3 6;
  }
  .sa-river {
    stroke: rgb(213 219 223 / 0.75);
    stroke-width: 1.25;
    stroke-linecap: round;
  }
  .sa-peak {
    stroke: var(--color-celik);
    stroke-width: 1.25;
    stroke-linejoin: miter;
  }
  .sa-north path {
    stroke: var(--color-celik);
    stroke-width: 1.25;
  }
  @container sa-map (width < 30rem) {
    .sa-axis {
      stroke-width: 1.8;
    }
    .sa-ring {
      stroke-width: 2;
      stroke-dasharray: 6 10;
    }
    .sa-river {
      stroke-width: 2.4;
    }
    .sa-peak,
    .sa-north path {
      stroke-width: 2.2;
    }
  }

  .sa-town,
  .sa-centre,
  .sa-ringlabel,
  .sa-tag {
    position: absolute;
  }
  .sa-town {
    width: 0;
    height: 0;
  }
  .sa-dot {
    position: absolute;
    left: -3px;
    top: -3px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-linija);
    box-shadow: 0 0 0 3px var(--color-grafit-2);
    transition:
      transform 180ms var(--ease-press),
      background-color 180ms var(--ease-press),
      box-shadow 180ms var(--ease-press);
  }
  .sa-label {
    position: absolute;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-linija);
    /* izrez: linije crteža prolaze ispod natpisa */
    padding: 2px 4px;
    background: var(--color-grafit-2);
    transition: color 180ms var(--ease-press);
  }
  .sa-town[data-a='r'] .sa-label {
    left: 5px;
    right: auto;
    top: 0;
    bottom: auto;
    transform: translateY(-50%);
  }
  .sa-town[data-a='l'] .sa-label {
    left: auto;
    right: 5px;
    top: 0;
    bottom: auto;
    transform: translateY(-50%);
  }
  .sa-town[data-a='t'] .sa-label {
    left: 0;
    right: auto;
    top: auto;
    bottom: 6px;
    transform: translateX(-50%);
  }
  .sa-town[data-a='b'] .sa-label {
    left: 0;
    right: auto;
    top: 6px;
    bottom: auto;
    transform: translateX(-50%);
  }
  @container sa-map (width < 46rem) {
    .sa-town[data-am='r'] .sa-label {
      left: 5px;
      right: auto;
      top: 0;
      bottom: auto;
      transform: translateY(-50%);
    }
    .sa-town[data-am='l'] .sa-label {
      left: auto;
      right: 5px;
      top: 0;
      bottom: auto;
      transform: translateY(-50%);
    }
    .sa-town[data-am='t'] .sa-label {
      left: 0;
      right: auto;
      top: auto;
      bottom: 6px;
      transform: translateX(-50%);
    }
    .sa-town[data-am='b'] .sa-label {
      left: 0;
      right: auto;
      top: 6px;
      bottom: auto;
      transform: translateX(-50%);
    }
    .sa-town.is-mhide:not(.is-hit) {
      display: none;
    }
  }
  .sa-town.is-minor .sa-dot {
    left: -2.5px;
    top: -2.5px;
    width: 5px;
    height: 5px;
    background: var(--color-celik);
  }
  .sa-town.is-minor .sa-label {
    color: var(--color-celik);
    font-weight: 400;
    font-size: 0.625rem;
  }
  @container sa-map (width < 46rem) {
    .sa-town.is-minor .sa-label {
      display: none;
    }
  }
  @container sa-map (width < 30rem) {
    .sa-label {
      font-size: 0.625rem;
      letter-spacing: 0.04em;
    }
  }

  .sa-short {
    display: none;
  }
  @container sa-map (width < 21.5rem) {
    .sa-full {
      display: none;
    }
    .sa-short {
      display: inline;
    }
  }

  /* pogodak iz provjere */
  .sa-town.is-hit .sa-dot {
    background: #fff;
    transform: scale(1.7);
    box-shadow:
      0 0 0 2px var(--color-grafit-2),
      0 0 0 3px rgb(255 255 255 / 0.7);
  }
  .sa-town.is-hit .sa-label {
    display: block;
    color: #fff;
  }

  .sa-centre {
    width: 0;
    height: 0;
  }
  /* pogodak za Zagreb / kvart: tanki prsten oko Λ */
  .sa-centre::after {
    content: '';
    position: absolute;
    left: -21px;
    top: -27px;
    width: 42px;
    height: 42px;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.8);
    transition:
      opacity 180ms var(--ease-press),
      transform 180ms var(--ease-press);
  }
  .sa-centre.is-hit::after {
    opacity: 1;
    transform: scale(1);
  }
  .sa-lambda {
    position: absolute;
    max-width: none;
    width: 22px;
    height: auto;
    left: -11px;
    top: -14px;
  }
  .sa-centre-label {
    position: absolute;
    left: 0;
    bottom: 17px;
    transform: translateX(-50%);
    padding: 2px 6px 1px;
    background: var(--color-grafit-2);
    line-height: 1.1;
    font-family: var(--font-sans);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(0.75rem, 2.1cqw, 1rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    white-space: nowrap;
  }
  @media (width >= 40rem) {
    .sa-lambda {
      width: 28px;
      left: -14px;
      top: -18px;
    }
    .sa-centre-label {
      bottom: 21px;
    }
  }

  .sa-ringlabel {
    transform: translate(-50%, -50%);
    padding: 2px 5px;
    background: var(--color-grafit-2);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.1em;
    color: var(--color-celik);
    white-space: nowrap;
  }
  .sa-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-celik);
    white-space: nowrap;
  }
  .sa-tag--river {
    transform: translate(-50%, -50%) rotate(24deg);
  }
  .sa-tag--peak {
    transform: translate(-50%, -100%);
    letter-spacing: 0.1em;
  }
  .sa-tag--north {
    transform: translate(-50%, -50%);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-linija);
  }

  .sa-legend {
    position: absolute;
    left: 0;
    top: 0;
    padding: 1.125rem 0.875rem 0.75rem 1.25rem;
    background: var(--color-grafit-2);
    display: none;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-celik);
  }
  @media (width >= 40rem) {
    .sa-legend {
      display: block;
    }
  }
  .sa-legend-title {
    margin-bottom: 0.75rem;
    color: var(--color-linija);
    letter-spacing: 0.16em;
  }
  .sa-legend ul {
    display: grid;
    gap: 0.5rem;
  }
  .sa-legend li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .sa-legend li > :first-child {
    flex: 0 0 auto;
  }
  .sa-legend svg {
    width: 11px;
    margin-inline: 2px;
  }
  .sa-legend-dot {
    width: 5px;
    height: 5px;
    margin-inline: 5px;
    border-radius: 50%;
    background: var(--color-linija);
  }
  .sa-legend-dash {
    width: 15px;
    height: 0;
    border-top: 1px dashed rgb(213 219 223 / 0.6);
  }

  /* skriveno samo dok animacija čeka (HTML je u završnom stanju) */
  :global(.motion) [data-sa-map] [data-anim] {
    opacity: 0;
  }

  /* ── Provjera ──────────────────────────────────────── */
  .sa-input {
    border-radius: 0;
    transition: border-color 150ms var(--ease-press);
  }
  .sa-input:hover {
    border-color: rgb(213 219 223 / 0.45);
  }
  .sa-input:focus {
    border-color: var(--color-linija);
  }
  .sa-input:focus-visible {
    outline-offset: 2px;
  }
  .sa-input::-webkit-calendar-picker-indicator {
    display: none !important;
  }
  .sa-result:not(:empty) {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(213 219 223 / 0.12);
  }
  .sa-result :global(.sa-link),
  .sa-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(213 219 223 / 0.3);
    text-underline-offset: 0.35em;
    transition: text-decoration-color 150ms var(--ease-press);
  }
  .sa-result :global(.sa-link:hover),
  .sa-link:hover {
    text-decoration-color: currentColor;
  }

  .sa-all summary::-webkit-details-marker {
    display: none;
  }
  .sa-pm {
    position: relative;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }
  .sa-pm span {
    position: absolute;
    left: 0;
    top: 5.5px;
    width: 12px;
    height: 1.5px;
    background: currentColor;
    transition: transform 200ms var(--ease-press);
  }
  .sa-pm span:last-child {
    transform: rotate(90deg);
  }
  .sa-all[open] .sa-pm span:last-child {
    transform: rotate(0deg);
  }

  /* kutne oznake oko fotografije */
  .sa-ticks {
    position: absolute;
    inset: -0.625rem;
    pointer-events: none;
    --t: 0.875rem;
    --c: rgb(213 219 223 / 0.35);
    background:
      linear-gradient(var(--c), var(--c)) 0 0 / var(--t) 1px,
      linear-gradient(var(--c), var(--c)) 0 0 / 1px var(--t),
      linear-gradient(var(--c), var(--c)) 100% 0 / var(--t) 1px,
      linear-gradient(var(--c), var(--c)) 100% 0 / 1px var(--t),
      linear-gradient(var(--c), var(--c)) 0 100% / var(--t) 1px,
      linear-gradient(var(--c), var(--c)) 0 100% / 1px var(--t),
      linear-gradient(var(--c), var(--c)) 100% 100% / var(--t) 1px,
      linear-gradient(var(--c), var(--c)) 100% 100% / 1px var(--t);
    background-repeat: no-repeat;
  }
</style>

<script>
  import { gsap, ScrollTrigger, motionOn } from '@/lib/motion';

  /* ── Animacija karte: Λ se utisne, krugovi se nacrtaju od centra prema van ── */
  function animateMap(map: HTMLElement) {
    if (!motionOn()) return;
    const centre = map.querySelector<HTMLElement>('[data-centre]');
    const ringEls = Array.from(map.querySelectorAll<SVGElement>('[data-ring]'));
    const river = map.querySelector<SVGElement>('[data-river]');
    const misc = Array.from(map.querySelectorAll<Element>('[data-misc]'));
    const towns = Array.from(map.querySelectorAll<HTMLElement>('.sa-town[data-d]')).sort(
      (a, b) => parseFloat(a.dataset.d ?? '0') - parseFloat(b.dataset.d ?? '0'),
    );
    const draws = river ? [...ringEls, river] : ringEls;
    gsap.set(draws, { opacity: 1, drawSVG: '0%' });

    const tl = gsap.timeline({ paused: true });
    if (centre) tl.fromTo(centre, { opacity: 0, y: -8 }, { opacity: 1, y: 0, duration: 0.24, ease: 'press' }, 0);
    tl.to(ringEls, { drawSVG: '100%', duration: 0.9, ease: 'draft', stagger: 0.14 }, 0.12);
    if (river) tl.to(river, { drawSVG: '100%', duration: 0.9, ease: 'draft' }, 0.32);
    tl.to(towns, { opacity: 1, duration: 0.3, ease: 'draft', stagger: 0.035 }, 0.45);
    tl.to(misc, { opacity: 1, duration: 0.4, ease: 'draft', stagger: 0.04 }, 0.8);

    ScrollTrigger.create({ trigger: map, start: 'top 80%', once: true, onEnter: () => tl.play() });
  }

  /* ── Provjera područja ── */
  const norm = (s: string) =>
    s
      .toLowerCase()
      .replace(/đ/g, 'd')
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      // "Sv. Nedelja" = "Sveta Nedelja", "sv Ivan Zelina" = "Sveti Ivan Zelina": sve svodi na "sv "
      .replace(/\bsv(?:et[iao])?(?:\.\s*|\s+)/g, 'sv ')
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();

  function initCheck(section: HTMLElement) {
    const tool = section.querySelector<HTMLElement>('[data-sa-tool]');
    const form = section.querySelector<HTMLFormElement>('[data-sa-form]');
    const input = form?.querySelector<HTMLInputElement>('input');
    const out = section.querySelector<HTMLElement>('[data-sa-result]');
    const yes = section.querySelector<HTMLTemplateElement>('template[data-sa-yes]');
    const no = section.querySelector<HTMLTemplateElement>('template[data-sa-no]');
    if (!tool || !form || !input || !out || !yes || !no) return;
    tool.hidden = false;

    const areas = Array.from(section.querySelectorAll<HTMLOptionElement>('#sa-mjesta option')).map((o) => o.value);
    const kvartovi: string[] = JSON.parse(section.dataset.kvartovi ?? '[]');
    const areaIdx = areas.map((a) => ({ name: a, n: norm(a) }));
    const kvartIdx = kvartovi.map((k) => ({ name: k.split(' – ')[0], n: norm(k) }));
    const mapTowns = Array.from(section.querySelectorAll<HTMLElement>('[data-sa-map] [data-town]'));

    const find = (raw: string): { place: string; town: string } | null => {
      const q = norm(raw);
      if (q.length < 2) return null;
      const exact = areaIdx.find((a) => a.n === q);
      if (exact) return { place: exact.name, town: exact.name };
      const kv = kvartIdx.find((k) => k.n === q);
      if (kv) return { place: kv.name, town: 'Zagreb' };
      if (q.length >= 3) {
        const pre = areaIdx.filter((a) => a.n.startsWith(q));
        if (pre.length === 1) return { place: pre[0].name, town: pre[0].name };
        const kpre = kvartIdx.filter((k) => k.n.startsWith(q));
        if (pre.length === 0 && kpre.length === 1) return { place: kpre[0].name, town: 'Zagreb' };
      }
      // "Sesvete, Kraljevec", "Samobor centar"…
      const within = [...areaIdx]
        .sort((a, b) => b.n.length - a.n.length)
        .find((a) => new RegExp(`(^| )${a.n}( |$)`).test(q));
      if (within) return { place: within.name, town: within.name };
      return null;
    };

    const show = (raw: string) => {
      const hit = find(raw);
      mapTowns.forEach((t) => t.classList.toggle('is-hit', !!hit && t.dataset.town === hit.town));
      out.replaceChildren();
      if (hit) {
        const node = yes.content.cloneNode(true) as DocumentFragment;
        const place = node.querySelector('[data-place]');
        if (place) place.textContent = hit.place;
        const wa = node.querySelector<HTMLAnchorElement>('[data-wa]');
        if (wa) wa.href += encodeURIComponent(`Pozdrav, trebam procjenu krova. Lokacija: ${hit.place}.`);
        out.append(node);
      } else {
        out.append(no.content.cloneNode(true));
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!input.value.trim()) {
        input.focus();
        return;
      }
      show(input.value);
    });
    // odabir iz padajućeg popisa (datalist) odmah daje odgovor
    input.addEventListener('input', (e) => {
      const ie = e as InputEvent;
      if (ie.inputType === 'insertReplacementText' || ie.inputType === undefined) {
        if (areas.includes(input.value)) show(input.value);
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-service-area]').forEach((section) => {
    initCheck(section);
    const map = section.querySelector<HTMLElement>('[data-sa-map]');
    if (map) animateMap(map);
  });
</script>

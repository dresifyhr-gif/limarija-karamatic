---
/**
 * Česta pitanja — višekratna sekcija (naslovnica: 5 pitanja preko `items`; podstranice: 3–5).
 * Ugovor: items?: {q,a}[]; tone?: 'light' | 'paper' | 'dark' | 'dark2' (default light); id? (default 'pitanja');
 *         title?; index? (zadržano radi kompatibilnosti); compact?: boolean (default: items ≤ 4);
 *         ask?: boolean (default true) — blok "Niste našli odgovor?"; false kad slijedi FinalCta.
 *
 *  Sve varijante su SVIJETLE (tamno je samo zaglavlje, hero, footer i mobilni dock):
 *   light  bijela (default — sekcija najčešće stoji iznad završne forme na papiru)
 *   paper  papir
 *   dark   stari naziv → papir (zadržano da postojeći pozivi ne puknu)
 *   dark2  stari naziv → papir-2
 *  compact  manje vertikalnog prostora i manji h2 — za kratke popise na podstranicama.
 *  Raspored je isti u oba slučaja: desktop naslov + "Niste našli odgovor?" lijevo (sticky), pitanja desno;
 *  mobitel naslov → pitanja → "Niste našli odgovor?".
 *
 * Harmonika na <details>/<summary>: bez JS-a radi nativno. S pokretom JS animira
 * visinu (≈220 ms, "draft", bez odskoka) i drži otvorenim jedno pitanje.
 * FAQPage schema se dodaje na razini stranice (vidi index.astro).
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import Icon from '@/components/ui/Icon.astro';
import { faq as defaultFaq, site, telHref, waHref } from '@/data/site';

interface Props {
  items?: { q: string; a: string }[];
  tone?: 'light' | 'paper' | 'dark' | 'dark2';
  id?: string;
  title?: string;
  index?: string;
  compact?: boolean;
  /** blok "Niste našli odgovor?" (telefon + WhatsApp). false kad odmah ispod slijedi završna forma
   *  (FinalCta već nudi telefon i WhatsApp) — default true */
  ask?: boolean;
}
const { items = defaultFaq, tone = 'light', id = 'pitanja', title = 'Pitanja koja čujemo na svakom krovu.', ask = true } = Astro.props;
const compact = Astro.props.compact ?? items.length <= 4;

const bg = tone === 'paper' || tone === 'dark' ? 'bg-papir' : tone === 'dark2' ? 'bg-papir-2' : 'bg-white';
const waAsk = waHref('Pozdrav, imam pitanje o krovu: ');

const sectionCls = ['faq text-tinta', bg, compact ? 'faq--compact py-20 sm:py-24 lg:py-28' : 'py-24 sm:py-28 lg:py-32'];
---

<section id={id} class:list={sectionCls} data-faq>
  <div class="wrap grid gap-y-10 sm:gap-y-12 lg:grid-cols-12 lg:gap-x-8">
    <!-- mobitel: naslov → pitanja → pitajte majstora; desktop: naslov + pitajte majstora lijevo (sticky), pitanja desno -->
    <div class="contents lg:col-span-5 lg:block">
      <div class="contents lg:sticky lg:top-28 lg:block">
        <SectionHead class="faq-head order-1 lg:pr-6" tone="light" eyebrow="Česta pitanja" title={title} />

        {ask && (<aside class:list={['order-3', compact ? 'lg:mt-10' : 'lg:mt-14']} aria-labelledby={`${id}-ask`} data-reveal>
          <h3 id={`${id}-ask`} class="text-[1.125rem] font-semibold">
            Niste našli odgovor?
          </h3>
          <p class="mt-1 text-[1rem] text-tinta/70">Pitajte majstora — telefonom ili porukom.</p>
          <div class="mt-4 flex flex-col items-start gap-y-1">
            <a href={telHref} class="faq-link group font-mono text-[1.25rem] tracking-[0.01em]" aria-label={`Nazovite ${site.phoneDisplay}`}>
              <Icon name="phone" size={19} class="text-tinta/60" />
              <span class="faq-u">{site.phoneDisplay}</span>
            </a>
            <a href={waAsk} class="faq-link group font-semibold" target="_blank" rel="noopener">
              <Icon name="whatsapp" size={20} class="faq-wa" />
              <span class="faq-u">Pitajte na WhatsAppu</span>
            </a>
          </div>
        </aside>)}
      </div>
    </div>

    <div class="order-2 lg:col-span-7">
      <div class="faq-list border-t border-tinta/12" data-faq-list data-reveal-group>
        {
          items.map((item, i) => (
            <details class="faq-item border-b border-tinta/12" open={i === 0} data-reveal>
              <summary class="faq-q">
                <span class="faq-qtext">{item.q}</span>
                <span class="faq-pm" aria-hidden="true">
                  <span />
                  <span />
                </span>
              </summary>
              <div class="faq-panel">
                <p class="faq-a">{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq {
    --q: var(--color-tinta);
    --a: rgb(21 24 27 / 0.74);
    --box: rgb(21 24 27 / 0.22);
    --box-hover: var(--color-tinta);
  }

  /* kompaktno: manji naslov, da tri-četiri pitanja ne stoje ispod golemog naslova */
  .faq--compact :global(.faq-head h2) {
    font-size: 2.125rem;
  }
  @media (width >= 40rem) {
    .faq--compact :global(.faq-head h2) {
      font-size: 2.625rem;
    }
  }

  /* dva stupca: naslov u užem stupcu malo manji, da ne stoji u četiri reda */
  @media (width >= 64rem) {
    .faq:not(.faq--compact) :global(.faq-head h2) {
      font-size: clamp(2.5rem, 3.3vw, 3.125rem);
    }
  }

  .faq-q {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0 1.25rem;
    min-height: 4.75rem;
    padding-block: 1.375rem;
    list-style: none;
    cursor: pointer;
    color: var(--q);
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-q:focus-visible {
    outline-offset: -2px;
  }
  @media (hover: hover) {
    .faq-q:hover .faq-pm {
      border-color: var(--box-hover);
    }
  }
  @media (width >= 40rem) {
    .faq-q {
      gap: 0 2rem;
      padding-block: 1.75rem;
    }
  }
  .faq-qtext {
    font-size: 1.0625rem;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }
  @media (width >= 40rem) {
    .faq-qtext {
      font-size: 1.25rem;
      font-stretch: 106%;
    }
  }

  /* plus → minus: okomita crta se zakrene u vodoravnu */
  .faq-pm {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--box);
    transition: border-color 150ms var(--ease-press);
  }
  @media (width >= 40rem) {
    .faq-pm {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
  .faq-pm span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.875rem;
    height: 1.5px;
    margin: -0.75px 0 0 -0.4375rem;
    background: var(--q);
    transition: transform 200ms var(--ease-press);
  }
  .faq-pm span:last-child {
    transform: rotate(90deg);
  }
  .faq-item[open]:not([data-state='closing']) .faq-pm span:last-child {
    transform: rotate(0deg);
  }
  .faq-item[open]:not([data-state='closing']) .faq-pm {
    border-color: var(--box-hover);
  }

  .faq-panel {
    overflow: hidden;
  }
  .faq-a {
    max-width: 40rem;
    padding: 0 3.5rem 1.875rem 0;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--a);
    text-wrap: pretty;
  }
  @media (width >= 40rem) {
    .faq-a {
      padding: 0 4.5rem 2.25rem 0;
      font-size: 1.0625rem;
    }
  }

  /* pitajte majstora: tihi linkovi (≥ 44 px za dodir) */
  .faq-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    color: var(--color-tinta);
  }
  .faq-u {
    text-decoration: underline;
    text-decoration-color: rgb(21 24 27 / 0.2);
    text-underline-offset: 0.3em;
    transition: text-decoration-color 150ms var(--ease-press);
  }
  .faq-link:hover .faq-u {
    text-decoration-color: currentColor;
  }
  /* WhatsApp zelena samo na znaku (tekst ostaje tinta zbog kontrasta) */
  .faq-wa {
    color: #1da851;
  }
</style>

<script>
  import { gsap, motionOn } from '@/lib/motion';

  const DUR = 0.22;

  function initFaq(root: HTMLElement) {
    const items = Array.from(root.querySelectorAll<HTMLDetailsElement>('details.faq-item'));
    if (!items.length) return;

    const panelOf = (d: HTMLDetailsElement) => d.querySelector<HTMLElement>('.faq-panel');

    const close = (d: HTMLDetailsElement, animate: boolean) => {
      const panel = panelOf(d);
      if (!d.open || !panel) return;
      if (!animate) {
        d.open = false;
        return;
      }
      d.dataset.state = 'closing';
      gsap.killTweensOf(panel);
      gsap.fromTo(
        panel,
        { height: panel.offsetHeight },
        {
          height: 0,
          duration: DUR,
          ease: 'draft',
          onComplete: () => {
            d.open = false;
            d.removeAttribute('data-state');
            gsap.set(panel, { clearProps: 'height' });
          },
        },
      );
    };

    const open = (d: HTMLDetailsElement, animate: boolean) => {
      const panel = panelOf(d);
      if (!panel) return;
      const wasClosing = d.dataset.state === 'closing';
      const from = d.open ? panel.offsetHeight : 0;
      d.removeAttribute('data-state');
      if (!animate) {
        d.open = true;
        return;
      }
      gsap.killTweensOf(panel);
      d.open = true;
      gsap.fromTo(
        panel,
        { height: from },
        { height: 'auto', duration: wasClosing ? DUR * 0.75 : DUR, ease: 'draft', clearProps: 'height' },
      );
    };

    items.forEach((d) => {
      const summary = d.querySelector('summary');
      summary?.addEventListener('click', (e) => {
        e.preventDefault();
        const animate = motionOn();
        const isOpen = d.open && d.dataset.state !== 'closing';
        if (isOpen) {
          close(d, animate);
        } else {
          items.forEach((o) => o !== d && close(o, animate));
          open(d, animate);
        }
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    initFaq(root);
  });
</script>

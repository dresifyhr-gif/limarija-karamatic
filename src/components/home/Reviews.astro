---
/**
 * Recenzije (id="recenzije", bijela) — zaglavlje + četiri brojke kao lančana kota + (kad postoje) recenzije.
 *
 *  Brojke (`stats` iz admina, getContent) crta zajednička `ui/StatLine.astro` (kota, odbrojavanje, crtanje linije).
 *  Bez recenzija i bez Google poveznice zaglavlje glasi "U brojkama · Brojke iza svakog krova."
 *
 *  Recenzije dolaze iz admina (samo objavljene, getContent). Dok ih nema, sekcija prikazuje samo brojke
 *  i ocjenu (bez kartica, bez niza, bez izmišljenih imena). Čim vlasnik objavi stvarne recenzije, kartice
 *  i vodoravni niz (native scroll-snap, bez autoplaya) pojave se sami (nakon "Objavi na stranicu").
 *  Link "Sve recenzije na Googleu" prikazuje se samo kad je `site.googleReviewsUrl` upisan.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import Icon from '@/components/ui/Icon.astro';
import StatLine from '@/components/ui/StatLine.astro';
import { getContent, type ContentReview } from '@/lib/content';

const { contact: site, reviews: allReviews } = await getContent();

interface Props {
  /** zadržano radi kompatibilnosti; brojevi sekcija se više ne prikazuju */
  index?: string;
  /** recenzije za prikaz (default: sve objavljene iz admina) */
  items?: ContentReview[];
}
const { items = allReviews } = Astro.props;
const list = items.filter((r) => r && r.text);
const hasReviews = list.length > 0;

const reviewsHref = site.googleReviewsUrl as string;
const reviewsExternal = reviewsHref.startsWith('http');
const total = String(list.length).padStart(2, '0');

// Bez recenzija (i bez poveznice na Google) zaglavlje ne obećava citate — govori o brojkama.
const voices = hasReviews || reviewsExternal;
const head = voices
  ? { eyebrow: 'Recenzije', title: 'Pitajte one kojima više ne curi.' }
  : { eyebrow: 'U brojkama', title: 'Brojke iza svakog krova.' };
---

<section id="recenzije" class="bg-white py-24 text-tinta sm:py-28 lg:py-32">
  <div class="wrap">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
      <SectionHead tone="light" eyebrow={head.eyebrow} title={head.title} />
      {
        reviewsExternal && (
          <a
            href={reviewsHref}
            class="group inline-flex min-h-11 flex-none items-center gap-2 self-start text-[0.9375rem] font-semibold lg:self-auto"
            target="_blank"
            rel="noopener"
            data-reveal
          >
            <Icon name="google" size={16} class="text-tinta/70" />
            <span class="underline decoration-tinta/25 underline-offset-[0.35em] transition-colors duration-150 group-hover:decoration-tinta">
              Sve recenzije na Googleu
            </span>
            <Icon name="arrow-up-right" size={18} class="transition-transform duration-150 ease-[var(--ease-press)] group-hover:translate-x-0.5" />
          </a>
        )
      }
    </div>

    <!-- brojke: lančana kota (zajednička komponenta) -->
    <StatLine class="mt-14 sm:mt-16 lg:mt-20" />
  </div>

  {
    hasReviews && (
      <div class="rv mt-16 sm:mt-20" data-reviews>
        <ul
          id="recenzije-niz"
          class="rv-rail grid snap-x snap-mandatory grid-flow-col gap-4 overflow-x-auto overflow-y-hidden overscroll-x-contain sm:gap-6"
          tabindex="0"
          aria-label="Recenzije klijenata"
          data-reveal-group
        >
          {list.map((r) => (
            <li class="snap-start" data-reveal>
              <article class="flex h-full flex-col bg-papir p-7 sm:p-9">
                <div class="flex gap-0.5" role="img" aria-label={`${r.stars} od 5 zvjezdica`}>
                  {Array.from({ length: 5 }, (_, i) => (
                    <Icon name="star" size={15} class={i < r.stars ? '' : 'opacity-25'} />
                  ))}
                </div>
                <blockquote class="mt-6 flex-1 text-[1.0625rem] leading-[1.6] text-pretty sm:text-lg">
                  <p>„{r.text}“</p>
                </blockquote>
                <footer class="mt-8">
                  <p class="font-semibold">{r.name}</p>
                  {(r.place || r.source) && (
                    <p class="mt-0.5 text-[0.9375rem] text-tinta/70">{[r.place, r.source].filter(Boolean).join(" · ")}</p>
                  )}
                </footer>
              </article>
            </li>
          ))}
        </ul>

        <!-- kontrole: tek s JS-om i samo kad niz stvarno ima više od jednog ekrana -->
        <div class="wrap mt-8 flex items-center gap-5 sm:gap-6" data-rv-controls hidden>
          <p class="type-mono shrink-0 text-[0.75rem] tracking-[0.08em] text-tinta/70 tabular-nums" aria-hidden="true">
            <span class="text-tinta" data-rv-pos>
              01
            </span>
            <span class="mx-1.5">/</span>
            {total}
          </p>
          <div class="relative h-px flex-1 bg-tinta/15" aria-hidden="true">
            <span class="rv-thumb absolute inset-y-0 left-0 bg-tinta" data-rv-thumb />
          </div>
          <div class="hidden items-center gap-2 md:flex">
            <button
              type="button"
              class="rv-btn"
              aria-label="Prethodne recenzije"
              aria-controls="recenzije-niz"
              aria-disabled="true"
              data-rv-prev
            >
              <Icon name="arrow-right" size={18} class="rotate-180" />
            </button>
            <button type="button" class="rv-btn" aria-label="Sljedeće recenzije" aria-controls="recenzije-niz" data-rv-next>
              <Icon name="arrow-right" size={18} />
            </button>
          </div>
        </div>
      </div>
    )
  }
</section>

<style>
  /* ── niz recenzija (samo kad postoje) ── */
  .rv {
    --pad: 1.25rem;
  }
  @media (width >= 48rem) {
    .rv {
      --pad: 2rem;
    }
  }
  @media (width >= 80rem) {
    .rv {
      --pad: 3rem;
    }
  }
  .rv-rail {
    --edge: max(var(--pad), calc((100% - 88rem) / 2 + var(--pad)));
    padding-inline: var(--edge);
    scroll-padding-inline: var(--edge);
    grid-auto-columns: 86%;
    scrollbar-width: none;
    padding-block: 2px;
  }
  .rv-rail::-webkit-scrollbar {
    display: none;
  }
  .rv-rail:focus-visible {
    outline-offset: -2px;
  }
  @media (width >= 40rem) {
    .rv-rail {
      grid-auto-columns: 62%;
    }
  }
  @media (width >= 48rem) {
    .rv-rail {
      grid-auto-columns: calc((100% - 1.5rem) / 2);
    }
  }
  @media (width >= 64rem) {
    .rv-rail {
      grid-auto-columns: calc((100% - 3rem) / 3);
    }
  }
  .rv-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(21 24 27 / 0.25);
    color: var(--color-tinta);
    transition:
      background-color 150ms var(--ease-press),
      border-color 150ms var(--ease-press),
      color 150ms var(--ease-press),
      opacity 150ms var(--ease-press);
  }
  .rv-btn:hover:not([aria-disabled='true']) {
    background: var(--color-tinta);
    border-color: var(--color-tinta);
    color: var(--color-papir);
  }
  .rv-btn[aria-disabled='true'] {
    opacity: 0.3;
    cursor: default;
  }
  .rv-thumb {
    width: 33%;
  }
</style>

<script>
  import { motionOn } from '@/lib/motion';

  /* ── niz recenzija ───────────────────────────────────────── */
  function initRail(root: HTMLElement) {
    const rail = root.querySelector<HTMLElement>('.rv-rail');
    const controls = root.querySelector<HTMLElement>('[data-rv-controls]');
    if (!rail || !controls) return;
    const prev = root.querySelector<HTMLButtonElement>('[data-rv-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-rv-next]');
    const thumb = root.querySelector<HTMLElement>('[data-rv-thumb]');
    const pos = root.querySelector<HTMLElement>('[data-rv-pos]');
    const items = Array.from(rail.querySelectorAll<HTMLElement>(':scope > li'));

    const step = () => {
      const a = items[0];
      const b = items[1];
      return a && b ? b.offsetLeft - a.offsetLeft : rail.clientWidth;
    };
    const pad = (k: number) => String(k).padStart(2, '0');
    // gumb ostaje fokusabilan (aria-disabled, ne disabled) da tipkovnica ne izgubi mjesto
    const setOff = (btn: HTMLButtonElement | null, off: boolean) => btn?.setAttribute('aria-disabled', String(off));

    let raf = 0;
    const update = () => {
      raf = 0;
      const max = rail.scrollWidth - rail.clientWidth;
      // kontrole samo kad ima što listati
      controls.hidden = max <= 2;
      const x = Math.max(0, rail.scrollLeft);
      const atEnd = x >= max - 2;
      setOff(prev, x <= 2);
      setOff(next, atEnd);
      if (thumb) {
        const visible = Math.min(1, rail.clientWidth / rail.scrollWidth);
        const progress = max > 0 ? x / max : 0;
        thumb.style.width = `${visible * 100}%`;
        thumb.style.left = `${progress * (1 - visible) * 100}%`;
      }
      if (pos) pos.textContent = pad(atEnd ? items.length : Math.min(items.length, Math.round(x / step()) + 1));
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    rail.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    const go = (btn: HTMLButtonElement | null, dir: 1 | -1) =>
      btn?.addEventListener('click', () => {
        if (btn.getAttribute('aria-disabled') === 'true') return;
        rail.scrollBy({ left: dir * step(), behavior: motionOn() ? 'smooth' : 'auto' });
      });
    go(prev, -1);
    go(next, 1);
    update();
  }

  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach(initRail);
</script>

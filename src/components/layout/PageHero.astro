---
/**
 * PageHero — zaglavlje podstranica (usluge, radovi, …). SVIJETLO: papir + milimetarski papir
 * (grid-paper-light) i tamna tinta. Tamni su samo zaglavlje, hero naslovnice, footer i mobilni dock.
 *
 * UGOVOR
 *  eyebrow?     string                mono oznaka iznad naslova ("Zagreb i šire · besplatna procjena")
 *  title        string                H1 (type-display). Jedini h1 na stranici, NE animira se (LCP).
 *                                     Veličina se računa iz duljine: najviše 3 retka < 64rem, 2 retka ≥ 64rem.
 *  lead?        string                uvod ispod naslova
 *  crumbs?      {href,label}[]        putanja; prva stavka je `homeCrumb` ("Naslovnica"), zadnja je
 *                                     trenutna stranica (bez linka, aria-current)
 *  image?       ImageMetadata         portretna fotografija desno (Photo, eager, fetchpriority high, data-scan)
 *  imageAlt?    string                alt fotografije (obavezan uz image)
 *  imageHref?   string                ispod fotografije tiha poveznica "Pogledajte rad" (rad kojem fotografija pripada)
 *  profile?     Profile               presjek lima: ProfileIcon (animate) + kotna linija
 *  profileLabel? string               natpis uz kotu (default: naziv profila · RAL 7016)
 *  index?       string                crveni broj ispred eyebrowa ("01") — podstranice ga više ne koriste
 *  phoneFirst?  boolean               telefon je glavni (crveni) gumb — hitne stranice (popravak krova).
 *                                     Inače: "Besplatna procjena" (crveno) + "Pošaljite slike" (WhatsApp, obrub).
 *  ctaHref?     string                cilj gumba "Besplatna procjena". Default '/procjena' + data-quote-link:
 *                                     skripta ga prebaci na '#procjena' kad stranica ima svoju formu.
 *  cta?         boolean               prikaži CTA red (default true)
 *  media?       'default' | 'large'  'large': fotografija zauzima pola širine (studija rada), H1 malo manji
 *  compact?     boolean               niži hero (arhive, /procjena): manji H1 i razmaci; bez fotografije
 *                                     na desktopu naslov lijevo, uvod desno
 *
 * SLOTOVI
 *  default      lijevi stupac, poravnat s dnom fotografije (npr. sastavnica rada).
 *               Na mobitelu dolazi ISPOD fotografije.
 *  meta         mono redak odmah ispod uvoda (npr. "12 radova · 6 vrsta")
 *  aside        desni stupac kad nema ni fotografije ni profila
 *
 * JSON-LD
 *  Komponenta ne ispisuje schema (da se ne duplicira). Stranica gradi BreadcrumbList helperom
 *    import PageHero, { breadcrumbSchema, homeCrumb } from '@/components/layout/PageHero.astro';
 *    const crumbs = [homeCrumb, { href: '/radovi', label: 'Radovi' }];
 *    <Base schema={[breadcrumbSchema(crumbs, Astro.site)]}>
 *  Stavke s "#" ulaze bez fragmenta; ponovljeni URL (npr. "/#usluge" = "/") se izostavlja.
 *
 * POKRET (samo pod .motion; HTML je u završnom stanju)
 *  fotografija: data-scan (reveal.ts) · profil: ravna traka → savijanje (ProfileIcon)
 *  kotna linija: DrawSVG 'draft' tek kad je scan fotografije gotov (data-revealed),
 *  tako da se u jednom trenutku miče samo jedna crvena stvar.
 */
import type { ImageMetadata } from 'astro';
import type { Profile } from '@/data/site';
import { site, telHref, waHref } from '@/data/site';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Photo from '@/components/ui/Photo.astro';
import ProfileIcon from '@/components/ui/ProfileIcon.astro';

export type Crumb = { href: string; label: string };

/** Korijen putanje — isti naziv na svim stranicama i u JSON-LD-u. */
export const homeCrumb: Crumb = { href: '/', label: 'Naslovnica' };

/** BreadcrumbList JSON-LD za Base `schema` prop. */
export function breadcrumbSchema(crumbs: Crumb[], base?: URL | string) {
  const root = base ?? 'https://www.limarija-karamatic.hr';
  const seen = new Set<string>();
  const items = crumbs
    .map((c) => ({ name: c.label, item: new URL(c.href.split('#')[0] || '/', root).toString() }))
    .filter((c) => (seen.has(c.item) ? false : (seen.add(c.item), true)));
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items.map((c, i) => ({ '@type': 'ListItem', position: i + 1, ...c })),
  };
}

export const profileNames: Record<Profile, string> = {
  crijep: 'Crijep-lim',
  falc: 'Stojeći falc',
  uvala: 'Uvala',
  atika: 'Kapa atike',
  dimnjak: 'Opšav dimnjaka',
  oluk: 'Polukružni oluk',
  trapez: 'Trapezni lim',
};

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  image?: ImageMetadata;
  imageAlt?: string;
  imageHref?: string;
  profile?: Profile;
  profileLabel?: string;
  index?: string;
  phoneFirst?: boolean;
  media?: 'default' | 'large';
  ctaHref?: string;
  cta?: boolean;
  compact?: boolean;
}

const {
  eyebrow,
  title,
  lead,
  crumbs = [],
  image,
  imageAlt = '',
  imageHref,
  profile,
  profileLabel,
  index,
  phoneFirst = false,
  ctaHref = '/procjena',
  cta = true,
  media = 'default',
  compact = false,
} = Astro.props;

const hasExtra = Astro.slots.has('default');
const hasAside = !image && !profile && Astro.slots.has('aside');
const hasMeta = Astro.slots.has('meta');
const hasMedia = !!image || !!profile || hasAside;
const dimLabel = profile ? (profileLabel ?? `${profileNames[profile]} · RAL 7016`) : '';
/* gumb za procjenu: na stranici s formom skripta ga prebaci na '#procjena' */
const quoteLink = ctaHref === '/procjena';
/* lomi samo na " · " separatorima (bez "ZAGREB I / ŠIRE") */
const parts = (t: string) => t.split(' · ');

/* ── veličina H1 prema duljini naslova ──────────────────────────────────────
   Širine glifova Archivo 125 / 800 (s letter-spacingom type-display), u 1/100 em,
   izmjerene u pregledniku. Za svaki broj redaka (2 i 3) traži se najuži mogući prijelom
   (riječi se ne lome); CSS zatim smanji font tako da taj prijelom stane u stupac:
   najviše 3 retka ispod 64rem, najviše 2 retka od 64rem. */
const GLYPH: Record<string, number> = {};
const put = (chars: string, widths: number[]) => [...chars].forEach((c, k) => (GLYPH[c] = widths[k]));
put('abcdefghijklmnopqrstuvwxyz', [76, 75, 76, 75, 77, 47, 75, 74, 30, 30, 72, 30, 115, 74, 77, 75, 75, 47, 70, 49, 74, 69, 106, 75, 69, 65]);
put('ABCDEFGHIJKLMNOPQRSTUVWXYZ', [92, 90, 93, 92, 85, 78, 100, 97, 36, 72, 94, 74, 113, 97, 100, 85, 100, 92, 85, 83, 95, 89, 120, 93, 90, 84]);
put('0123456789', [77, 69, 77, 77, 77, 77, 78, 70, 79, 78]);
put('.,:;!?-–—/·()\'"„“²°đĐ', [34, 34, 33, 34, 34, 70, 40, 61, 124, 29, 40, 36, 36, 26, 51, 54, 54, 45, 39, 75, 92]);
const SPACE = 0.29;
const glyph = (c: string) => {
  const w = GLYPH[c] ?? GLYPH[c.normalize('NFD')[0]];
  return w ?? (c !== c.toLowerCase() ? 92 : 76);
};
const wordEm = (w: string) => [...w].reduce((s, c) => s + glyph(c), 0) / 100;
/** najmanja moguća širina najduljeg retka (em) kad se naslov složi u najviše `lines` redaka */
function fitEm(text: string, lines: number): number {
  const words = text.split(/\s+/).filter(Boolean).map(wordEm);
  const n = words.length;
  const span = (i: number, j: number) => words.slice(i, j).reduce((s, w) => s + w, 0) + (j - i - 1) * SPACE;
  let prev = Array<number>(n + 1).fill(Infinity);
  prev[0] = 0;
  let best = Infinity;
  for (let k = 1; k <= lines; k++) {
    const cur = Array<number>(n + 1).fill(Infinity);
    for (let j = 1; j <= n; j++) for (let i = 0; i < j; i++) cur[j] = Math.min(cur[j], Math.max(prev[i], span(i, j)));
    best = Math.min(best, cur[n]);
    prev = cur;
  }
  // rezerva za kerning i zaokruživanje (tablica odstupa < 0,5 % od izmjerenog u pregledniku);
  // broj redaka jamči sam izračun: ako optimalni prijelom stane, ni pohlepni ni balance ne trebaju više redaka
  return Math.max(best, 4) * 1.02;
}
const titleFit = `--ph-w2: ${fitEm(title, 2).toFixed(2)}; --ph-w3: ${fitEm(title, 3).toFixed(2)}`;
---

<section
  class:list={[
    'ph relative isolate overflow-hidden bg-papir grid-paper-light text-tinta',
    hasMedia && 'ph--media',
    !hasMedia && 'ph--plain',
    hasExtra && 'ph--extra',
    media === 'large' && 'ph--large',
    compact && 'ph--compact',
  ]}
  aria-labelledby="ph-title"
>
  <div class:list={['wrap pt-5 sm:pt-7', compact ? 'pb-7 sm:pb-12' : 'pb-16 sm:pb-20 lg:pb-24']}>
    {
      crumbs.length > 0 && (
        <nav class="ph-crumbs" aria-label="Putanja">
          <ol>
            {crumbs.map((c, i) => (
              <li>
                {i < crumbs.length - 1 ? (
                  <a href={c.href}>{c.label}</a>
                ) : (
                  <span aria-current="page">{c.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="ph-grid">
      <div class="ph-text">
        <div class="ph-headline">
          {
            (eyebrow || index) && (
              <p class="ph-eyebrow eyebrow flex items-center gap-3 text-tinta/70">
                {index && <span class="text-redline-dark">{index}</span>}
                {index && <span class="h-px w-8 bg-current opacity-40" aria-hidden="true" />}
                {eyebrow && <span class="ph-parts">{parts(eyebrow).map((x, k, a) => <span>{x}{k < a.length - 1 && ' ·'}</span>)}</span>}
              </p>
            )
          }

          <h1 id="ph-title" class="ph-title type-display text-balance text-tinta" style={titleFit}>{title}</h1>
        </div>

        <div class="ph-body">
          {lead && <p class="ph-lead max-w-[36rem] text-pretty text-tinta/80">{lead}</p>}
          {hasMeta && (
            <div class="ph-meta">
              <slot name="meta" />
            </div>
          )}

          {
            cta && (
              <div class="ph-cta flex flex-col gap-3 min-[30rem]:flex-row min-[30rem]:flex-wrap">
                {phoneFirst ? (
                  <>
                    <Button href={telHref} size="lg" icon="phone">
                      Nazovite <span class="font-mono tracking-[0.02em]">{site.phoneDisplay}</span>
                    </Button>
                    <Button href={ctaHref} variant="outline-dark" size="lg" iconRight="arrow-right" {...(quoteLink ? { 'data-quote-link': '' } : {})}>
                      Besplatna procjena
                    </Button>
                  </>
                ) : (
                  <>
                    <Button href={ctaHref} size="lg" iconRight="arrow-right" {...(quoteLink ? { 'data-quote-link': '' } : {})}>
                      Besplatna procjena
                    </Button>
                    <Button href={waHref()} variant="outline-dark" size="lg" icon="whatsapp" class="ph-wa">
                      Pošaljite slike
                    </Button>
                  </>
                )}
              </div>
            )
          }
        </div>
      </div>

      {
        image && (
          <figure class="ph-media">
            <div class="ph-photo-frame">
              <div class="ph-photo" data-scan>
                <Photo
                  src={image}
                  alt={imageAlt}
                  widths={[480, 720, 960, 1200]}
                  sizes={media === 'large' ? '(min-width: 88rem) 40rem, (min-width: 64rem) 46vw, 100vw' : '(min-width: 88rem) 34rem, (min-width: 64rem) 38vw, 100vw'}
                  loading="eager"
                  fetchpriority="high"
                  class="block h-full w-full"
                  imgClass="h-full w-full object-cover"
                />
              </div>
              {profile && (
                <div class="ph-detail ph-detail--over" data-ph-detail>
                  <div class="ph-detail-draw">
                    <ProfileIcon profile={profile} size={128} animate class="ph-detail-icon" />
                    <svg class="ph-dim" viewBox="0 0 64 10" fill="none" aria-hidden="true" data-ph-dim>
                      <path d="M4 0V10M60 0V10" class="ph-dim-ext" />
                      <path d="M4 5H60" class="ph-dim-line" />
                      <path d="M2 8 6 2M58 8 62 2" class="ph-dim-tick" />
                    </svg>
                  </div>
                  <p class="ph-detail-label ph-parts">{parts(dimLabel).map((x, k, a) => <span>{x}{k < a.length - 1 && ' ·'}</span>)}</p>
                </div>
              )}
            </div>
            {imageHref && (
              <p class="ph-figcap">
                <a href={imageHref} class="ph-figcap-a">
                  Pogledajte rad
                  <Icon name="arrow-right" size={14} />
                </a>
              </p>
            )}
          </figure>
        )
      }

      {
        !image && profile && (
          <div class="ph-media ph-media--draw">
            <div class="ph-detail ph-detail--solo" data-ph-detail>
              <div class="ph-detail-draw">
                <ProfileIcon profile={profile} size={176} animate class="ph-detail-icon" />
                <svg class="ph-dim" viewBox="0 0 64 10" fill="none" aria-hidden="true" data-ph-dim>
                  <path d="M4 0V10M60 0V10" class="ph-dim-ext" />
                  <path d="M4 5H60" class="ph-dim-line" />
                  <path d="M2 8 6 2M58 8 62 2" class="ph-dim-tick" />
                </svg>
              </div>
              <p class="ph-detail-label ph-parts">{parts(dimLabel).map((x, k, a) => <span>{x}{k < a.length - 1 && ' ·'}</span>)}</p>
            </div>
          </div>
        )
      }

      {
        hasAside && (
          <div class="ph-media ph-media--aside">
            <slot name="aside" />
          </div>
        )
      }

      {
        hasExtra && (
          <div class="ph-extra">
            <slot />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .ph-parts {
    display: inline-flex;
    flex-wrap: wrap;
    column-gap: 0.5em;
  }
  .ph-detail-label.ph-parts {
    display: flex;
    justify-content: center;
  }
  .ph-parts > span {
    white-space: nowrap;
  }

  /* ── putanja ── */
  .ph-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(21 24 27 / 0.7);
  }
  .ph-crumbs li {
    display: inline-flex;
    align-items: center;
    min-width: 0;
  }
  .ph-crumbs li + li::before {
    content: '/';
    margin-right: 0.25rem;
    color: rgb(21 24 27 / 0.3);
  }
  .ph-crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: rgb(21 24 27 / 0.7);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.4em;
    transition:
      color 150ms var(--ease-press),
      text-decoration-color 150ms var(--ease-press);
  }
  .ph-crumbs a:hover {
    color: var(--color-tinta);
    text-decoration-color: currentColor;
  }
  .ph-crumbs [aria-current] {
    display: block;
    overflow: hidden;
    color: var(--color-tinta);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* jedan redak: trenutna stranica se skrati (…) umjesto prijeloma u novi red */
  .ph-crumbs ol {
    flex-wrap: nowrap;
  }
  .ph-crumbs li {
    flex: none;
    white-space: nowrap;
  }
  .ph-crumbs li:last-child {
    flex: 0 1 auto;
    min-width: 0;
  }

  /* ── raspored ── */
  .ph-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'text'
      'media'
      'extra';
    row-gap: 3rem;
    margin-top: 1.75rem;
  }
  /* samo redovi koji postoje (prazan red bi dodao row-gap na dno heroja) */
  @media (width < 64rem) {
    .ph--media:not(.ph--extra) .ph-grid {
      grid-template-areas:
        'text'
        'media';
    }
  }
  .ph--plain .ph-grid {
    grid-template-areas:
      'text'
      'extra';
  }
  .ph--plain:not(.ph--extra) .ph-grid {
    grid-template-areas: 'text';
  }
  @media (width >= 40rem) {
    .ph-grid {
      margin-top: 2.5rem;
    }
  }
  .ph--compact .ph-grid {
    margin-top: 1rem;
    row-gap: 2rem;
  }
  @media (width >= 40rem) {
    .ph--compact .ph-grid {
      margin-top: 1.5rem;
    }
  }
  .ph-text {
    grid-area: text;
    min-width: 0;
  }
  /* naslov mjeri svoj stupac (cqi) — veličina H1 ovisi o širini stupca i duljini naslova */
  .ph-headline {
    container-type: inline-size;
  }
  .ph-media {
    grid-area: media;
    margin: 0;
  }
  .ph-extra {
    grid-area: extra;
  }

  @media (width >= 64rem) {
    .ph--media .ph-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'text media'
        'extra media';
      column-gap: 4rem;
      row-gap: 3rem;
      margin-top: 3rem;
    }
    .ph--media .ph-media {
      align-self: start;
    }
    .ph-extra {
      align-self: end;
    }
    .ph-text {
      padding-top: 0.5rem;
    }
    /* kompaktni hero bez slike: naslov lijevo, uvod desno (poravnano dnom) */
    .ph--compact.ph--plain .ph-text {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 4rem;
      align-items: end;
      padding-top: 0;
    }
  }
  @media (width >= 80rem) {
    .ph--media .ph-grid {
      column-gap: 6rem;
    }
  }
  /* studija rada: veća fotografija */
  @media (width >= 64rem) {
    .ph--large .ph-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 4rem;
    }
  }
  @media (width >= 80rem) {
    .ph--large .ph-grid {
      column-gap: 5rem;
    }
  }

  /* ── tipografija ── */
  .ph-title {
    --ph-size: 2.5rem;
    --ph-fit: var(--ph-w3, 7);
    margin-top: 1.25rem;
    font-size: min(var(--ph-size), calc(100cqi / var(--ph-fit)));
  }
  .ph-headline > .ph-title:first-child {
    margin-top: 0;
  }
  @media (width >= 24rem) {
    .ph-title {
      --ph-size: 2.75rem;
    }
  }
  /* kompaktni hero (arhiva, /procjena): na mobitelu niži naslov — sadržaj ispod je u prvom ekranu.
     I dalje veći od najvećeg h2 na stranici (FinalCta ≈ 2,375rem). */
  @media (width < 40rem) {
    .ph--compact .ph-title {
      --ph-size: 2.5rem;
    }
  }
  @media (width >= 40rem) {
    .ph-title {
      --ph-size: 3.75rem;
    }
  }
  @media (width >= 64rem) {
    .ph-title {
      --ph-size: clamp(3.75rem, 5.4vw, 5.25rem);
      --ph-fit: var(--ph-w2, 7);
    }
    .ph--large .ph-title {
      --ph-size: clamp(3.25rem, 4.5vw, 4.5rem);
    }
    .ph--compact .ph-title {
      --ph-size: clamp(3rem, 4.5vw, 4.25rem);
    }
  }
  .ph-lead {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    line-height: 1.6;
  }
  @media (width >= 40rem) {
    .ph-lead {
      font-size: 1.25rem;
      line-height: 1.55;
    }
  }
  .ph--compact .ph-lead {
    margin-top: 1rem;
  }
  .ph-meta {
    margin-top: 1rem;
  }
  .ph-cta {
    margin-top: 2.25rem;
  }
  .ph--compact .ph-cta {
    margin-top: 1.75rem;
  }
  @media (width >= 64rem) {
    .ph--compact.ph--plain .ph-body > :first-child {
      margin-top: 0;
    }
  }

  /* gumbi na uskim ekranima preko cijele širine */
  @media (width < 30rem) {
    .ph-cta :global(> a) {
      width: 100%;
    }
  }
  /* WhatsApp kao tihi drugi gumb: tamni obrub, samo ikona u boji
     (tamnija zelena: čitljiva na papiru, ≥ 3:1) */
  .ph-cta :global(.ph-wa > svg:first-child) {
    color: #16a34a;
  }

  /* ── fotografija ── */
  .ph-photo-frame {
    position: relative;
  }
  .ph-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-antracit);
  }
  @media (width < 40rem) {
    .ph-photo {
      aspect-ratio: 5 / 6;
    }
  }
  @media (width >= 40rem) and (width < 64rem) {
    .ph-photo {
      aspect-ratio: 5 / 4;
    }
  }
  /* tiha poveznica na rad ispod fotografije (dodirna površina 44 px) */
  .ph-figcap {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.25rem;
  }
  .ph-figcap-a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: rgb(21 24 27 / 0.75);
    text-decoration: underline;
    text-decoration-color: rgb(21 24 27 / 0.25);
    text-underline-offset: 4px;
    white-space: nowrap;
    transition:
      color 150ms var(--ease-press),
      text-decoration-color 150ms var(--ease-press);
  }
  .ph-figcap-a:hover {
    color: var(--color-tinta);
    text-decoration-color: currentColor;
  }
  @media (width >= 64rem) {
    /* izvan toka: donji rub fotografije = donji rub lijevog stupca */
    .ph-media {
      position: relative;
    }
    .ph-figcap {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
    }
  }

  /* ── presjek lima s kotnom linijom (papirna pločica) ── */
  .ph-detail {
    color: var(--color-tinta);
    background: var(--color-papir);
    border: 1px solid rgb(21 24 27 / 0.12);
  }
  .ph-detail--over {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 3;
    width: 10.5rem;
    padding: 0.625rem 0.75rem 0.75rem;
    border-width: 1px 1px 0 0;
  }
  @media (width >= 40rem) {
    .ph-detail--over {
      width: 12rem;
      padding: 0.875rem 1rem 1rem;
    }
  }
  /* prepust preko lijevog ruba fotografije: uvijek ≥ 2,5rem (40 px) do lijevog stupca */
  @media (width >= 64rem) {
    .ph-detail--over {
      left: -1.5rem;
      bottom: 1.5rem;
      width: 12rem;
      border-width: 1px;
    }
  }
  @media (width >= 80rem) {
    .ph-detail--over {
      left: -3.5rem;
      bottom: 2.5rem;
      width: 14rem;
    }
    .ph--large .ph-detail--over {
      left: -2.5rem;
    }
  }
  .ph-detail--solo {
    position: relative;
    width: 100%;
    max-width: 22rem;
    padding: 1.25rem 1.5rem 1.5rem;
  }
  @media (width >= 64rem) {
    .ph-detail--solo {
      margin-left: auto;
    }
  }
  .ph-detail-draw {
    display: grid;
    justify-items: center;
    margin: 0 auto;
    width: 6rem;
  }
  @media (width >= 40rem) {
    .ph-detail-draw {
      width: 8rem;
    }
  }
  .ph-detail--solo .ph-detail-draw {
    width: 11rem;
    margin-top: 1rem;
  }
  .ph-detail-draw :global(.ph-detail-icon) {
    width: 100%;
    height: auto;
  }
  .ph-dim {
    width: 100%;
    height: auto;
    margin-top: 0.125rem;
    overflow: visible;
    stroke: var(--color-redline-dark);
  }
  .ph-dim path {
    vector-effect: non-scaling-stroke;
    stroke-width: 1px;
  }
  .ph-dim-ext {
    stroke: rgb(21 24 27 / 0.4);
  }
  .ph-detail-label {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    color: rgb(21 24 27 / 0.72);
  }
  @media (width >= 40rem) {
    .ph-detail-label {
      font-size: 0.625rem;
    }
  }

  /* prije crtanja (samo uz pokret) */
  :global(.motion) .ph-dim-line,
  :global(.motion) .ph-dim-tick {
    opacity: 0;
  }
</style>

<script>
  import { gsap, ScrollTrigger, motionOn } from '@/lib/motion';

  /* "Besplatna procjena": na stranici s vlastitom formom ostaje na stranici (D4) */
  function quoteLinks() {
    if (!document.getElementById('procjena')) return;
    document.querySelectorAll<HTMLAnchorElement>('.ph a[data-quote-link]').forEach((a) => a.setAttribute('href', '#procjena'));
  }

  /* kota se crta tek kad je scan fotografije gotov (jedna crvena stvar u pokretu) */
  function afterScan(host: Element | null, cb: () => void) {
    if (!host || host.hasAttribute('data-revealed')) return cb();
    const mo = new MutationObserver(() => {
      if (!host.hasAttribute('data-revealed')) return;
      mo.disconnect();
      cb();
    });
    mo.observe(host, { attributes: true, attributeFilter: ['data-revealed'] });
  }

  function initPageHero() {
    quoteLinks();
    if (!motionOn()) return;
    document.querySelectorAll<SVGSVGElement>('svg[data-ph-dim]:not([data-ph-ready])').forEach((svg) => {
      svg.setAttribute('data-ph-ready', '');
      const line = svg.querySelector<SVGPathElement>('.ph-dim-line');
      const ticks = svg.querySelector<SVGPathElement>('.ph-dim-tick');
      if (!line || !ticks) return;
      const host = svg.closest('.ph-photo-frame')?.querySelector('[data-scan]') ?? null;
      gsap.set(line, { drawSVG: '50% 50%', opacity: 1 });
      gsap.set(ticks, { opacity: 0 });
      const tl = gsap.timeline({ paused: true });
      tl.to(line, { drawSVG: '0% 100%', duration: 0.7, ease: 'draft' }).to(
        ticks,
        { opacity: 1, duration: 0.18, ease: 'press' },
        '-=0.12',
      );
      ScrollTrigger.create({
        trigger: svg,
        start: 'top 92%',
        once: true,
        onEnter: () => afterScan(host, () => gsap.delayedCall(host ? 0.1 : 0.45, () => tl.play())),
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPageHero, { once: true });
  } else {
    initPageHero();
  }
</script>

---
/**
 * Gornja traka (samo lg+): područje · radno vrijeme | e-mail.
 * Telefon je odmah ispod, u zaglavlju — ovdje se ne ponavlja.
 * Obje trake su u landmarku <aside> (axe "region"), da sadržaj ne ostane izvan orijentira.
 * STORM_MODE = true uključuje crvenu traku "Nakon nevremena" (na svim širinama — tada je najvažnija na mobitelu).
 * U CMS-u će to biti prekidač; ovdje je konstanta (prop `storm` služi samo za pregled).
 */
import Icon from '@/components/ui/Icon.astro';
import { getContent } from '@/lib/content';

const { contact: site, telHref } = await getContent();

const STORM_MODE = false;

interface Props {
  storm?: boolean;
}
const { storm = STORM_MODE } = Astro.props;
---

{
  storm && (
    <aside aria-label="Obavijest nakon nevremena">
      <a href={telHref} class="kr-storm group block bg-crvena text-white">
        <span class="wrap flex min-h-10 flex-wrap items-center justify-center gap-x-3 gap-y-0.5 py-2 text-center text-[0.8125rem] leading-snug sm:text-sm">
          <span class="font-semibold">Nakon nevremena: hitni izlasci</span>
          <span class="hidden h-3 w-px bg-white/40 sm:block" aria-hidden="true" />
          <span class="sr-only"> — </span>
          <span class="inline-flex items-center gap-2">
            nazovite
            <span class="font-mono font-medium tracking-[0.02em] underline decoration-white/40 underline-offset-4 group-hover:decoration-white">
              {site.phoneDisplay}
            </span>
          </span>
        </span>
      </a>
    </aside>
  )
}

<aside class="kr-util hidden border-b border-white/[0.06] bg-grafit-2 lg:block" aria-label="Kontakt podaci">
  <div class="wrap flex h-9 items-center justify-between font-mono text-xs tracking-[0.02em] text-celik">
    <ul class="flex items-center" aria-label="Područje i radno vrijeme">
      <li class="flex items-center gap-2">
        <Icon name="map-pin" size={14} class="opacity-70" />
        {site.area}
      </li>
      <li class="kr-util__sep" aria-hidden="true"></li>
      <li class="flex items-center gap-2">
        <Icon name="clock" size={14} class="opacity-70" />
        {site.hours}
      </li>
    </ul>
    <a href={`mailto:${site.email}`} class="kr-util__link">{site.email}</a>
  </div>
</aside>

<style>
  .kr-util__sep {
    width: 1px;
    height: 12px;
    margin-inline: 1.25rem;
    background: rgb(213 219 223 / 0.14);
  }
  .kr-util__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 36px;
    transition: color 150ms var(--ease-press);
  }
  .kr-util__link:hover {
    color: #fff;
  }
</style>

---
/**
 * Mobilni "dok" (< lg): plutajuća pločica 12 px od rubova, 56 px visoka.
 *   [ WhatsApp ]  [ Besplatna procjena  → ]
 * Lijevo kvadrat 56 × 56 s WhatsApp znakom (samo ikona), desno crveni gumb do kraja.
 * Grafit 92 % + blur, tanka linija (linija/12), rubovi ≤ 4 px, gore suptilni odsjaj.
 *
 * Pojavljuje se tek kad glavni CTA heroja izađe iz ekrana (IntersectionObserver).
 *   Sidro: [data-dock-anchor] → #vrh .hx-cta-main → .ph-cta (PageHero);
 *   bez sidra: nakon ~40 % prvog ekrana skrola.
 * Skriva se dok je na ekranu #procjena, footer ili [data-hide-mobile-cta], i dok je otvoren izbornik.
 * Ulazi odozdo 200 ms (ease-press); s reduced motion / isključenim animacijama samo se pojavi.
 * Bez JS-a: uvijek vidljiv.
 * "Besplatna procjena" vodi na /procjena; skripta u Headeru je prebacuje na #procjena kad stranica ima obrazac.
 */
import Icon from '@/components/ui/Icon.astro';
import { waHref } from '@/data/site';
---

<nav class="kr-dock lg:hidden" aria-label="Brzi kontakt" data-mobile-cta>
  <a href={waHref()} class="kr-dock__wa" target="_blank" rel="noopener" aria-label="Pošaljite slike na WhatsApp">
    <span class="kr-dock__key" aria-hidden="true">
      <Icon name="whatsapp" size={22} />
    </span>
  </a>
  <a href="/procjena" class="kr-dock__go" data-quote-link>
    <span class="kr-dock__plate">
      <span>Besplatna procjena</span>
      <Icon name="arrow-right" size={18} class="kr-dock__arrow" />
    </span>
  </a>
</nav>

<style>
  /* ── Pločica ─────────────────────────────────────────────── */
  .kr-dock {
    --inset: 12px;
    --h: 56px;
    --pad: 4px;
    position: fixed;
    z-index: 40;
    left: var(--inset);
    right: var(--inset);
    bottom: calc(var(--inset) + env(safe-area-inset-bottom));
    display: flex;
    height: var(--h);
    background: rgb(14 16 19 / 0.92);
    -webkit-backdrop-filter: blur(14px) saturate(1.25);
    backdrop-filter: blur(14px) saturate(1.25);
    border: 1px solid rgb(213 219 223 / 0.12);
    border-radius: 4px;
    /* stranica je uglavnom svijetla: mekana, niska sjena (bez sive aureole na papiru) */
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.3),
      0 2px 6px -2px rgb(14 16 19 / 0.35),
      0 10px 24px -10px rgb(14 16 19 / 0.55);
    /* izvan ekrana: sakriven; vidljivost se gasi tek kad pločica izađe (200 ms) */
    transition:
      transform 200ms var(--ease-press),
      opacity 200ms var(--ease-press),
      visibility 0s linear 200ms;
  }
  /* tablet (640–1023): pločica ne ide od ruba do ruba nego je centrirana i uža
     (`translate` je odvojen od `transform`, kojim se dok uvlači) */
  @media (width >= 40rem) {
    .kr-dock {
      left: 50%;
      right: auto;
      width: min(26rem, calc(100% - var(--inset) * 2));
      translate: -50% 0;
    }
  }
  /* samo ispod lg — scoped `display: flex` je izvan Tailwind slojeva i nadjačao bi `lg:hidden` */
  @media (width >= 64rem) {
    .kr-dock {
      display: none;
    }
  }
  /* odsjaj gornjeg brida: tanka svjetlija linija koja se gubi prema krajevima */
  .kr-dock::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 0) 0%,
      rgb(255 255 255 / 0.22) 30%,
      rgb(255 255 255 / 0.22) 70%,
      rgb(255 255 255 / 0) 100%
    );
    pointer-events: none;
  }

  /* JS radi (inline skripta u <head> postavlja .motion ili .motion-off): pločica čeka sidro */
  :global(html:is(.motion, .motion-off)) .kr-dock:not([data-shown]),
  :global(html[data-menu-open]) .kr-dock {
    transform: translateY(calc(100% + var(--inset) + env(safe-area-inset-bottom) + 4px));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .kr-dock[data-shown] {
    transition:
      transform 200ms var(--ease-press),
      opacity 120ms var(--ease-press),
      visibility 0s;
  }
  /* reduced motion / isključene animacije: bez klizanja, samo pokaži/sakrij */
  :global(html.motion-off) .kr-dock,
  :global(html.motion-off) .kr-dock[data-shown] {
    transition: none;
  }
  :global(html.motion-off) .kr-dock:not([data-shown]),
  :global(html.motion-off[data-menu-open]) .kr-dock {
    transform: none;
  }

  /* ── WhatsApp: pogodak 56 × 56, vidljiva tipka 48 × 48 ────── */
  .kr-dock__wa {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: calc(var(--h) - 2px);
    height: 100%;
    color: var(--color-whatsapp);
    -webkit-tap-highlight-color: transparent;
  }
  .kr-dock__key {
    display: grid;
    place-items: center;
    width: calc(var(--h) - 2px - var(--pad) * 2);
    height: calc(var(--h) - 2px - var(--pad) * 2);
    border-radius: 2px;
    background: rgb(37 211 102 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(37 211 102 / 0.28);
    transition:
      background-color 150ms var(--ease-press),
      box-shadow 150ms var(--ease-press),
      transform 150ms var(--ease-press);
  }
  .kr-dock__wa:active .kr-dock__key {
    background: rgb(37 211 102 / 0.16);
    box-shadow: inset 0 0 0 1px rgb(37 211 102 / 0.45);
    transform: translateY(1px);
  }
  .kr-dock__wa:focus-visible {
    outline-offset: -2px;
  }

  /* ── Crveni gumb: popunjava ostatak, uvučen 4 px (kao tipka u ležištu) ── */
  .kr-dock__go {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    padding: var(--pad) var(--pad) var(--pad) 0;
    color: #fff;
    -webkit-tap-highlight-color: transparent;
  }
  .kr-dock__plate {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-inline: 1.125rem 1rem;
    border-radius: 2px;
    background: var(--color-crvena);
    /* svjetliji gornji brid lima */
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.16);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    white-space: nowrap;
    transition:
      background-color 150ms var(--ease-press),
      transform 150ms var(--ease-press);
  }
  .kr-dock__plate :global(.kr-dock__arrow) {
    flex: none;
    transition: transform 180ms var(--ease-press);
  }
  .kr-dock__go:hover .kr-dock__plate {
    background: var(--color-crvena-hover);
  }
  .kr-dock__go:active .kr-dock__plate {
    background: var(--color-crvena-hover);
    transform: translateY(1px);
  }
  .kr-dock__go:is(:hover, :active, :focus-visible) :global(.kr-dock__arrow) {
    transform: translateX(3px);
  }
  /* na crvenoj podlozi crveni fokus se ne vidi */
  .kr-dock__go:focus-visible {
    outline: none;
  }
  .kr-dock__go:focus-visible .kr-dock__plate {
    outline: 2px solid #fff;
    outline-offset: -4px;
  }
</style>

<script>
  const docks = document.querySelectorAll<HTMLElement>('[data-mobile-cta]');

  if (docks.length) {
    const root = document.documentElement;
    let past = false;
    const hiding = new Set<Element>();

    const apply = () => {
      const show = past && hiding.size === 0;
      docks.forEach((d) => {
        d.toggleAttribute('data-shown', show);
        d.inert = !show;
      });
    };

    if (!('IntersectionObserver' in window)) {
      past = true;
      apply();
    } else {
      /* 1) Sidro: glavni CTA heroja. Dok je pokazan ili ispod ekrana, dok čeka. */
      const visible = (el: Element | null): el is HTMLElement =>
        !!el && (el as HTMLElement).getClientRects().length > 0;
      let anchor: HTMLElement | null =
        [
          document.querySelector('[data-dock-anchor]'),
          document.querySelector('#vrh .hx-cta-main'),
          document.querySelector('.ph-cta'),
        ].find(visible) ?? null;

      if (!anchor) {
        // stranica bez heroja: nevidljiva oznaka na ~40 % prvog ekrana
        anchor = document.createElement('div');
        anchor.setAttribute('aria-hidden', 'true');
        anchor.style.cssText = 'position:absolute;left:0;top:40vh;width:1px;height:1px;pointer-events:none;';
        document.body.appendChild(anchor);
      }

      new IntersectionObserver((entries) => {
        const e = entries[entries.length - 1];
        // "prošao" = izašao iznad gornjeg ruba (ne: još nije došao odozdo)
        past = !e.isIntersecting && e.boundingClientRect.bottom <= 0;
        apply();
      }).observe(anchor);

      /* 2) Zone u kojima dok smeta: obrazac, footer i označene zone (kad zauzmu donje ~3/4 ekrana) */
      const zones = document.querySelectorAll<HTMLElement>('#procjena, [data-site-footer], [data-hide-mobile-cta]');
      const zio = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => (e.isIntersecting ? hiding.add(e.target) : hiding.delete(e.target)));
          apply();
        },
        { rootMargin: '0px 0px -25% 0px', threshold: 0 },
      );
      zones.forEach((z) => zio.observe(z));
    }

    apply();

    /* izbornik otvoren: dok je ionako ispod dijaloga, ali ne smije primati fokus */
    new MutationObserver(() => {
      if (root.hasAttribute('data-menu-open')) docks.forEach((d) => (d.inert = true));
      else apply();
    }).observe(root, { attributes: true, attributeFilter: ['data-menu-open'] });
  }
</script>

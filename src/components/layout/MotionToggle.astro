---
/**
 * Prekidač "Animacije: uključene / isključene".
 * Stanje čita iz <html class="motion-off"> (postavlja ga inline skripta u <head> prije prvog crtanja),
 * pa nema treptanja. Isključivanje vrijedi odmah; uključivanje vrijedi od sljedećeg učitavanja,
 * da se već prikazan sadržaj ne bi ponovno sakrio.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<button
  type="button"
  role="switch"
  aria-checked="true"
  class:list={['kr-mt', className]}
  data-motion-toggle
>
  <span class="kr-mt__track" aria-hidden="true"><span class="kr-mt__knob"></span></span>
  <span class="kr-mt__text"
    >Animacije: <span class="kr-mt__on">uključene</span><span class="kr-mt__off">isključene</span></span
  >
</button>

<style>
  .kr-mt {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-celik);
    background: none;
    border: 0;
    text-align: left;
    transition: color 150ms var(--ease-press);
  }
  .kr-mt:hover {
    color: var(--color-linija);
  }
  /* isključeno u postavkama uređaja: bez prozirnosti (kontrast AA), isprekidani okvir kaže "zaključano" */
  .kr-mt[aria-disabled='true'] {
    cursor: not-allowed;
  }
  .kr-mt[aria-disabled='true']:hover {
    color: var(--color-celik);
  }
  .kr-mt[aria-disabled='true'] .kr-mt__track {
    border-style: dashed;
  }

  /* pravokutni prekidač — lim, ne pilula */
  .kr-mt__track {
    position: relative;
    flex: none;
    width: 30px;
    height: 16px;
    border: 1px solid currentColor;
    border-radius: 1px;
  }
  .kr-mt__knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 10px;
    height: 10px;
    background: var(--color-linija);
    transform: translateX(14px);
    transition:
      transform 180ms var(--ease-press),
      background-color 150ms;
  }
  .kr-mt__text {
    white-space: nowrap;
  }
  .kr-mt__off {
    display: none;
  }

  :global(html.motion-off) .kr-mt__knob {
    transform: translateX(0);
    background: transparent;
    box-shadow: inset 0 0 0 1px currentColor;
  }
  :global(html.motion-off) .kr-mt__on {
    display: none;
  }
  :global(html.motion-off) .kr-mt__off {
    display: inline;
  }
</style>

<script>
  import { setMotionPreference } from '@/lib/motion';

  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]');
  const osReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const sync = () => {
    const off = root.classList.contains('motion-off');
    toggles.forEach((b) => b.setAttribute('aria-checked', String(!off)));
  };

  toggles.forEach((btn) => {
    if (osReduced) {
      btn.setAttribute('aria-disabled', 'true');
      btn.title = 'Smanjeno kretanje uključeno je u postavkama uređaja';
    }
    btn.addEventListener('click', () => {
      if (osReduced) return;
      if (!root.classList.contains('motion-off')) {
        // isključi odmah: sve animacije skaču na kraj
        setMotionPreference(true);
      } else {
        // spremi izbor; animacije kreću od sljedećeg učitavanja
        setMotionPreference(false);
        root.classList.remove('motion');
      }
      sync();
    });
  });

  sync();
</script>

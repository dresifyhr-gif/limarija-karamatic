---
/**
 * Footer kao "sastavnica" — zaglavlje tehničkog crteža, svedeno na bitno:
 *  1. četiri polja: znak + potpis + područje · Usluge · Stranice · Kontakt (telefon, WhatsApp, e-mail, radno vrijeme)
 *     i jedan tanki red: © · Privatnost | Mjerilo 1 : 1 | prekidač animacija.
 *     Područje je jedan redak (site.area — "Zagreb i šire") s linkom na /kontakt ("Gdje radimo").
 *     Poruke samo preko WhatsAppa (nema Vibera).
 *  2. golemi KARAMATIĆ preko cijele širine kontejnera — na desktopu se "razvije" po osi širine
 *     (font-stretch 62 % → 125 %, ScrollTrigger once, ease draft); na mobitelu / reduced statičan.
 * Mobilni dok (MobileCtaBar) se skriva dok je footer na ekranu (data-site-footer), pa footer na dnu
 * treba samo safe-area razmak; bez JS-a dok je stalno vidljiv i footer mu ostavlja mjesto.
 */
import Logo from '@/components/ui/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import MotionToggle from './MotionToggle.astro';
import { site, services, telHref, waHref } from '@/data/site';

const year = new Date().getFullYear();
/* Kratke oznake kao u glavnoj navigaciji; "Besplatna procjena" je već u zaglavlju, doku i obrascu iznad footera */
const pages = [
  { href: '/radovi', label: 'Radovi' },
  { href: '/upravitelji-zgrada', label: 'Za zgrade' },
  { href: '/o-nama', label: 'O nama' },
  { href: '/kontakt', label: 'Kontakt' },
];
/* radno vrijeme u dijelovima: lomi se samo između dijelova */
const hoursParts = site.hours.split(' · ');
const LAMBDA = 'M8 688 477-10 946 688H661L477 236 293 688Z';
---

<footer class="kr-footer grid-paper relative bg-grafit text-linija" aria-labelledby="kr-footer-title" data-site-footer>
  <h2 id="kr-footer-title" class="sr-only">Navigacija i kontakt</h2>

  <div class="wrap pt-14 sm:pt-20 lg:pt-28">
    <div class="kr-tb grid grid-cols-2 lg:grid-cols-12">
      <!-- Znak · potpis · područje (na mobitelu bez znaka: golemi KARAMATIĆ je ispod) -->
      <div class="kr-cell kr-cell--brand col-span-2 lg:col-span-4">
        <a href="/" class="hidden sm:inline-block" aria-label={`${site.name} — naslovnica`}>
          <Logo class="text-[2.125rem]" />
        </a>
        <p class="type-display text-[1.375rem] leading-[1.1] text-white sm:mt-8 sm:text-2xl lg:text-[1.375rem] xl:text-2xl">
          Sedam puta mjerimo.<br />Jednom savijemo.
        </p>
        <a href="/kontakt" class="kr-area">
          <span>{site.area}</span><span class="sr-only"> — područje rada i kontakt</span>
          <Icon name="arrow-right" size={15} class="kr-area__arrow" />
        </a>
      </div>

      <!-- Usluge (cilj linka "Izbornik" kad JS ne radi) -->
      <nav id="navigacija" class="kr-cell col-span-1 lg:col-span-3" aria-labelledby="kr-f-usluge">
        <p class="kr-label" id="kr-f-usluge">Usluge</p>
        <ul class="kr-links">
          {
            services.map((s) => (
              <li>
                <a href={`/usluge/${s.slug}`}>{s.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="kr-cell col-span-1 lg:col-span-2" aria-labelledby="kr-f-stranice">
        <p class="kr-label" id="kr-f-stranice">Stranice</p>
        <ul class="kr-links">
          {
            pages.map((p) => (
              <li>
                <a href={p.href}>{p.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="kr-cell col-span-2 lg:col-span-3">
        <p class="kr-label">Kontakt</p>
        <ul class="kr-links kr-links--contact">
          <li>
            <a href={telHref} class="kr-tel" aria-label={`Nazovite ${site.phoneDisplay}`}>{site.phoneDisplay}</a>
          </li>
          <li>
            <a href={waHref()} target="_blank" rel="noopener" aria-label="Pošaljite slike na WhatsApp">WhatsApp</a>
          </li>
          <li class="kr-mail"><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
        <p class="kr-hours">{hoursParts.map((h) => <span>{h}</span>)}</p>
      </div>

      <!-- tanki red sastavnice -->
      <div class="kr-cell kr-cell--thin col-span-2 lg:col-span-7">
        <p class="kr-fine">
          <span>© {year} {site.name}</span>
          <a href="/privatnost">Privatnost</a>
        </p>
      </div>
      <div class="kr-cell kr-cell--thin kr-cell--meta lg:col-span-2" aria-hidden="true">
        <p class="kr-meta"><span>Mjerilo</span><span>1 : 1</span></p>
      </div>
      <div class="kr-cell kr-cell--thin col-span-2 !py-0 lg:col-span-3">
        <MotionToggle />
      </div>
    </div>

    <div class="kr-giant-wrap" aria-hidden="true">
      <p class="kr-giant" data-giant>KAR<svg class="kr-giant__lam" viewBox="0 0 954 688" preserveAspectRatio="none"><path d={LAMBDA} /></svg>MATIĆ</p>
    </div>
  </div>
</footer>

<style>
  .kr-footer {
    padding-bottom: env(safe-area-inset-bottom);
  }
  /* bez JS-a mobilni dok je stalno vidljiv: ostavi mu mjesto (56 + 12 px + safe area) */
  @media (width < 64rem) {
    :global(html:not(.motion):not(.motion-off)) .kr-footer {
      padding-bottom: calc(76px + env(safe-area-inset-bottom));
    }
  }

  /* ── Sastavnica: deblji vanjski okvir, tanke unutarnje linije ── */
  .kr-tb {
    position: relative;
    overflow: hidden;
    background: var(--color-grafit);
    border: 1px solid rgb(213 219 223 / 0.28);
  }
  .kr-cell {
    margin: 0 -1px -1px 0;
    padding: 1.25rem 1.125rem 1.375rem;
    border-right: 1px solid rgb(213 219 223 / 0.1);
    border-bottom: 1px solid rgb(213 219 223 / 0.1);
    min-width: 0;
  }
  .kr-cell--thin {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding-block: 0.625rem;
  }
  /* Mjerilo je ukras — na mobitelu ne troši redak */
  .kr-cell--meta {
    display: none;
  }
  @media (width >= 40rem) {
    .kr-cell {
      padding: 1.5rem 1.5rem 1.75rem;
    }
    .kr-cell--meta {
      display: flex;
    }
    .kr-cell--thin {
      min-height: 3.25rem;
      padding-block: 0.75rem;
    }
  }
  @media (width >= 64rem) {
    .kr-cell--thin {
      padding-block: 0.5rem;
      min-height: 3.5rem;
    }
  }
  @media (width >= 80rem) {
    .kr-cell {
      padding: 1.75rem 1.75rem 2rem;
    }
    .kr-cell--thin {
      padding-block: 0.5rem;
    }
  }
  /* mjerilo između © i prekidača samo na sm–lg ne stane u red: tamo ga nema */
  @media (width >= 40rem) and (width < 64rem) {
    .kr-cell--meta {
      display: none;
    }
  }

  .kr-label {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-celik);
  }
  @media (width >= 40rem) {
    .kr-label {
      margin-bottom: 1rem;
    }
  }

  /* Područje: jedan redak s linkom na kontakt */
  .kr-area {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-linija);
    transition: color 150ms var(--ease-press);
  }
  .kr-area > span:first-child {
    text-decoration: underline;
    text-decoration-color: rgb(213 219 223 / 0.3);
    text-underline-offset: 5px;
    transition: text-decoration-color 150ms var(--ease-press);
  }
  .kr-area :global(.kr-area__arrow) {
    color: var(--color-celik);
    transition:
      transform 180ms var(--ease-press),
      color 150ms var(--ease-press);
  }
  .kr-area:hover {
    color: #fff;
  }
  .kr-area:hover > span:first-child {
    text-decoration-color: var(--color-redline);
  }
  .kr-area:hover :global(.kr-area__arrow) {
    color: #fff;
    transform: translateX(3px);
  }
  @media (width >= 40rem) {
    .kr-area {
      margin-top: 1rem;
    }
  }

  .kr-links {
    display: grid;
  }
  .kr-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-block: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.25;
    color: var(--color-linija);
    overflow-wrap: anywhere;
    transition: color 150ms var(--ease-press);
  }
  .kr-links a:hover {
    color: #fff;
  }
  @media (width >= 40rem) {
    .kr-links a {
      font-size: 0.9375rem;
    }
  }
  @media (width >= 64rem) {
    .kr-links a {
      min-height: 2rem;
      padding-block: 0.25rem;
    }
  }

  /* Kontakt: na mobitelu telefon · WhatsApp u jednom retku, e-mail ispod */
  .kr-links--contact {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.75rem;
  }
  .kr-mail {
    flex-basis: 100%;
  }
  @media (width >= 64rem) {
    .kr-links--contact {
      display: grid;
    }
  }
  .kr-links .kr-tel {
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.02em;
    word-spacing: -0.15em;
    color: #fff;
  }
  .kr-links .kr-tel:hover {
    color: var(--color-linija);
  }
  .kr-hours {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.5rem;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.25rem;
    letter-spacing: 0.02em;
    color: var(--color-celik);
  }
  .kr-hours > span {
    white-space: nowrap;
  }
  .kr-hours > span:not(:last-child)::after {
    content: '·';
    margin-left: 0.5rem;
    color: rgb(138 147 155 / 0.6);
  }
  @media (width >= 64rem) {
    .kr-hours {
      margin-top: 0.75rem;
    }
  }

  /* © · Privatnost: dijelovi se lome cijeli, točka nikad na početku retka */
  .kr-fine {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.25rem;
    color: var(--color-celik);
  }
  .kr-fine > * {
    white-space: nowrap;
  }
  .kr-fine > :not(:last-child)::after {
    content: '·';
    margin-left: 0.5rem;
    color: rgb(138 147 155 / 0.6);
  }
  .kr-fine a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-linija);
    text-decoration: underline;
    text-decoration-color: rgb(213 219 223 / 0.3);
    text-underline-offset: 4px;
    transition: color 150ms var(--ease-press);
  }
  .kr-fine a:hover {
    color: #fff;
  }
  @media (width >= 64rem) {
    .kr-fine a {
      min-height: 2rem;
    }
  }

  .kr-meta {
    display: flex;
    width: 100%;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .kr-meta > span:first-child {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-celik);
  }
  .kr-meta > span:last-child {
    color: var(--color-linija);
  }

  /* ── Golemi KARAMATIĆ ──
     Riječ na wdth 125 / wght 900 široka je 7,982 em; tinta počinje 0,074 em od ruba (K)
     i završava ~0,05 em prije kraja (Ć). Veličina se računa iz širine kontejnera (cqi). */
  .kr-giant-wrap {
    container-type: inline-size;
    padding-top: 2rem;
    padding-bottom: clamp(1.25rem, 2.4vw, 2.25rem);
  }
  @media (width >= 40rem) {
    .kr-giant-wrap {
      padding-top: clamp(2rem, 6vw, 5rem);
    }
  }
  .kr-giant {
    --lb: 0.074;
    --rb: 0.045;
    font-size: calc(100cqi / (7.982 - var(--lb) - var(--rb)));
    margin-left: calc(var(--lb) * -1em);
    padding-top: 0.22em;
    font-weight: 900;
    font-stretch: 125%;
    line-height: 0.69;
    letter-spacing: 0;
    white-space: nowrap;
    color: var(--color-antracit-2);
    user-select: none;
  }
  .kr-giant__lam {
    display: inline-block;
    width: 0.954em;
    height: 0.688em;
    vertical-align: baseline;
    overflow: visible;
    fill: var(--color-crvena);
  }
  /* Početno stanje animacije: samo uz .motion i samo na desktopu */
  @media (width >= 64rem) {
    :global(html.motion) .kr-giant {
      font-stretch: 62%;
    }
    :global(html.motion) .kr-giant__lam {
      width: 0.53em;
    }
  }
</style>

<script>
  import { gsap, motionOn } from '@/lib/motion';

  /* Širina slova A (= širina Λ) u em po osi wdth, izmjereno na Archivo 900: 62 → 0,530 · 100 → 0,778 · 125 → 0,954 */
  const advance = (w: number) => (w <= 100 ? 0.53 + ((w - 62) * 0.248) / 38 : 0.778 + ((w - 100) * 0.176) / 25);

  function initGiant() {
    if (!motionOn()) return;
    const mm = gsap.matchMedia();
    mm.add('(min-width: 64rem)', () => {
      document.querySelectorAll<HTMLElement>('[data-giant]').forEach((el) => {
        const lam = el.querySelector<SVGElement>('.kr-giant__lam');
        const s = { w: 62 };
        const apply = () => {
          el.style.fontStretch = `${s.w}%`;
          if (lam) lam.style.width = `${advance(s.w)}em`;
        };
        apply();
        gsap.to(s, {
          w: 125,
          duration: 0.9,
          ease: 'draft',
          onUpdate: apply,
          scrollTrigger: { trigger: el, start: 'top 92%', once: true },
        });
      });
      // izlazak iz desktop upita: vrati statično (CSS) stanje
      return () =>
        document.querySelectorAll<HTMLElement>('[data-giant]').forEach((el) => {
          el.style.fontStretch = '';
          el.querySelector<SVGElement>('.kr-giant__lam')?.style.removeProperty('width');
        });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGiant, { once: true });
  } else {
    initGiant();
  }
</script>

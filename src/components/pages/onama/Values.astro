---
/**
 * /o-nama · tri pravila (papir): Preciznost / Urednost / Jamstvo.
 * Svaka ćelija: ikona, riječ, kratak opis. Specifikacija (debljina lima, jamstvo…) je u
 * "sastavnici" odmah ispod (Warranty), pa se ovdje ne ponavlja.
 *  class?  pozadina i razmaci sekcije (default "bg-papir py-24 sm:py-28 lg:py-32")
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';

interface Props {
  class?: string;
}
const { class: sectionClass = 'bg-papir py-24 sm:py-28 lg:py-32' } = Astro.props;

const values: { word: string; icon: IconName; text: string }[] = [
  {
    word: 'Preciznost',
    icon: 'ruler',
    text: 'Mjera se uzima na krovu, ne s plana. Kutovi na geru, preklopi u smjeru vode i linije koje se vide s ulice.',
  },
  {
    word: 'Urednost',
    icon: 'check',
    text: 'Gradilište čistimo svaki dan. Kad odemo, ostaju ravne linije na krovu, a ne otpaci lima u dvorištu.',
  },
  {
    word: 'Jamstvo',
    icon: 'shield',
    text: 'Na izvedbu dajemo pisano jamstvo, a na materijal vrijedi jamstvo proizvođača. Sve piše u ponudi i na računu.',
  },
];
---

<section id="vrijednosti" class:list={['text-tinta', sectionClass]}>
  <div class="wrap">
    <SectionHead
      tone="light"
      eyebrow="Načela"
      title="Tri pravila bez iznimke."
      lead="Isto pravilo vrijedi za opšav dimnjaka i za krov zgrade."
    />

    <ul class="vl-grid mt-14 lg:mt-20" data-reveal-group>
      {
        values.map((v) => (
          <li class="vl-cell" data-reveal>
            <span class="vl-ico" aria-hidden="true">
              <Icon name={v.icon} size={22} />
            </span>
            <h3 class="vl-word type-display">{v.word}</h3>
            <p class="mt-4 max-w-[26rem] leading-relaxed text-pretty text-tinta/75">{v.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .vl-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid rgb(21 24 27 / 0.16);
  }
  @media (width >= 64rem) {
    .vl-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .vl-cell {
    padding: 2rem 0 2.25rem;
    border-bottom: 1px solid rgb(21 24 27 / 0.1);
  }
  @media (width >= 64rem) {
    .vl-cell {
      padding: 2.5rem 2.5rem 0.5rem;
      border-bottom: 0;
    }
    .vl-cell:first-child {
      padding-left: 0;
    }
    .vl-cell + .vl-cell {
      border-left: 1px solid rgb(21 24 27 / 0.1);
    }
  }
  .vl-ico {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(21 24 27 / 0.2);
    color: var(--color-tinta);
  }
  .vl-word {
    margin-top: 1.5rem;
    font-size: 2.125rem;
  }
  @media (width >= 40rem) {
    .vl-word {
      font-size: 2.5rem;
    }
  }
  @media (width >= 64rem) {
    .vl-word {
      font-size: clamp(1.875rem, 2.6vw, 2.5rem);
    }
  }
</style>

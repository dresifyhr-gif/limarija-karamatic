---
/**
 * /o-nama · priča (bijela) + stvarna fotografija s krova.
 * Vidljivi tekst je namjerno općenit (bez godina, imena i brojki) dok klijent ne da priču radionice.
 *  class?  pozadina i razmaci sekcije (default "bg-white py-24 sm:py-28 lg:py-32")
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import Photo from '@/components/ui/Photo.astro';
import crewImg from '@/assets/projects/krov-crijep-lim-spoj-radnik.jpg';

interface Props {
  class?: string;
}
const { class: sectionClass = 'bg-white py-24 sm:py-28 lg:py-32' } = Astro.props;
---

<section id="prica" class:list={['text-tinta', sectionClass]}>
  <!--
    TODO (klijent): prava priča radionice — kako je počelo, od kada, tko je vlasnik,
    koliko ljudi radi u ekipi, vlastita radionica / abkant, vrsta posla.
    Fotografija ekipe (vlasnik i ekipa uz kombi, docs/creative-direction.md §7) može zamijeniti fotografiju s krova.
  -->
  <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-8">
    <div class="lg:col-span-6">
      <SectionHead tone="light" eyebrow="Tko smo" title="Krov se ne radi napamet." />

      <div class="mt-10 max-w-[36rem] space-y-5 text-[1.0625rem] leading-[1.7] text-pretty text-tinta/80 sm:text-lg" data-reveal-group>
        <p data-reveal>
          Limarija Karamatić je zanat, ne posredništvo. Svaku mjeru uzimamo na licu mjesta, svaki opšav krojimo za
          taj krov, a kutove savijamo i spajamo ondje gdje će stajati.
        </p>
        <p data-reveal>
          Radimo kao što bismo radili na vlastitoj kući. Uredno, bez žurbe na krivim mjestima, i s gradilištem koje
          za sobom čistimo svaki dan.
        </p>
        <p data-reveal>
          Ponuda stavku po stavku kaže što ugrađujemo, u kojoj debljini i boji. Za izvedbu dajemo pisano jamstvo, a
          na krov se vraćamo ako bilo što nije kako treba.
        </p>
      </div>

      <figure class="mt-12 max-w-[36rem] border-l-2 border-tinta pl-6" data-reveal>
        <blockquote class="type-display text-[1.75rem] leading-[1.02] text-tinta sm:text-[2.25rem]">
          Sedam puta mjerimo. Jednom savijemo.
        </blockquote>
        <figcaption class="mt-4 text-[0.9375rem] text-tinta/70">Pravilo radionice</figcaption>
      </figure>
    </div>

    <figure class="lg:col-span-5 lg:col-start-8 lg:pt-3">
      <div class="relative aspect-[4/5] overflow-hidden bg-antracit" data-scan>
        <Photo
          src={crewImg}
          alt="Limar na krovu spaja dvije plohe crijep-lima, RAL 7016"
          sizes="(min-width: 64rem) 36vw, 100vw"
          widths={[400, 640, 900, 1200]}
          imgClass="h-full w-full object-cover"
        />
      </div>
    </figure>
  </div>
</section>

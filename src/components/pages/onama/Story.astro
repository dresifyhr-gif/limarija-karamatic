---
/**
 * /o-nama · priča (papir) + fotografija.
 * Prototip (PROTOTYPE): označeni okvir za fotografiju ekipe; inače stvarna fotografija s krova.
 * Vidljivi tekst je namjerno općenit (bez godina, imena i brojki) dok klijent ne potvrdi priču.
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import Icon from '@/components/ui/Icon.astro';
import Photo from '@/components/ui/Photo.astro';
import ExampleTag from '@/components/ui/ExampleTag.astro';
import { PROTOTYPE } from '@/data/site';
import crewImg from '@/assets/projects/krov-crijep-lim-spoj-radnik.jpg';

interface Props {
  index?: string;
  /** broj slike u nizu stranice ("Sl. 02") — hero je Sl. 01 */
  figure?: number;
}
const { index = '01', figure = 2 } = Astro.props;
const fig = String(figure).padStart(2, '0');
---

<section id="prica" class="bg-papir py-20 text-tinta sm:py-28 lg:py-32">
  <!--
    TODO (klijent): prava priča radionice — kako je počelo, od kada, tko je vlasnik,
    koliko ljudi radi u ekipi, vlastita radionica / abkant, područje i vrsta posla.
    Sve brojke i godine potvrditi prije objave. Do tada ostaje ovaj općeniti tekst.
  -->
  <div class="wrap grid gap-y-14 lg:grid-cols-12 lg:gap-x-8">
    <div class="lg:col-span-6 xl:col-span-6">
      <SectionHead tone="light" index={index} eyebrow="Tko smo" title="Krov se ne radi napamet." />

      <div class="st-body mt-10 max-w-[36rem] space-y-5 text-[1.0625rem] leading-[1.7] text-pretty text-tinta/80 sm:text-lg" data-reveal-group>
        <p data-reveal>
          Limarija Karamatić je zanat, ne posredništvo. Svaku mjeru uzimamo na licu mjesta, svaki opšav krojimo za
          taj krov, a kutove savijamo i spajamo ondje gdje će stajati.
        </p>
        <p data-reveal>
          Radimo kao što bismo radili na vlastitoj kući. Uredno, bez žurbe na krivim mjestima, i s gradilištem koje
          za sobom čistimo svaki dan.
        </p>
        <p data-reveal>
          Ponuda stavku po stavku kaže što ugrađujemo, u kojoj debljini i boji. Za izvedbu dajemo pisano jamstvo, a
          na krov se vraćamo ako bilo što nije kako treba.
        </p>
      </div>

      <figure class="mt-12 max-w-[36rem] border-l-2 border-tinta pl-6" data-reveal>
        <blockquote class="type-display text-[1.75rem] leading-[1.02] text-tinta sm:text-[2.25rem]">
          Sedam puta mjerimo. Jednom savijemo.
        </blockquote>
        <figcaption class="mt-4 font-mono text-[0.6875rem] tracking-[0.12em] text-tinta/70 uppercase">
          Pravilo radionice
        </figcaption>
      </figure>
    </div>

    <!-- prototip: okvir za fotografiju ekipe (vlasnik i ekipa uz kombi, vidi docs/creative-direction.md §7); inače stvarna fotografija -->
    {
      PROTOTYPE ? (
        <figure class="lg:col-span-5 lg:col-start-8 lg:pt-3" data-reveal>
          <div class="st-crew relative aspect-[4/5]">
            <span class="st-crop st-crop--tl" aria-hidden="true" />
            <span class="st-crop st-crop--tr" aria-hidden="true" />
            <span class="st-crop st-crop--bl" aria-hidden="true" />
            <span class="st-crop st-crop--br" aria-hidden="true" />
            <div class="st-hatch absolute inset-0 grid place-items-center border border-tinta/25">
              <div class="st-label flex flex-col items-center gap-4 px-6 py-5 text-center">
                <span class="grid size-12 place-items-center border border-tinta/30 text-tinta/70" aria-hidden="true">
                  <Icon name="camera" size={24} />
                </span>
                <p class="font-mono text-[0.75rem] font-medium tracking-[0.16em] text-tinta uppercase sm:text-[0.8125rem]">
                  Fotografija ekipe
                </p>
                <ExampleTag text="mjesto za fotografiju" />
              </div>
            </div>
            <span class="st-dim st-dim--w" aria-hidden="true"><span>Format 4 : 5</span></span>
          </div>
          <figcaption class="st-cap">
            <span class="st-cap-n">Sl. {fig}</span>
            <span>Vlasnik i ekipa uz kombi, u radnoj odjeći.</span>
          </figcaption>
        </figure>
      ) : (
        <figure class="lg:col-span-5 lg:col-start-8 lg:pt-3">
          <div class="relative aspect-[4/5] overflow-hidden bg-antracit" data-scan>
            <Photo
              src={crewImg}
              alt="Limar na krovu spaja dvije plohe crijep-lima, RAL 7016"
              sizes="(min-width: 64rem) 36vw, 100vw"
              widths={[400, 640, 900, 1200]}
              imgClass="h-full w-full object-cover"
            />
          </div>
          <figcaption class="st-cap">
            <span class="st-cap-n">Sl. {fig}</span>
            <span>Na krovu: spoj dvije plohe crijep-lima, RAL 7016.</span>
          </figcaption>
        </figure>
      )
    }
  </div>
</section>

<style>
  .st-cap {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: rgb(21 24 27 / 0.7);
  }
  .st-cap-n {
    flex: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-redline-dark);
  }
  /* šrafura presjeka — kao materijal na tehničkom crtežu */
  .st-hatch {
    background-color: var(--color-papir-2);
    background-image: repeating-linear-gradient(
      -45deg,
      rgb(21 24 27 / 0.13) 0 1px,
      transparent 1px 11px
    );
  }
  .st-label {
    background: var(--color-papir);
    outline: 1px solid rgb(21 24 27 / 0.18);
  }
  .st-crop {
    position: absolute;
    width: 0.875rem;
    height: 0.875rem;
    border-color: rgb(21 24 27 / 0.4);
    pointer-events: none;
  }
  .st-crop--tl {
    top: -0.5rem;
    left: -0.5rem;
    border-top: 1px solid;
    border-left: 1px solid;
  }
  .st-crop--tr {
    top: -0.5rem;
    right: -0.5rem;
    border-top: 1px solid;
    border-right: 1px solid;
  }
  .st-crop--bl {
    bottom: -0.5rem;
    left: -0.5rem;
    border-bottom: 1px solid;
    border-left: 1px solid;
  }
  .st-crop--br {
    bottom: -0.5rem;
    right: -0.5rem;
    border-bottom: 1px solid;
    border-right: 1px solid;
  }
  /* kote formata 4 : 5 uz okvir */
  .st-dim {
    position: absolute;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(21 24 27 / 0.7);
    pointer-events: none;
  }
  .st-dim::before {
    content: '';
    position: absolute;
    background: rgb(21 24 27 / 0.3);
  }
  .st-dim > span {
    position: relative;
    padding: 0 0.375rem;
    background: var(--color-papir);
  }
  .st-dim--w {
    left: 0;
    right: 0;
    top: -1.75rem;
    height: 1rem;
  }
  .st-dim--w::before {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }
  .st-dim--h {
    top: 0;
    bottom: 0;
    right: -1.75rem;
    width: 1rem;
  }
  .st-dim--h::before {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
  }
  .st-dim--h > span {
    padding: 0.375rem 0;
  }
  @media (width < 40rem) {
    .st-dim--h {
      display: none;
    }
    .st-crop {
      display: none;
    }
  }
</style>

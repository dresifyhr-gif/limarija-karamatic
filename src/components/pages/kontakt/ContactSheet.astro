---
/**
 * /kontakt · "list za kontakt" u desnom stupcu PageHera (slot "aside"). Bijeli list na papiru.
 * Prvi ekran ima sve radnje na dodir: WhatsApp (slike krova), telefon (veliki mono broj), e-pošta.
 * Poruke idu samo na WhatsApp. Ispod: radno vrijeme i vrijeme odgovora.
 */
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import { getContent } from '@/lib/content';

const { contact: site, telHref, waHref } = await getContent();
---

<div class="cs relative w-full lg:ml-auto lg:max-w-[30rem]">
  <div class="cs-msg">
    <Button href={waHref('Pozdrav, šaljem slike krova. Lokacija: ')} variant="whatsapp" icon="whatsapp" class="w-full">
      Pošaljite slike
    </Button>
    <p class="cs-hint">Tri slike krova i mjesto. Javimo vam što vidimo.</p>
  </div>

  <a href={telHref} class="cs-tel group" aria-label={`Nazovite ${site.phoneDisplay}`}>
    <span class="cs-k">Nazovite</span>
    <span class="cs-num">{site.phoneDisplay}</span>
    <span class="cs-call" aria-hidden="true"><Icon name="phone" size={22} /></span>
  </a>

  <a href={`mailto:${site.email}`} class="cs-mail group">
    <Icon name="mail" size={18} class="flex-none text-tinta/60" />
    <span class="min-w-0 break-all">{site.email}</span>
    <Icon name="arrow-up-right" size={18} class="cs-mail-arrow ml-auto flex-none" />
  </a>

  <dl class="cs-meta">
    <div>
      <dt>Radno vrijeme</dt>
      <dd>
        {site.hours.split(' · ').map((h, i, a) => (
          <>
            <span class="whitespace-nowrap">{h}{i < a.length - 1 && ' ·'}</span>{i < a.length - 1 && ' '}
          </>
        ))}
      </dd>
    </div>
    <div>
      <dt>Odgovor</dt>
      <dd>{site.responseTime}</dd>
    </div>
  </dl>
</div>

<style>
  .cs {
    container-type: inline-size;
    background: #fff;
    border: 1px solid rgb(21 24 27 / 0.12);
    color: var(--color-tinta);
  }
  /* ── telefon: cijeli red je jedan cilj dodira ── */
  .cs-tel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'k call'
      'num call';
    align-items: end;
    column-gap: 1rem;
    row-gap: 0.5rem;
    padding: 1.125rem 1.25rem 1.25rem;
    border-bottom: 1px solid rgb(21 24 27 / 0.1);
    color: var(--color-tinta);
    -webkit-tap-highlight-color: transparent;
  }
  .cs-k {
    grid-area: k;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(21 24 27 / 0.7);
  }
  .cs-num {
    grid-area: num;
    justify-self: start;
    font-family: var(--font-mono);
    font-weight: 500;
    /* broj + kvadrat za poziv uvijek stanu u list (≈ 6,7 em širine) */
    font-size: clamp(1.75rem, 10cqi, 2.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    word-spacing: -0.25em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    padding-bottom: 0.18em;
    background: linear-gradient(var(--color-crvena), var(--color-crvena)) left bottom / 0% 2px no-repeat;
    transition: background-size 200ms var(--ease-press);
  }
  .cs-call {
    grid-area: call;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid rgb(21 24 27 / 0.25);
    color: var(--color-tinta);
    transition:
      background-color 180ms var(--ease-press),
      border-color 180ms var(--ease-press),
      color 180ms var(--ease-press);
  }
  .cs-tel:hover .cs-num,
  .cs-tel:focus-visible .cs-num {
    background-size: 100% 2px;
  }
  .cs-tel:hover .cs-call,
  .cs-tel:focus-visible .cs-call {
    background: var(--color-crvena);
    border-color: var(--color-crvena);
    color: #fff;
  }

  /* ── poruke: samo WhatsApp ── */
  .cs-msg {
    padding: 1.25rem;
    border-bottom: 1px solid rgb(21 24 27 / 0.1);
  }
  .cs-hint {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: rgb(21 24 27 / 0.7);
  }

  /* ── e-pošta ── */
  .cs-mail {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding: 0.5rem 1.25rem;
    border-bottom: 1px solid rgb(21 24 27 / 0.1);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-tinta);
  }
  .cs-mail :global(.cs-mail-arrow) {
    color: rgb(21 24 27 / 0.5);
    transition:
      transform 150ms var(--ease-press),
      color 150ms var(--ease-press);
  }
  .cs-mail:hover :global(.cs-mail-arrow) {
    color: var(--color-tinta);
    transform: translate(2px, -2px);
  }

  /* ── radno vrijeme ── */
  .cs-meta > div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .cs-meta > div + div {
    border-top: 1px solid rgb(21 24 27 / 0.08);
  }
  .cs-meta dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.25rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(21 24 27 / 0.7);
  }
  .cs-meta dd {
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--color-tinta);
  }

  @media (width >= 40rem) {
    .cs-tel,
    .cs-msg,
    .cs-mail,
    .cs-meta > div {
      padding-inline: 1.5rem;
    }
    .cs-tel {
      padding-block: 1.375rem 1.5rem;
    }
  }
</style>

---
/**
 * /upravitelji-zgrada · "Što dobivate" (bijela).
 * Mreža 3 × 2 s tankim linijama: pet priloga (ikona, naslov, kratak opis) + šesta ćelija je poziv na upit.
 *  class?  pozadina i razmaci sekcije (default "bg-white py-24 sm:py-28 lg:py-32")
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import { getContent } from '@/lib/content';

const { contact: site, telHref } = await getContent();

interface Props {
  class?: string;
}
const { class: sectionClass = 'bg-white py-24 sm:py-28 lg:py-32' } = Astro.props;

const items: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'ruler',
    title: 'Ponuda za suvlasnike',
    text: 'Nakon mjerenja dobivate pisanu ponudu stavku po stavku: materijal, debljina lima, boja i rok. Složenu tako da ide ravno na odluku suvlasnika.',
  },
  {
    icon: 'file',
    title: 'Račun na zgradu',
    text: 'Račun glasi na zgradu, s OIB-om zgrade i istim stavkama kao u ponudi. Izvođačima i tvrtkama izdajemo R1 račun.',
  },
  {
    icon: 'building',
    title: 'Plaćanje iz pričuve',
    text: 'Dokumentaciju slažemo tako da se radovi mogu platiti iz zajedničke pričuve, uz odluku suvlasnika.',
  },
  {
    icon: 'camera',
    title: 'Fotodokumentacija',
    text: 'Krov snimamo prije, tijekom i nakon radova. Suvlasnici vide za što je otišao novac, i ono što se s ulice ne vidi.',
  },
  {
    icon: 'shield',
    title: 'Siguran rad na visini',
    text: 'Zaštitna oprema i osiguranje na rubu krova. Prolaz ispod mjesta rada ogradimo dok traje posao.',
  },
];
---

<section id="sto-dobivate" class:list={['text-tinta', sectionClass]}>
  <div class="wrap">
    <SectionHead
      tone="light"
      eyebrow="Što dobivate"
      title="Papiri složeni. Krov zatvoren."
      lead="Ponuda, račun i fotografije stižu složeni i spremni za suvlasnike."
    />

    <ul class="bn-grid mt-14 lg:mt-20" data-reveal-group>
      {
        items.map((it) => (
          <li class="bn-cell" data-reveal>
            <span class="bn-ico" aria-hidden="true">
              <Icon name={it.icon} size={22} />
            </span>
            <h3 class="mt-6 text-[1.3125rem] leading-tight font-bold text-tinta [font-stretch:112%] sm:text-[1.375rem]">
              {it.title}
            </h3>
            <p class="mt-3 leading-relaxed text-pretty text-tinta/75">{it.text}</p>
          </li>
        ))
      }

      <li class="bn-cell bn-cell--cta" data-reveal data-hide-mobile-cta>
        <p class="eyebrow text-tinta/70">Upit za zgradu</p>
        <p class="mt-4 text-[1.5rem] leading-[1.15] font-bold text-balance text-tinta [font-stretch:115%] sm:text-[1.625rem]">
          Adresa zgrade je dovoljna. Ostalo pitamo mi.
        </p>
        <div class="mt-auto flex flex-col items-start gap-3 pt-8">
          <Button href="/procjena" iconRight="arrow-right" data-quote-link>Besplatna procjena</Button>
          <a
            href={telHref}
            class="inline-flex min-h-11 items-center gap-2.5 font-mono text-[1rem] tracking-[0.02em] text-tinta underline decoration-transparent underline-offset-[6px] transition-colors duration-150 hover:decoration-current"
            aria-label={`Nazovite ${site.phoneDisplay}`}
          >
            <Icon name="phone" size={18} class="text-tinta/60" />
            {site.phoneDisplay}
          </a>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .bn-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: rgb(21 24 27 / 0.1);
    border-block: 1px solid rgb(21 24 27 / 0.1);
  }
  @media (width >= 40rem) {
    .bn-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (width >= 64rem) {
    .bn-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .bn-cell {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 0 2rem;
    background: #fff;
  }
  @media (width >= 40rem) {
    .bn-cell {
      min-height: 18rem;
      padding: 2rem 2rem 2.25rem;
    }
  }
  @media (width >= 80rem) {
    .bn-cell {
      padding: 2.25rem 2.5rem 2.5rem;
    }
  }
  .bn-ico {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(21 24 27 / 0.2);
    color: var(--color-tinta);
  }
  .bn-cell--cta {
    background: var(--color-papir);
  }
  @media (width < 40rem) {
    .bn-cell--cta {
      padding-inline: 1.25rem;
    }
  }
</style>

---
/**
 * /upravitelji-zgrada · "Tipični radovi na zgradama" (bijela).
 * Gore: popis vrsta posla (presjek lima se savije kad uđe u ekran / na hover).
 * Dolje: četiri stvarna rada sa zgrada (fotografije 4, 2, 10, 7) — ProjectCard;
 * na mobitelu native scroll-snap traka.
 *  class?  pozadina i razmaci sekcije (default "bg-white py-24 sm:py-28 lg:py-32")
 */
import SectionHead from '@/components/ui/SectionHead.astro';
import ProfileIcon from '@/components/ui/ProfileIcon.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import Icon from '@/components/ui/Icon.astro';
import { projects, type Profile, type Project } from '@/data/site';

interface Props {
  class?: string;
}
const { class: sectionClass = 'bg-white py-24 sm:py-28 lg:py-32' } = Astro.props;

const types: { profile: Profile; title: string; text: string }[] = [
  {
    profile: 'atika',
    title: 'Opšav atike',
    text: 'Kape krojene po mjeri, s okapnicom. Kutovi na geru i preklopi okrenuti tako da voda nema kamo ući.',
  },
  {
    profile: 'trapez',
    title: 'Ravni krovovi i trapez',
    text: 'Trapezni lim za ravne krovove i nadogradnje, s gromobranskom instalacijom vođenom po opšavu.',
  },
  {
    profile: 'oluk',
    title: 'Oluci i vertikale',
    text: 'Polukružni i četvrtasti oluci, kotlići i vertikale do spoja na odvodnju. Bez prelijevanja po fasadi.',
  },
  {
    profile: 'dimnjak',
    title: 'Dimnjaci i prodori',
    text: 'Opšav uz krov, oblaganje limom i kape za dimnjake, ventilacije i izlaze na krov.',
  },
  {
    profile: 'uvala',
    title: 'Sanacija nakon nevremena',
    text: 'Kad vjetar podigne lim ili opšav, prvo osiguramo krov, a zatim ga popravimo i fotografiramo za upravitelja.',
  },
];

// fotografije 4, 2, 10, 7 (vidi docs/creative-direction.md)
const picks = ['ravni-krov-gromobran', 'atika-sljunak', 'ravni-krov-trapez-medvednica', 'atika-kut-na-geru']
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p): p is Project => !!p);
---

<section id="radovi-zgrade" class:list={['text-tinta', sectionClass]}>
  <div class="wrap">
    <SectionHead
      tone="light"
      eyebrow="Tipični radovi na zgradama"
      title="Atike, ravni krovovi, oluci i dimnjaci."
      lead="Zgrada trpi više od kuće: veći krov, više spojeva, više vjetra."
    />

    <ul class="wk-list mt-14 border-t border-tinta/14 lg:mt-20" data-reveal-group>
      {
        types.map((t) => (
          <li class="wk-row" data-reveal data-profile-host>
            <span class="wk-ico">
              <ProfileIcon profile={t.profile} size={64} animate class="h-auto w-full" />
            </span>
            <h3 class="wk-t text-[1.25rem] leading-tight font-bold [font-stretch:112%] sm:text-[1.375rem]">{t.title}</h3>
            <p class="wk-d leading-relaxed text-pretty text-tinta/75">{t.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-20 flex items-center justify-between gap-6 lg:mt-28">
      <p class="eyebrow text-tinta/70">Sa zgrada</p>
      <a href="/radovi" class="wk-all group">
        Svi radovi
        <Icon name="arrow-right" size={16} class="transition-transform duration-150 group-hover:translate-x-0.5" />
      </a>
    </div>

    <ul class="wk-rail mt-6" aria-label="Radovi na zgradama">
      {
        picks.map((p) => (
          <li class="wk-card">
            <ProjectCard project={p} sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 44vw, 78vw" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ── popis vrsta posla ── */
  .wk-row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    grid-template-areas:
      'ico t'
      'ico d';
    column-gap: 1.25rem;
    row-gap: 0.375rem;
    align-items: start;
    padding-block: 1.5rem;
    border-bottom: 1px solid rgb(21 24 27 / 0.1);
  }
  .wk-ico {
    grid-area: ico;
    display: block;
    width: 3.5rem;
    color: var(--color-tinta);
  }
  .wk-t {
    grid-area: t;
    padding-top: 0.125rem;
  }
  .wk-d {
    grid-area: d;
  }
  @media (width >= 40rem) {
    .wk-row {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      column-gap: 1.75rem;
      padding-block: 1.75rem;
    }
    .wk-ico {
      width: 4.5rem;
    }
  }
  @media (width >= 64rem) {
    .wk-row {
      grid-template-columns: 5rem minmax(0, 18rem) minmax(0, 1fr);
      grid-template-areas: 'ico t d';
      column-gap: 2.5rem;
      align-items: center;
      padding-block: 1.25rem;
    }
    .wk-t {
      padding-top: 0;
    }
    .wk-d {
      max-width: 36rem;
    }
  }
  .wk-all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-tinta);
    text-underline-offset: 4px;
    white-space: nowrap;
  }
  .wk-all:hover {
    text-decoration: underline;
  }

  /* ── radovi: rail na mobitelu, mreža na desktopu ── */
  .wk-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 78%;
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1.25rem;
    margin-inline: -1.25rem;
    padding-inline: 1.25rem;
    padding-bottom: 0.5rem;
    scrollbar-width: none;
  }
  .wk-rail::-webkit-scrollbar {
    display: none;
  }
  .wk-card {
    scroll-snap-align: start;
    min-width: 0;
  }
  @media (width >= 40rem) {
    .wk-rail {
      grid-auto-columns: 44%;
      gap: 1.5rem;
      margin-inline: -2rem;
      padding-inline: 2rem;
      scroll-padding-inline: 2rem;
    }
  }
  @media (width >= 64rem) {
    .wk-rail {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
  }
</style>
